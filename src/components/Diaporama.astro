---
// Lecteur d'un diaporama narré de la section « Le siècle en images » (spec 12).
//
// Usage : <Diaporama diaporama={d} />, où `d` est le contenu d'un fichier
// src/data/diaporamas/NN-<slug>.json (voir src/utils/diaporamas.ts pour le format).
// Images et voix sont servies depuis public/diaporamas/<slug>/ (préparées par
// scripts/diaporamas/).
//
// - Image en couleur (exception de la spec 11 : c'est une visionneuse), fondu enchaîné ;
//   tout le reste est monochrome. Caméra calée sur la narration (spec 12, révision du
//   2026-10-07) : chaque diapositive porte 1 à 3 cadres ; la caméra rejoint chacun à l'instant
//   où la voix en parle. L'horloge est `audio.currentTime` (aucune minuterie propre) : pause,
//   saut, redimensionnement et plein écran restent justes.
// - Cartouche (titre, auteur, date) en haut à gauche de l'image, sous-titres (activables, choix mémorisé), barre de progression
//   découpée en actes, clavier (espace, ← →, F, S), plein écran, balayage sur téléphone,
//   reprise mémorisée (localStorage, toujours dans un try/catch).
// - Animations d'entrée (spec 12, révision du 2026-10-07) : fondu enchaîné avec révélation
//   gris → couleur, léger recul (composé avec la caméra, sans la décaler), cartouche décalé,
//   sous-titre en fondu croisé, carton de changement d'acte (12 s, musique au premier plan, compté dans la durée totale,
//   passable d'un clic, de Entrée ou de →). Ses 3,5 dernières secondes sont l'ouverture en deux
//   volets, sur un détail zoomé de l'image (`image.ouverture`) puis un recul de 5 s avec la voix ;
//   passé, le carton joue aussitôt son ouverture. Le carton se fige avec la pause ; l'entrée
//   d'une image (1,8 s au plus) va toujours à son terme.
// - Frise du temps (spec 12, révision du 2026-10-07) : la période graduée par année, les actes
//   en segments, un curseur daté. Dans chaque carton d'acte, le curseur glisse de la date
//   précédente au début du nouvel acte ; entre deux cartons, la frise passe 3,6 s en
//   surimpression au bas de l'image quand la date saute de plus de 3 mois en avant ou revient
//   en arrière. « Date précédente » : celle de la dernière diapositive affichée, si bien que
//   les sauts manuels restent justes ; positions en %, donc indifférentes à la taille.
// - Rien ne joue sans clic. Sans JavaScript, la page est un livre d'images : la liste des
//   diapositives avec image, légende et narration.
import { typographie } from '../utils/typographie.mjs';
import CarteCitation from './CarteCitation.astro';
import EpisodeVisuels from './EpisodeVisuels.astro';
import Surimpressions from './Surimpressions.astro';
import { CARTON, PAUSE, SAUT_JOURS, etapesCamera, versUtile, zoneUtile, pauseApres, friseDe, minutageLecture, motsLus, phrasesDe, planParis, surimpressionsDe, urlCommons, urlMedia, type Diaporama, type Episode, type FondCarte, type Intermede, type Lecture, type PisteFond } from '../utils/diaporamas';

interface Props { diaporama: Diaporama }
const { diaporama: d } = Astro.props;

const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
const t = (s?: string) => (s ? typographie(s.trim()) : '');

/** Légende de notice : auteur, *titre*, date, technique. Conservation. (HTML échappé) */
function legende(x: Diaporama['diapositives'][number]) {
  const i = x.image;
  const tete = [i.auteur && esc(t(i.auteur)), `<cite>${esc(t(i.titre))}</cite>`, i.date && esc(t(i.date)), i.technique && esc(t(i.technique))]
    .filter(Boolean).join(', ');
  const lieu = i.conservation ? ` ${esc(t(i.conservation))}.` : '';
  return `<span class="notice">${tete}.${lieu}</span> <a class="notice__commons" href="${esc(urlCommons(i.commons))}" rel="noopener" target="_blank">Commons</a>`;
}

/** Cartouche du lecteur (spec 12, « Cartouches lisibles ») : trois lignes, *titre court*,
 *  auteur, « date · technique » (HTML échappé). Le titre officiel reste dans le livre et l'`alt`. */
function cartouche(x: Diaporama['diapositives'][number]) {
  const i = x.image;
  const quand = [i.date && esc(t(i.date)), i.technique && esc(t(i.technique))].filter(Boolean).join(' · ');
  return `<cite>${esc(t(i.titre_court || i.titre))}</cite>${i.auteur ? `<span>${esc(t(i.auteur))}</span>` : ''}${quand ? `<span>${quand}</span>` : ''}`;
}

/** Cartouche d'un intermède dans le lecteur : *œuvre* et compositeur rédigés à la main
 *  (`cartouche`), sans troncature ; l'interprète au survol seulement. */
function cartoucheIntermede(c: Intermede) {
  if (!c.cartouche) return cartoucheChant(c);
  const voix = [c.interprete && esc(t(c.interprete)), c.enregistrement && esc(t(c.enregistrement))].filter(Boolean).join(', ');
  return `<cite>${esc(t(c.cartouche.oeuvre))}</cite><span>${esc(t(c.cartouche.compositeur))}</span>${voix ? `<span class="lecteur__legende-voix">${voix}</span>` : ''}`;
}
/** Cartouche d'un intermède chanté : *titre*, auteur et date, interprète et enregistrement. */
function cartoucheChant(c: Intermede) {
  const sous = [c.auteur && esc(t(c.auteur)), c.date && esc(t(c.date))].filter(Boolean).join(', ');
  const voix = [c.interprete && esc(t(c.interprete)), c.enregistrement && esc(t(c.enregistrement))].filter(Boolean).join(', ');
  return `<cite>${esc(t(c.titre))}</cite>${sous ? `<span>${sous}</span>` : ''}${voix ? `<span class="lecteur__legende-voix">${voix}</span>` : ''}`;
}
/** Cartouche de la musique de fond, sur deux lignes rédigées à la main (`cartouche`) :
 *  « Symphonie nº 87, menuet » / « Joseph Haydn, 1785 », sans troncature. À défaut, le titre et
 *  le compositeur tels quels. L'interprète n'apparaît qu'au survol (et dans les crédits). */
function cartoucheMusique(p: PisteFond) {
  const oeuvre = p.cartouche?.oeuvre ?? p.titre;
  const auteur = p.cartouche?.compositeur ?? [p.compositeur, p.date].filter(Boolean).join(', ');
  const voix = p.interprete ? `<span class="m-voix">${esc(t(p.interprete))}</span>` : '';
  return `<span class="m-ligne"><cite>${esc(t(oeuvre))}</cite></span><span class="m-auteur">${esc(t(auteur))}</span>${voix}`;
}
const intermedeApres = new Map((d.musique?.intermedes ?? []).filter((c) => c.duree).map((c) => [c.apres, c]));
// Lectures d'époque et épisodes (spec 12, révision du 2026-10-07) : insérés après la voix d'une
// diapositive, comme les intermèdes chantés (un seul segment après une diapositive donnée).
const lectureApres = new Map((d.lectures ?? []).filter((l) => l.audio?.duree).map((l) => [l.apres, l]));
const episodeApres = new Map((d.episodes ?? []).filter((e) => e.audio?.duree).map((e) => [e.apres, e]));
const fonds: Record<string, FondCarte> = Object.fromEntries(
  Object.values(import.meta.glob<{ default: FondCarte }>('../data/diaporamas/fonds/*.json', { eager: true })).map((m) => [m.default.nom, m.default]));

/** Portrait d'une lecture : l'image d'une diapositive (recadrée) ou son propre fichier. */
function portraitDe(l: Lecture) {
  const p = l.portrait;
  if (!p) return null;
  if (p.diapositive) {
    const x = d.diapositives.find((y) => y.n === p.diapositive);
    if (!x) return null;
    return { src: urlMedia(d.slug, x.image.fichier), largeur: x.image.largeur ?? 1000, hauteur: x.image.hauteur ?? 1300, cadre: p.cadre,
      credit: [x.image.auteur, x.image.date].filter(Boolean).join(', ') };
  }
  if (!p.fichier || !p.largeur) return null;
  return { src: urlMedia(d.slug, p.fichier), largeur: p.largeur, hauteur: p.hauteur ?? p.largeur, cadre: p.cadre,
    credit: [p.auteur, p.date].filter(Boolean).join(', ') };
}
/** Image du moment d'une lecture (fond flou de sa carte) : celle de la diapositive qu'elle suit. */
function fondDe(l: Lecture) {
  const x = d.diapositives.find((y) => y.n === l.apres);
  return x ? urlMedia(d.slug, x.image.fichier) : undefined;
}
/** Phrases horodatées d'un épisode, avec leur texte (sous-titres). */
function phrasesEpisode(e: Episode) {
  const bornes = phrasesDe(e.narration);
  const ph = e.audio?.phrases ?? [];
  if (ph.length !== bornes.length) return [[0, e.audio?.duree ?? 0, t(e.narration)]];
  return bornes.map((b, k) => [ph[k][0], ph[k][1], t(e.narration.slice(b.d, b.f))]);
}

const acteDe = (n: number) => [...d.actes].reverse().find((a) => a.debut <= n) ?? d.actes[0];
const frise = friseDe(d);

// Cartes de lieu et citations en surimpression (spec 12, 2026-10-07) : fenêtres d'affichage
// calculées au build ; la citation est découpée en mots (`.m`, rang `data-k` dans `motsLus` ; la
// ponctuation détachée suit le mot précédent).
const plan = planParis(d.slug);
function surimpressions(x: Diaporama['diapositives'][number]) {
  const s = surimpressionsDe(x, fonds, plan);
  // Portraits des personnes nommées (spec 12, 2026-10-08) : rangée en bas à gauche.
  const portraits = s.portraits ? { ...s.portraits, gens: s.portraits.gens.map((g) => ({ ...g, nom: t(g.nom) })) } : null;
  // Objet de musée et manuscrit (spec 12, « Enrichissements visuels ») : fenêtres déjà arbitrées.
  const objet = s.objet ? { ...s.objet, nom: t(s.objet.nom), legende: t(s.objet.legende) } : null;
  const manuscrit = s.manuscrit ? { ...s.manuscrit, nom: t(s.manuscrit.nom), legende: t(s.manuscrit.legende) } : null;
  // Chiffre clé et date républicaine (point 4) : fenêtres déjà arbitrées.
  const chiffre = s.chiffre ? { ...s.chiffre, prefixe: t(s.chiffre.prefixe), unite: t(s.chiffre.unite) } : null;
  const date = s.date ? { ...s.date, republicain: t(s.date.republicain), gregorien: t(s.date.gregorien) } : null;
  if (!s.citation) return { lieu: s.lieu ? { ...s.lieu, nom: t(s.lieu.nom), credit: t(s.lieu.credit) } : null, citation: null, portraits, objet, manuscrit, chiffre, date };
  let k = 0;
  // Le guillemet fermant fait corps avec le dernier mot : il paraît avec lui.
  const jetons = t(s.citation.texte).split(/( +)/);
  const dernier = jetons.findLastIndex((m) => m.trim());
  const html = jetons.map((m, j) => (/^ +$/.test(m) ? ' '
    : `<span class="m" data-k="${/[\p{L}\p{N}]/u.test(m) ? k++ : Math.max(0, k - 1)}">${esc(m)}${j === dernier ? '\u00a0»' : ''}</span>`)).join('');
  const c = s.citation;
  const mots = k === c.mots.length ? c.mots : Array(k).fill(c.mots[0]); // repli : tous ensemble
  return {
    lieu: s.lieu ? { ...s.lieu, nom: t(s.lieu.nom), credit: t(s.lieu.credit) } : null,
    citation: { a: c.a, b: c.b, fin: c.fin, mots, html, auteur: t(`— ${c.prudence ? 'attribué à ' : ''}${c.auteur}`) },
    portraits, objet, manuscrit, chiffre, date,
  };
}

// Données transmises au script (textes déjà mis en typographie française).
const donnees = {
  slug: d.slug,
  pause: PAUSE,
  carton: CARTON,
  actes: d.actes.map((a) => ({ titre: t(a.titre), dates: t(a.dates), debut: a.debut })),
  diapos: d.diapositives.map((x, k) => ({
    n: x.n,
    // Clé stable de la reprise : le fichier Commons de l'image, qui survit aux renumérotations.
    cle: x.image.commons,
    img: urlMedia(d.slug, x.image.fichier),
    // Zone utile (spec 12, « Sans bordures ») : le lecteur ne voit que cette partie de l'image ;
    // `l` × `h` en sont les dimensions (px de l'image servie) et tous les cadres (caméra,
    // ouverture, intermède) y sont exprimés, ramenés dedans.
    u: zoneUtile(x),
    l: (x.image.largeur ?? 1600) * (zoneUtile(x)[2] - zoneUtile(x)[0]),
    h: (x.image.hauteur ?? 1200) * (zoneUtile(x)[3] - zoneUtile(x)[1]),
    alt: t(x.image.titre),
    legende: cartouche(x),
    texte: t(x.narration),
    audio: x.audio ? urlMedia(d.slug, x.audio.fichier) : '',
    duree: x.audio?.duree ?? 0,
    // Pause après la voix (allongée si la narration finit par une citation en surimpression).
    pause: pauseApres(x),
    camera: etapesCamera(x).map((e) => ({ ...e, c: versUtile(e.c, zoneUtile(x)) })),
    // Détail zoomé découvert à la sortie du carton d'acte (première diapositive d'un acte).
    ouv: x.image.ouverture ? versUtile(x.image.ouverture, zoneUtile(x)) : null,
    date: frise ? { ...frise.diapos[k], libelle: t(frise.diapos[k].libelle) } : null,
    ...surimpressions(x),
    // Segment joué après la voix : intermède chanté, lecture d'époque ou épisode.
    suite: intermedeApres.has(x.n) ? (() => {
      const c = intermedeApres.get(x.n)!;
      return { type: 'chant', src: urlMedia(d.slug, c.fichier), duree: c.duree!, legende: cartoucheIntermede(c), paroles: c.paroles.map(([s, v, m]) => [s, t(v), m && motsLus(t(v)).length === m.length ? m.map(([d]) => d) : null]), instrumental: !!c.instrumental, cadre: c.cadre ? versUtile(c.cadre, zoneUtile(x)) : null };
    })() : lectureApres.has(x.n) ? (() => {
      const l = lectureApres.get(x.n)!;
      const m = minutageLecture(l);
      return { type: 'lecture', id: l.id, src: urlMedia(d.slug, l.audio!.fichier), duree: l.audio!.duree, mots: m.mots, phrases: m.phrases,
        date: frise && l.date ? { ...frise.dater(l.date), libelle: t(frise.dater(l.date).libelle) } : null };
    })() : episodeApres.has(x.n) ? (() => {
      const e = episodeApres.get(x.n)!;
      return { type: 'episode', id: e.id, src: urlMedia(d.slug, e.audio!.fichier), duree: e.audio!.duree, phrases: phrasesEpisode(e),
        date: frise && e.date ? { ...frise.dater(e.date), libelle: t(frise.dater(e.date).libelle) } : null };
    })() : null,
  })),
  saut: SAUT_JOURS,
  // Musique de fond : les pistes de chaque acte (dans l'ordre des actes), enchaînées en fondu.
  fond: d.actes.map((a) => (d.musique?.fond ?? []).filter((p) => p.acte === a.id && p.duree)
    .map((p) => ({ src: urlMedia(d.slug, p.fichier), duree: p.duree!, volume: p.volume ?? 1, info: cartoucheMusique(p) }))),
};
const premiere = d.diapositives[0];

/** Frise du temps (deux exemplaires : dans le carton d'acte, en surimpression). Monochrome :
 *  actes en filets alternés, crans des années, curseur (trait ou court segment) et sa date. */
function friseHtml(classe: string) {
  if (!frise) return '';
  const pc = (v: number) => `${v}%`;
  const actes = frise.actes.map((a, k) => `<span class="frise-t__acte${k % 2 ? ' frise-t__acte--pair' : ''}" data-k="${k}" style="left:${pc(a.x0)};width:${pc(Math.max(0, a.x1 - a.x0))}"></span>`).join('');
  const crans = [...frise.annees.map((a) => a.x0), 100].map((x) => `<span class="frise-t__cran" style="left:${pc(x)}"></span>`).join('');
  const annees = frise.annees.map((a) => `<span class="frise-t__annee" data-a="${a.a}" style="left:${pc((a.x0 + a.x1) / 2)}">${a.a}</span>`).join('');
  return `<div class="frise-t ${classe}" aria-hidden="true"><div class="frise-t__piste"><span class="frise-t__date"></span>${actes}${crans}<span class="frise-t__curseur"></span></div><div class="frise-t__annees">${annees}</div></div>`;
}
const sectionsLivre = d.actes.map((a, i) => ({
  ...a,
  diapos: d.diapositives.filter((x) => x.n >= a.debut && (i === d.actes.length - 1 || x.n < d.actes[i + 1].debut)),
}));
---

<div class="diaporama" data-slug={d.slug}>
  <script is:inline>document.currentScript.parentElement.classList.add('avec-js');</script>
  <script type="application/json" class="diaporama__donnees" set:html={JSON.stringify(donnees).replace(/</g, '\\u003c')} />

  <div class="lecteur" role="region" aria-label={typographie(`Diaporama : ${d.titre}`)}>
    <p class="lecteur__acte" aria-hidden="true"><span class="lecteur__acte-titre">{t(acteDe(1).titre)}</span> <span class="lecteur__acte-dates">{t(acteDe(1).dates)}</span></p>
    <div class="lecteur__scene">
      <div class="lecteur__calque est-visible"><img src={urlMedia(d.slug, premiere.image.fichier)} alt={t(premiere.image.titre)} width={premiere.image.largeur} height={premiere.image.hauteur} decoding="async" /></div>
      <div class="lecteur__calque"><img alt="" decoding="async" /></div>
      <div class="lecteur__clip"><div class="clip__voile"></div><div class="clip__texte"></div></div>
      <p class="lecteur__legende est-visible" set:html={cartouche(premiere)} />
      <p class="lecteur__musique" aria-live="off"></p>
      <div class="lecteur__carton" data-action="passer" aria-hidden="true" title="Passer (Entrée)">
        <p class="lecteur__carton-titre"></p>
        <span class="lecteur__carton-filet"></span>
        <p class="lecteur__carton-dates"></p>
        {frise && <Fragment set:html={friseHtml('frise-t--carton')} />}
      </div>
      {[...lectureApres.values()].map((l) => <CarteCitation lecture={l} portrait={portraitDe(l)} fond={fondDe(l)} mode="lecteur" />)}
      {[...episodeApres.values()].map((e) => <EpisodeVisuels episode={e} slug={d.slug} fonds={fonds} mode="lecteur" />)}
      {frise && <Fragment set:html={friseHtml('frise-t--surimpression')} />}
      <Surimpressions diaporama={d} fonds={fonds} plan={plan} />
      <div class="lecteur__depart">
        <button type="button" class="lecteur__bouton-depart" data-action="lancer">Lancer le diaporama</button>
        <button type="button" class="lecteur__bouton-depart lecteur__reprendre" data-action="reprendre" hidden></button>
      </div>
    </div>
    <p class="lecteur__soustitre"><span class="st">{t(premiere.narration)}</span></p>

    <div class="lecteur__progression" aria-label="Actes du diaporama">
      <div class="lecteur__piste">
        {d.actes.map((a) => (
          <button type="button" class="lecteur__segment" data-debut={a.debut} title={t(`${a.titre} (${a.dates})`)} aria-label={typographie(`Aller à l'acte : ${a.titre} (${a.dates})`)}>
            <span class="lecteur__rempli"></span>
          </button>
        ))}
      </div>
    </div>

    <div class="lecteur__controles">
      <div class="lecteur__groupe">
        <button type="button" class="lecteur__btn" data-action="precedent" aria-label="Diapositive précédente" title="Précédente (←)">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 5v14M19 5l-10 7 10 7z" /></svg>
        </button>
        <button type="button" class="lecteur__btn lecteur__btn--lecture" data-action="basculer" aria-label="Lecture" title="Lecture / pause (espace)">
          <svg class="icone-lecture" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4.5l13 7.5-13 7.5z" /></svg>
          <svg class="icone-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" /></svg>
        </button>
        <button type="button" class="lecteur__btn" data-action="suivant" aria-label="Diapositive suivante" title="Suivante (→)">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 5v14M5 5l10 7-10 7z" /></svg>
        </button>
      </div>
      <p class="lecteur__compteur" aria-live="polite"><span class="sr-only">Diapositive </span><span class="lecteur__n">1</span> / {d.diapositives.length}</p>
      <p class="lecteur__temps"><span class="lecteur__ecoule">0:00</span> / <span class="lecteur__total"></span></p>
      <div class="lecteur__groupe lecteur__groupe--options">
        {d.musique && (
          <span class="lecteur__reglage-musique">
            <button type="button" class="lecteur__option" data-action="musique" aria-pressed="true" title="Musique de fond (M)">Musique</button>
            <input type="range" class="lecteur__volume" min="0" max="100" step="5" value="80" aria-label="Volume de la musique de fond" title="Volume de la musique de fond" />
          </span>
        )}
        <button type="button" class="lecteur__option" data-action="sous-titres" aria-pressed="true" title="Sous-titres (S)">Sous-titres</button>
        <button type="button" class="lecteur__option" data-action="plein-ecran" title="Plein écran (F)">Plein écran</button>
      </div>
    </div>
    <audio class="lecteur__audio" preload="auto"></audio>
    <audio class="lecteur__suite" preload="auto"></audio>
  </div>

  <div class="livre">
    <p class="livre__note">{typographie('Le lecteur a besoin de JavaScript ; voici le diaporama sous forme de livre d\'images, avec le texte de la voix off.')}</p>
    {sectionsLivre.map((a) => (
      <section class="livre__acte">
        <h2>{t(a.titre)} <span class="livre__dates">{t(a.dates)}</span></h2>
        <ol start={a.debut}>
          {a.diapos.map((x) => (
            <li>
              <figure>
                <img src={urlMedia(d.slug, x.image.fichier)} alt={t(x.image.titre)} width={x.image.largeur} height={x.image.hauteur} loading="lazy" decoding="async" />
                <figcaption set:html={legende(x)} />
              </figure>
              <p>{t(x.narration)}</p>
              {intermedeApres.has(x.n) && (
                <div class="livre__chant">
                  <p class="livre__chant-titre" set:html={`${intermedeApres.get(x.n)!.instrumental ? 'Intermède musical' : 'Intermède chanté'} : ${cartoucheChant(intermedeApres.get(x.n)!).replace(/<span[^>]*>/g, ' — ').replace(/<\/span>/g, '')}`} />
                  {intermedeApres.get(x.n)!.paroles.length > 0 && <p class="livre__paroles">{intermedeApres.get(x.n)!.paroles.map(([, v], k) => <Fragment>{k > 0 && <br />}{t(v)}</Fragment>)}</p>}
                </div>
              )}
              {lectureApres.has(x.n) && (
                <div class="livre__lecture">
                  <p class="livre__segment-titre">Lecture</p>
                  <CarteCitation lecture={lectureApres.get(x.n)!} portrait={portraitDe(lectureApres.get(x.n)!)} mode="livre" />
                </div>
              )}
              {episodeApres.has(x.n) && (() => {
                const e = episodeApres.get(x.n)!;
                return (
                  <section class="livre__episode">
                    <h3 class="livre__segment-titre">Épisode · {t(e.titre)}</h3>
                    <p>{t(e.narration)}</p>
                    <EpisodeVisuels episode={e} slug={d.slug} fonds={fonds} mode="livre" />
                    <p class="livre__sources">{t(`Sources : ${e.sources.join(' ; ')}.`)}</p>
                  </section>
                );
              })()}
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>
</div>

<script>
  type Rect = [number, number, number, number]; // x0, y0, x1, y1 (fractions de l'image)
  /** Mots d'un texte (même découpage que `motsLus` de src/utils/diaporamas.ts et `commun.mots_lus`). */
  const motsLus = (texte: string) => [...texte.matchAll(/\S+/g)].filter((m) => /[\p{L}\p{N}]/u.test(m[0])).map((m) => ({ d: m.index!, f: m.index! + m[0].length }));
  interface Diapo {
    /** `u` : zone utile (fractions de l'image) ; `l` × `h` : ses dimensions (px). Les cadres de la
     *  caméra, l'ouverture et le cadre d'un intermède sont en fractions de la zone utile. */
    n: number; cle: string; img: string; u: Rect; l: number; h: number; alt: string; legende: string; texte: string;
    audio: string; duree: number; pause: number; camera: { c: Rect; t: number }[];
    /** Détail zoomé sur lequel s'ouvre le carton d'acte (spec 12, « Sortie du carton d'acte »). */
    ouv: Rect | null;
    /** Frise : jours (depuis 1970) du premier et du dernier jour daté, positions en %, libellé. */
    date: DateFrise | null;
    /** Segment joué après la voix (et sa pause) : intermède chanté, lecture ou épisode. */
    suite: Suite | null;
    /** Carte de lieu : fenêtre [a, b) (s de l'audio), point (%) dans le fond, partie du plan de
     *  Paris montrée (`vue` : taille ; position du fond CSS). */
    lieu: { a: number; b: number; nom: string; fond: string; x: number; y: number; ratio: number; vue?: string; credit?: string; points?: unknown[] } | null;
    /** Citation : fenêtre [a, b), début de chaque mot, fin du dernier, HTML des mots, auteur. */
    citation: { a: number; b: number; fin: number; mots: number[]; html: string; auteur: string } | null;
    /** Portraits des personnes nommées : fenêtre [a, b) de la rangée, et pour chaque personne
     *  (4 au plus) son nom, ses dates, l'image et l'instant où l'ovale paraît. */
    portraits: { a: number; b: number; gens: { id: string; nom: string; dates: string; src: string; t: number }[] } | null;
    /** Objet de musée détouré (coin bas `cote`) : fenêtre [a, b), image, proportions, légende. */
    objet: Objet | null;
    /** Manuscrit (côté `cote`) : même chose, plus le halo [x0, y0, x1, y1] (fractions de l'image). */
    manuscrit: (Objet & { halo: Rect }) | null;
    /** Chiffre clé (point 4) : fenêtre [a, b), valeur, texte final, prudence, unité, défilement. */
    chiffre: { a: number; b: number; valeur: number; texte: string; prefixe: string; unite: string; defile: boolean } | null;
    /** Date républicaine et sa correspondance grégorienne : fenêtre [a, b). */
    date: { a: number; b: number; republicain: string; gregorien: string } | null;
  }
  interface Objet { a: number; b: number; src: string; ratio: number; nom: string; legende: string; cote: 'gauche' | 'droite' }
  /** Intermède chanté : paroles [instant, vers, début de chaque mot (`motsLus`) ou null : vers
   *  entier à son début]. */
  interface SuiteChant { type: 'chant'; src: string; duree: number; legende: string; paroles: [number, string, number[] | null][]; instrumental: boolean; cadre: Rect | null }
  /** Lecture d'époque : instant de début de chaque mot (alignement forcé, ou prorata) et, pour
   *  chaque phrase, [début (s), premier mot, mot suivant le dernier]. */
  interface SuiteLecture { type: 'lecture'; id: string; src: string; duree: number; mots: number[]; phrases: [number, number, number][]; date: DateFrise | null }
  /** Épisode : phrases [début, fin (s), texte du sous-titre]. */
  interface SuiteEpisode { type: 'episode'; id: string; src: string; duree: number; phrases: [number, number, string][]; date: DateFrise | null }
  type Suite = SuiteChant | SuiteLecture | SuiteEpisode;
  interface Piste { src: string; duree: number; volume: number; info: string }
  interface DateFrise { j0: number; j1: number; x0: number; x1: number; libelle: string }
  interface Donnees {
    slug: string; pause: number; carton: number; saut: number;
    actes: { titre: string; dates: string; debut: number }[]; diapos: Diapo[];
    /** Musique de fond : les pistes de chaque acte. */
    fond: Piste[][];
  }

  // Caméra (spec 12, « Caméra calme et lente ») : chaque étape retenue est rejointe par une
  // transition dont la durée suit l'ampleur du mouvement (3 à 6 s, vitesse plafonnée), arrivée
  // peu après le passage ; entre deux transitions, la vue « respire » dans un seul sens.
  // Toutes les vues sont des rectangles aux proportions de la zone utile (cf. `vue`) : entre deux
  // d'entre elles, le chemin est une homothétie (zoom logarithmique, déplacement couplé), sans arc.
  const VITESSE_ZOOM = 0.22;   // plafond, en log d'échelle par seconde (au plus fort)
  const VITESSE_GLISSE = 0.3;  // plafond, en fraction de la scène par seconde (au plus fort)
  // Les durées visent 5 % sous les plafonds : l'horloge lissée peut accélérer de 5 % pour
  // rattraper l'audio, la vitesse réelle reste ainsi sous le plafond.
  const VISE_ZOOM = VITESSE_ZOOM / 1.05, VISE_GLISSE = VITESSE_GLISSE / 1.05;
  const DUREE_MIN = 3;         // s : une transition dure de 3 à 6 s selon son ampleur (plafonds ci-dessus)
  const RETARD = 1;            // s : arrivée visée, après le passage
  const TENUE_MIN = 1;         // s : arrêt minimal entre deux transitions
  const ECART_MIN = 5;         // s : moins entre deux passages → l'étape est ignorée
  const MICRO = 0.12;          // écart de zoom (log) et de position (fraction de la scène) en deçà duquel l'étape est ignorée
  // Respiration (« Moins de tenues statiques », révisé) : resserrement à sens unique de 4 % au
  // plus, glissement d'un tiers de la marge libre, vitesse constante après une mise en route douce
  // (et arrêt doux, pour se raccorder sans à-coup à la transition suivante ou à la fin de la voix).
  const SOUFFLE = 0.04;
  const SOUFFLE_VITESSE = 0.005; // par seconde : une tenue courte respire moins
  const GLISSE = 1 / 3;
  const MISE_EN_ROUTE = 2.5;     // s (mise en route, et arrêt)
  // Entrée d'une image (spec 12, « Animations d'entrée ») : fondu enchaîné, révélation
  // gris → couleur, recul de ~4 % jusqu'au cadre de la caméra. Horloge propre à l'entrée,
  // indépendante de l'audio : la caméra n'est jamais décalée. L'entrée est une transition
  // visuelle courte : elle va toujours à son terme, même en pause (jamais d'image à demi
  // entrée bloquée si la voix ne démarre pas).
  const FONDU = 1.2;        // s
  const REVELATION = 1.8;   // s : les couleurs montent
  const RECUL = 0.04;       // agrandissement de départ
  const DUREE_RECUL = 1.5;  // s
  const FONDU_REDUIT = 0.3; // s, prefers-reduced-motion : fondu simple, ni recul ni gris
  // Sortie du carton d'acte (spec 12, « Sortie du carton d'acte en deux volets », révision du
  // 2026-10-08) : les volets s'ouvrent pendant les dernières secondes du carton (sa durée totale ne
  // change pas) ; la voix commence à la fin de l'ouverture. Si la diapositive a un détail
  // d'ouverture (`ouv`), l'image est découverte cadrée sur ce détail, avec une très légère
  // poussée, puis la caméra recule lentement vers son premier cadre pendant que la voix commence.
  const OUVERTURE = 3.5;        // s : ouverture des volets (prise sur la fin du carton)
  const POUSSEE = 0.025;        // resserrement pendant l'ouverture (arrêt doux à la fin)
  const RECUL_OUVERTURE = 5;    // s : recul du détail vers le premier cadre (après l'ouverture)
  const RAMPE_RECUL = 0.4;      // part du recul en mise en route (et autant en arrêt)
  // Frise du temps en surimpression : durée d'affichage (le curseur glisse de 0,5 à 1,5 s, cf. CSS).
  const SURIMPRESSION = 3.6; // s
  const adoucir = (t: number) => { const u = Math.min(1, Math.max(0, t)); return u * u * (3 - 2 * u); };
  const melanger = (a: Rect, b: Rect, t: number) => a.map((v, k) => v + (b[k] - v) * t) as Rect;
  /** Le cadre agrandi (k > 1) ou resserré (k < 1) autour de son centre. */
  function echelle([x0, y0, x1, y1]: Rect, k: number): Rect {
    const cx = (x0 + x1) / 2, cy = (y0 + y1) / 2, w = ((x1 - x0) * k) / 2, h = ((y1 - y0) * k) / 2;
    return [cx - w, cy - h, cx + w, cy + h];
  }
  /** Avancement (0 → 1) d'un mouvement de `d` secondes à l'instant `t` : vitesse constante, avec
   *  mise en route et arrêt de `m` secondes (rampes en smoothstep : vitesse et accélération
   *  continues). La vitesse au plus fort vaut 1 / (d − m). */
  function profil(t: number, d: number, m: number) {
    if (t <= 0 || d <= 0) return t >= d ? 1 : 0;
    if (t >= d) return 1;
    m = Math.min(m, d / 2);
    const I = (u: number) => u * u * u - (u * u * u * u) / 2; // ∫ smoothstep, I(1) = 1/2
    const tot = d - m;
    if (t < m) return (m * I(t / m)) / tot;
    if (t <= d - m) return (m / 2 + t - m) / tot;
    return 1 - (m * I((d - t) / m)) / tot;
  }
  /** Entre deux vues de mêmes proportions : rapport de largeur `r`, et la part `s` (0 → 1) du
   *  zoom logarithmique ramenée sur l'interpolation linéaire des bords (homothétie : le point
   *  fixe reste immobile à l'écran, le centre avance à vitesse constante). */
  const partLog = (r: number, s: number) => (Math.abs(r - 1) < 1e-4 ? s : (1 - Math.pow(r, s)) / (1 - r));
  const trajet = (a: Rect, b: Rect, s: number) => melanger(a, b, partLog((b[2] - b[0]) / (a[2] - a[0]), s));
  /** Ampleur d'un trajet : zoom (|log du rapport d'échelle|) et déplacement du centre de l'écran
   *  (en fraction de la scène, constant le long du trajet). */
  function ampleur(a: Rect, b: Rect) {
    const wa = a[2] - a[0], ha = a[3] - a[1], r = (b[2] - b[0]) / wa, lr = Math.log(r);
    const k = Math.abs(r - 1) < 1e-4 ? 1 : lr / (r - 1);
    const g = Math.max(Math.abs((b[0] + b[2] - a[0] - a[2]) / 2) / wa, Math.abs((b[1] + b[3] - a[1] - a[3]) / 2) / ha) * k;
    return { zoom: Math.abs(lr), glisse: g };
  }
  /** Vue respirante après `t` secondes d'une tenue de `d` secondes sur la vue `c` : resserrement
   *  à sens unique, glissement dans une direction propre à la diapositive `n` et à l'étape `k`
   *  (angle d'or). Le sous-cadre reste dans `c` (et donc dans l'image). */
  function souffle(c: Rect, t: number, d: number, n: number, k: number): Rect {
    const m = Math.min(MISE_EN_ROUTE, d / 2);
    const serre = Math.min(SOUFFLE, SOUFFLE_VITESSE * Math.max(0, d - m));
    if (serre <= 0) return c;
    const a = n * 2.39996 + k * 1.7, g = (GLISSE * serre) / 2;
    const r = echelle(c, 1 - serre), ox = Math.cos(a) * g * (c[2] - c[0]), oy = Math.sin(a) * g * (c[3] - c[1]);
    return trajet(c, [r[0] + ox, r[1] + oy, r[2] + ox, r[3] + oy], profil(t, d, m));
  }
  const CLE_ST = 'diaporamas-sous-titres';
  const CLE_MUSIQUE = 'diaporamas-musique';
  const CLE_VOLUME = 'diaporamas-musique-volume';
  // Musique de fond (spec 12, « Musique ») : gain selon l'état du lecteur, relatif au volume
  // réglé (80 % par défaut = valeurs ci-dessous). Fichiers normalisés à -20 LUFS, voix vers
  // -19,5 LUFS : sous la voix, la musique est ~20 dB plus bas ; un peu plus présente dans les
  // respirations ; elle remonte pendant les cartons d'acte et se tait pendant un intermède chanté.
  const GAINS = { arret: 0, chant: 0, voix: 0.1, respiration: 0.3, carton: 1 } as const;
  type EtatMusique = keyof typeof GAINS;
  const VOLUME_DEFAUT = 0.8;
  const FONDU_PISTE = 3;   // s : enchaînement de deux pistes d'un même acte (fondus inclus dans les fichiers)
  const FONDU_ACTE = 2;    // s : changement d'acte (pendant le carton) ou saut vers un autre acte
  const lire = (cle: string) => { try { return localStorage.getItem(cle); } catch { return null; } };
  const ecrire = (cle: string, v: string | null) => {
    try { v === null ? localStorage.removeItem(cle) : localStorage.setItem(cle, v); } catch { /* stockage indisponible */ }
  };
  const mouvementReduit = window.matchMedia('(prefers-reduced-motion: reduce)');
  const maintenant = () => performance.now() / 1000;

  function mmss(s: number) {
    s = Math.max(0, Math.floor(s));
    const h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60), sec = String(s % 60).padStart(2, '0');
    return h ? `${h}:${String(m).padStart(2, '0')}:${sec}` : `${m}:${sec}`;
  }

  /** Chronomètre qu'on peut figer et relancer (carton d'acte ; entrée d'une image). */
  class Chrono {
    ecoule = 0; depuis = 0; // `depuis` : instant de la dernière relance (0 = figé)
    get t() { return this.ecoule + (this.depuis ? maintenant() - this.depuis : 0); }
    get tourne() { return this.depuis > 0; }
    zero() { this.ecoule = 0; this.depuis = 0; }
    relancer() { if (!this.depuis) this.depuis = maintenant(); }
    figer() { if (this.depuis) { this.ecoule += maintenant() - this.depuis; this.depuis = 0; } }
  }

  /** Horloge lissée (spec 12, « Sans bordures… », 2026-10-08) : `audio.currentTime` avance par
   *  crans irréguliers (mises à jour du moteur audio, ~10 à 250 ms), d'où une caméra saccadée. Entre
   *  deux mises à jour, l'instant avance avec l'horloge de l'écran (`performance.now()` ×
   *  `playbackRate`) ; l'écart à l'audio est rattrapé en douceur en modulant la vitesse (±5 % au
   *  plus), sans jamais reculer ni sauter. En pause, à l'arrêt ou après un saut (écart de plus de
   *  0,3 s), l'instant est celui de l'audio, exactement. */
  class HorlogeLissee {
    t = 0; brut = -1; p = 0; src = ''; ecart = 0; v = 1; jouait = false; parti = false;
    /** Instant de l'image en cours (horodatage de requestAnimationFrame, s) : la caméra avance
     *  alors d'exactement une image par image affichée, quel que soit le moment du calcul. */
    image = 0;
    lire(a: HTMLAudioElement) {
      const perf = performance.now() / 1000;
      const brut = a.currentTime || 0, r = a.playbackRate || 1;
      const now = this.image && Math.abs(perf - this.image) < 0.1 ? this.image : perf;
      const joue = !a.paused && !a.ended && !a.seeking;
      if (!joue || !this.jouait || a.src !== this.src || now - this.p > 0.25 || Math.abs(brut - this.t) > 0.3) {
        this.t = brut; this.ecart = 0; this.v = r; this.parti = false;
      } else if (!this.parti) {
        // L'audio n'a pas encore avancé depuis le départ (latence de démarrage) : on l'attend.
        this.t = brut;
        this.parti = brut !== this.brut;
      } else {
        this.t += Math.min(0.1, Math.max(0, now - this.p)) * this.v;
        if (brut !== this.brut) {
          // Nouvelle valeur de l'audio : écart filtré (la valeur lue a quelques ms de retard,
          // variables), puis vitesse corrigée pour le résorber en ~1 s.
          this.ecart += 0.25 * (brut - this.t - this.ecart);
          this.v = r * (1 + Math.max(-0.05, Math.min(0.05, this.ecart)));
        }
      }
      this.brut = brut; this.p = now; this.src = a.src; this.jouait = joue;
      return this.t;
    }
  }

  function monter(racine: HTMLElement) {
    const D: Donnees = JSON.parse(racine.querySelector('.diaporama__donnees')!.textContent!);
    const $ = <T extends HTMLElement = HTMLElement>(s: string) => racine.querySelector(s) as T;
    const lecteur = $('.lecteur');
    const scene = $('.lecteur__scene');
    const calques = [...racine.querySelectorAll<HTMLElement>('.lecteur__calque')];
    const audio = $<HTMLAudioElement>('.lecteur__audio');
    const sa = $<HTMLAudioElement>('.lecteur__suite'); // lecteur des segments (chant, lecture, épisode)
    const elActe = $('.lecteur__acte'), elLegende = $('.lecteur__legende'), elSt = $('.lecteur__soustitre');
    const elMusique = $('.lecteur__musique');
    const elClipTexte = $('.clip__texte');
    const elActeTitre = $('.lecteur__acte-titre'), elActeDates = $('.lecteur__acte-dates');
    const elCarton = $('.lecteur__carton'), elCartonTitre = $('.lecteur__carton-titre'), elCartonDates = $('.lecteur__carton-dates');
    const elN = $('.lecteur__n'), elEcoule = $('.lecteur__ecoule'), elTotal = $('.lecteur__total');
    const depart = $('.lecteur__depart'), btnReprendre = $<HTMLButtonElement>('.lecteur__reprendre');
    const btnLecture = $<HTMLButtonElement>('.lecteur__btn--lecture');
    const btnSt = $<HTMLButtonElement>('[data-action="sous-titres"]');
    const btnPe = $<HTMLButtonElement>('[data-action="plein-ecran"]');
    const btnMusique = racine.querySelector<HTMLButtonElement>('[data-action="musique"]');
    const curseurVolume = racine.querySelector<HTMLInputElement>('.lecteur__volume');
    const segments = [...racine.querySelectorAll<HTMLButtonElement>('.lecteur__segment')];
    const CLE_POS = `diaporama:${D.slug}`;
    const N = D.diapos.length;

    // Acte de chaque diapositive ; un carton précède la première diapositive de chaque acte.
    const acteDe = D.diapos.map((x) => { let a = 0; D.actes.forEach((y, k) => { if (y.debut <= x.n) a = k; }); return a; });
    const prelude = D.diapos.map((_, k) => (k === 0 || acteDe[k] !== acteDe[k - 1] ? D.carton : 0));

    // Durées : chaque diapositive dure son carton éventuel + sa voix + la pause (6 s si la
    // voix manque).
    const voixEtPause = D.diapos.map((x) => (x.duree || 6) + x.pause);
    // Segment éventuel après la voix (intermède chanté, lecture, épisode), suivi lui aussi de la pause.
    const suiteEtPause = D.diapos.map((x) => (x.suite ? x.suite.duree + D.pause : 0));
    const durees = D.diapos.map((_, k) => prelude[k] + voixEtPause[k] + suiteEtPause[k]);
    const debuts: number[] = [];
    durees.reduce((s, x, i) => ((debuts[i] = s), s + x), 0);
    const total = debuts[N - 1] + durees[N - 1];
    elTotal.textContent = mmss(total);

    // Barre de progression : un segment par acte, de largeur proportionnelle à sa durée.
    const bornes = D.actes.map((a, i) => {
      const de = D.diapos.findIndex((x) => x.n >= a.debut);
      const fin = i < D.actes.length - 1 ? D.diapos.findIndex((x) => x.n >= D.actes[i + 1].debut) : N;
      return { de, fin, t0: debuts[de], t1: fin < N ? debuts[fin] : total };
    });
    segments.forEach((s, i) => (s.style.flexGrow = String(bornes[i].t1 - bornes[i].t0)));

    const horloge = new HorlogeLissee(), horlogeSuite = new HorlogeLissee();
    let i = 0;            // diapositive courante (index)
    let lance = false;    // le diaporama a-t-il démarré ?
    let joue = false;     // lecture en cours ?
    let visible = 0;      // calque visible (au-dessus)
    let sortant = -1;     // calque qui s'efface pendant un fondu enchaîné (-1 : aucun)
    let minuterie = 0;    // carton, pause entre deux diapositives, ou durée sans voix
    let debutSansVoix = 0, ecouleSansVoix = 0;
    // Ce que montre chaque calque : la diapositive et le dernier cadre rendu.
    const couches: { x: Diapo | null; r: Rect }[] = [{ x: D.diapos[0], r: [0, 0, 1, 1] }, { x: null, r: [0, 0, 1, 1] }];
    // Carton d'acte en cours (horloge figée par la pause).
    let enCarton = false;
    const chronoCarton = new Chrono();
    // Ouverture du carton en cours (ses dernières secondes) : l'image est posée dessous, les volets
    // s'écartent au rythme de l'horloge du carton.
    let ouvre = false;
    /** Secondes écoulées dans l'ouverture du carton (0 à OUVERTURE). */
    const tempsOuverture = () => Math.min(OUVERTURE, Math.max(0, chronoCarton.t - (prelude[i] - OUVERTURE)));
    // Entrée de l'image visible (fondu, gris → couleur, recul).
    let enEntree = false;
    const chronoEntree = new Chrono();
    // Entrée sous un écran couvrant (carton d'acte, carte de lecture, panneau d'épisode) : pas de
    // fondu enchaîné depuis l'ancienne image (elle réapparaîtrait pendant que l'écran s'efface) ;
    // la nouvelle est posée opaque dessous et l'écran ne se lève qu'une fois l'image décodée.
    let entreeNette = false;
    /** Attend que l'image soit décodée (au plus ~1,5 s) avant de lever l'écran qui la couvre. */
    function quandPrete(img: HTMLImageElement, fn: () => void) {
      let fait = false;
      const une = () => { if (!fait) { fait = true; fn(); } };
      window.setTimeout(une, 1500);
      (img.complete && img.naturalWidth ? img.decode() : new Promise((ok) => {
        img.addEventListener('load', ok, { once: true });
        img.addEventListener('error', ok, { once: true });
      }).then(() => img.decode())).catch(() => {}).then(une);
    }
    // Segment après la voix (intermède chanté, lecture, épisode) : en cours, ou terminé (pause
    // avant la diapositive suivante).
    let enSuite = false, suiteFini = false;

    // --- Image : taille, caméra, entrée ----------------------------------------------------
    // L'image couvre toute la scène (recadrée, jamais de bandes vides) ; la caméra montre le
    // cadre visé en entier dans la zone que ne couvrent ni le cartouche ni les bandeaux.
    function cadre(c: HTMLElement, x: Diapo) {
      const W = scene.clientWidth, H = scene.clientHeight;
      // La zone utile couvre la scène (zoom au besoin) : jamais de bord ni de bande hors de l'œuvre.
      const s = Math.max(W / x.l, H / x.h);
      c.style.width = `${W}px`;
      c.style.height = `${H}px`;
      const img = c.querySelector('img')!;
      img.style.width = `${(x.l * s) / (x.u[2] - x.u[0])}px`;
      img.style.height = `${(x.h * s) / (x.u[3] - x.u[1])}px`;
    }

    // Hauteurs couvertes en haut (cartouche, acte en plein écran) et en bas (sous-titre,
    // progression et contrôles en plein écran) : le cadre visé est placé entre les deux.
    // Le cartouche est mesuré sans sa transformation (glissement d'entrée) : offsetTop/Height.
    let marges = { haut: 0, bas: 0 }; // zones couvertes, constantes pendant une diapositive
    let basLieu = 0; // hauteur couverte en bas par le médaillon de lieu (s'il était affiché)
    let basCotes = { gauche: 0, droite: 0 }; // bas couvert de chaque côté (manuscrit)
    let hautBrut = 0; // haut couvert (cartouche), sans la réduction qui garde 55 % à la caméra
    const surimpressions = [elActe, elLegende, elMusique, elSt, $('.lecteur__progression'), $('.lecteur__controles')];
    function mesurerMarges() {
      const s = scene.getBoundingClientRect();
      let haut = 0, bas = 0;
      for (const el of surimpressions) {
        let r: { top: number; bottom: number; left: number; right: number; width: number; height: number } = el.getBoundingClientRect();
        if (el === elMusique && !el.classList.contains('est-visible')) continue;
        if (el === elLegende || el === elMusique) {
          const top = s.top + scene.clientTop + el.offsetTop, left = s.left + scene.clientLeft + el.offsetLeft;
          r = { top, left, bottom: top + el.offsetHeight, right: left + el.offsetWidth, width: el.offsetWidth, height: el.offsetHeight };
        }
        if (!r.height || !r.width || r.bottom <= s.top || r.top >= s.bottom || r.right <= s.left || r.left >= s.right) continue;
        if ((r.top + r.bottom) / 2 < s.top + s.height / 2) haut = Math.max(haut, r.bottom - s.top + 4);
        else bas = Math.max(bas, s.bottom - r.top + 4);
      }
      // La frise en surimpression se pose au-dessus des bandeaux du bas (plein écran).
      scene.style.setProperty('--frise-bas', `${Math.round(bas)}px`);
      // Médaillon de lieu : sa place est réservée pour toute la diapositive (et non le temps de son
      // affichage) : une zone couverte qui change en cours de route ferait bouger la caméra d'un
      // coup (mesures du 2026-10-08 : jusqu'à 10 fois le plafond de vitesse en 0,9 s).
      basLieu = elLieu && D.diapos[i].lieu ? scene.clientHeight - elLieu.offsetTop + 4 : 0;
      // Rangée de portraits (en bas à gauche) : même principe, place réservée pour toute la
      // diapositive, mesurée sans la frise (qui la fait monter le temps de son passage).
      const basPortraits = elPortraits && D.diapos[i].portraits
        ? elPortraits.offsetHeight + (parseFloat(getComputedStyle(elPortraits).left) || 0) + bas + 4 : 0;
      // Objet de musée (coin bas) : même principe, place réservée pour toute la diapositive.
      const basObjet = elObjet && D.diapos[i].objet
        ? elObjet.offsetHeight + (parseFloat(getComputedStyle(elObjet).right) || 8) + bas + 4 : 0;
      // Bas occupé de chaque côté (le manuscrit se pose au-dessus de celui de son côté seulement).
      const objetGauche = D.diapos[i].objet?.cote === 'gauche';
      basCotes = { gauche: Math.max(bas, basPortraits, objetGauche ? basObjet : 0), droite: Math.max(bas, basLieu, objetGauche ? 0 : basObjet) };
      bas = Math.max(bas, basLieu, basPortraits, basObjet);
      // La zone libre garde au moins 55 % de la hauteur.
      const k = Math.min(1, (0.45 * s.height) / Math.max(1, haut + bas));
      marges = { haut: haut * k, bas: bas * k };
      hautBrut = haut;
      tailleManuscrit();
    }

    /** Transformation CSS qui montre `r` en entier dans la zone utile, l'image couvrant toujours
     *  la scène. Un cadre trop haut pour la zone est montré depuis son bord supérieur (têtes).
     *  `f` ≥ 1 : agrandissement supplémentaire (recul d'entrée) autour du centre de la zone
     *  utile ; il se compose avec la caméra et garde la scène couverte. */
    function transformation(c: HTMLElement, x: Diapo, r: Rect, f = 1) {
      const W = c.clientWidth, H = c.clientHeight;
      const img = c.querySelector('img')!;
      // Taille posée par `cadre` (offsetWidth l'arrondirait au pixel : zoom faussé de quelques millièmes).
      const IW = parseFloat(img.style.width) || img.offsetWidth || W, IH = parseFloat(img.style.height) || img.offsetHeight || H;
      // Tout le calcul se fait dans la zone utile de l'image (`x.u`, sans bordure ni légende), qui
      // couvre la scène : `r` y est exprimé, et la translation finale tient compte de son décalage.
      const u = x.u, iw = IW * (u[2] - u[0]), ih = IH * (u[3] - u[1]);
      const T = marges.haut, Hs = Math.max(1, H - marges.haut - marges.bas);
      const rx = r[0] * iw, ry = r[1] * ih, rw = Math.max(1, (r[2] - r[0]) * iw), rh = Math.max(1, (r[3] - r[1]) * ih);
      const z = Math.max(1, Math.min(W / rw, Hs / rh));
      let tx = W / 2 - z * (rx + rw / 2);
      let ty = z * rh <= Hs + 0.5 ? T + Hs / 2 - z * (ry + rh / 2) : T - z * ry;
      tx = Math.min(0, Math.max(W - z * iw, tx));
      ty = Math.min(0, Math.max(H - z * ih, ty));
      // Agrandir autour d'un point de la scène garde l'image couvrante (f ≥ 1).
      const px = W / 2, py = T + Hs / 2;
      tx = px + f * (tx - px); ty = py + f * (ty - py);
      tx -= z * f * u[0] * IW; ty -= z * f * u[1] * IH;
      // Sous-pixel et échelle fine : un mouvement très lent ne doit pas avancer par crans.
      return `translate3d(${tx.toFixed(2)}px, ${ty.toFixed(2)}px, 0) scale(${(z * f).toFixed(6)})`;
    }

    /** Partie de l'image réellement montrée pour le cadre `r` (mêmes calculs que
     *  `transformation`) : le cadre porté aux proportions de la zone utile, borné à l'image (la
     *  scène entière, bandeaux compris, reste couverte). La caméra ne travaille que sur ces vues :
     *  toutes de mêmes proportions, elles s'enchaînent par homothétie, et `transformation` n'a
     *  jamais à les rogner en cours de mouvement (un rognage brusque ferait un à-coup). */
    function vue(x: Diapo, r: Rect): Rect {
      const W = scene.clientWidth, H = scene.clientHeight;
      if (!W || !H) return r;
      const s = Math.max(W / x.l, H / x.h), iw = x.l * s, ih = x.h * s;
      const Hs = Math.max(1, H - marges.haut - marges.bas);
      const rw = Math.max(1, (r[2] - r[0]) * iw), rh = Math.max(1, (r[3] - r[1]) * ih);
      const z = Math.max(1, Math.min(W / rw, Hs / rh));
      const w = Math.min(1, W / z / iw), h = Math.min(1, Hs / z / ih);
      // Bandeaux couverts au-dessus et au-dessous de la zone utile, en fraction de l'image.
      const dh = marges.haut / z / ih, db = marges.bas / z / ih;
      // Un cadre trop haut pour la zone est montré depuis son bord supérieur (têtes).
      const x0 = Math.min(Math.max((r[0] + r[2]) / 2 - w / 2, 0), 1 - w);
      const y0 = Math.max(Math.min(z * rh <= Hs + 0.5 ? (r[1] + r[3]) / 2 - h / 2 : r[1], 1 - h - db), Math.min(dh, 1 - h));
      return [x0, y0, x0 + w, y0 + h];
    }

    /** Étapes retenues au rendu (spec 12, « Caméra calme et lente ») et fenêtre de chaque
     *  transition : [de, a] (s de l'audio). Une étape est ignorée si son passage suit le précédent
     *  retenu de moins de 5 s, si sa vue diffère à peine de la précédente, ou si sa transition ne
     *  tient plus avant la fin de la voix. Les données ne changent pas. */
    function plan(x: Diapo) {
      const E = x.camera, finVoix = x.duree || 6;
      // Après un détail d'ouverture, la première vue n'est atteinte qu'à la fin du recul : aucune
      // étape ne commence avant (la tenue minimale court à partir de là).
      const etapes = [{ v: vue(x, E[0].c), t: 0, de: 0, a: x.ouv ? dureeRecul(x) : 0 }];
      for (let k = 1; k < E.length; k++) {
        const p = etapes[etapes.length - 1], v = vue(x, E[k].c);
        if (E[k].t - p.t < ECART_MIN) continue;
        const { zoom, glisse } = ampleur(p.v, v);
        if (zoom < MICRO && glisse < MICRO) continue;
        // Durée : celle qui tient les plafonds (au plus fort, la vitesse vaut 1 / (d − rampe)) ;
        // 3 à 6 s d'ordinaire, davantage pour un long glissement le long d'une image très large.
        const u = Math.max(zoom / VISE_ZOOM, glisse / VISE_GLISSE);
        const besoin = Math.max(DUREE_MIN, u <= 2 * MISE_EN_ROUTE ? 1.5 * u : u + MISE_EN_ROUTE);
        const tot = p.a + TENUE_MIN;
        // Arrivée visée peu après le passage ; plus tard si la transition précédente l'impose.
        const a = Math.min(finVoix, Math.max(E[k].t + RETARD, tot + besoin));
        const d = Math.min(besoin, a - tot);
        // Fin de voix trop proche : une transition un peu plus vive (×1,5 au plus) ou aucune.
        if (d < Math.max(DUREE_MIN, besoin / 1.5)) continue;
        etapes.push({ v, t: E[k].t, de: a - d, a });
      }
      return etapes;
    }

    /** Durée du recul depuis le détail d'ouverture : 5 s, davantage si l'ampleur l'exige pour
     *  rester sous les plafonds de vitesse au plus fort (vitesse de pointe 1 / (d − rampe)), moins
     *  si la voix est très courte (la moitié de la voix au plus). */
    function dureeRecul(x: Diapo) {
      let d = RECUL_OUVERTURE;
      if (x.ouv) {
        const { zoom, glisse } = ampleur(echelle(vue(x, x.ouv), 1 - POUSSEE), vue(x, x.camera[0].c));
        d = Math.max(d, Math.max(zoom / VISE_ZOOM, glisse / VISE_GLISSE) / (1 - RAMPE_RECUL));
      }
      return Math.min(d, 0.5 * (x.duree || 6));
    }

    /** Cadre (vue) montré à l'instant `t` (secondes dans l'audio) d'une diapositive. Un instant
     *  négatif (−OUVERTURE à 0) est l'ouverture du carton d'acte, avant la voix. */
    function cadreA(x: Diapo, t: number): Rect {
      const E = x.camera;
      if (mouvementReduit.matches) {
        // Premier cadre fixe, puis coupe sèche vers les suivants.
        let k = 0;
        while (k + 1 < E.length && E[k + 1].t <= t) k++;
        return E[k].c;
      }
      // La dernière tenue s'arrête (en douceur) à la fin de la voix : l'horloge s'y arrête.
      const finVoix = x.duree || 6;
      const P = plan(x);
      if (x.ouv) {
        // Détail d'ouverture : légère poussée pendant les volets (départ et arrêt doux), puis
        // recul vers la première vue, doux aux deux bouts ; la respiration prend le relais à
        // vitesse nulle (P[0].a = fin du recul) : position et vitesse continues partout.
        const O = vue(x, x.ouv), Op = echelle(O, 1 - POUSSEE);
        if (t < 0) return trajet(O, Op, profil(t + OUVERTURE, OUVERTURE, OUVERTURE / 2));
        const dr = P[0].a;
        if (t < dr) return trajet(Op, P[0].v, profil(t, dr, RAMPE_RECUL * dr));
      }
      const tenue = (k: number, u: number) => {
        const jusqua = k + 1 < P.length ? P[k + 1].de : finVoix;
        return souffle(P[k].v, u - P[k].a, jusqua - P[k].a, x.n, k);
      };
      for (let k = P.length - 1; k >= 1; k--) {
        if (t >= P[k].a) return tenue(k, t);
        if (t >= P[k].de) {
          const d = P[k].a - P[k].de;
          return trajet(tenue(k - 1, P[k].de), P[k].v, profil(t - P[k].de, d, Math.min(d / 3, MISE_EN_ROUTE)));
        }
      }
      return tenue(0, t);
    }

    /** Cadre montré pendant un intermède qui porte un `cadre` (instant `ts` dans son audio) :
     *  transition calme depuis la fin de la diapositive, puis respiration jusqu'à la fin. */
    function cadreIntermede(x: Diapo, c: SuiteChant & { cadre: Rect }, ts: number): Rect {
      if (mouvementReduit.matches) return c.cadre;
      const A = cadreA(x, x.duree || 6), B = vue(x, c.cadre);
      const { zoom, glisse } = ampleur(A, B);
      const u = Math.max(zoom / VISE_ZOOM, glisse / VISE_GLISSE);
      const d = Math.min(Math.max(DUREE_MIN, u <= 2 * MISE_EN_ROUTE ? 1.5 * u : u + MISE_EN_ROUTE), c.duree / 2);
      if (ts < d) return trajet(A, B, profil(ts, d, Math.min(d / 3, MISE_EN_ROUTE)));
      return souffle(B, ts - d, c.duree - d, x.n, 9);
    }

    /** Instant courant de la voix de la diapositive : l'audio fait foi, lissé (`horloge`). */
    function instant() {
      return D.diapos[i].audio
        ? horloge.lire(audio)
        : ecouleSansVoix + (joue && debutSansVoix ? (performance.now() - debutSansVoix) / 1000 : 0);
    }

    /** Pose un calque figé sur son dernier cadre (calque sortant, ou image d'avant un carton). */
    function poser(k: number) {
      const x = couches[k].x;
      if (!x) return;
      calques[k].querySelector('img')!.style.transform = transformation(calques[k], x, couches[k].r);
    }

    /** Rendu de l'image visible : caméra (horloge de l'audio) × entrée (horloge propre). */
    /** Durée de l'entrée d'une image : sur un détail d'ouverture, les couleurs montent pendant
     *  toute l'ouverture des volets et la caméra fait le recul (pas d'agrandissement d'entrée). */
    const revelation = (x: Diapo) => (x.ouv ? OUVERTURE : REVELATION);
    const dureeEntree = (x: Diapo) => (mouvementReduit.matches ? FONDU_REDUIT : Math.max(FONDU, revelation(x), x.ouv ? 0 : DUREE_RECUL));

    function rendre(t = instant()) {
      majVolets();
      const c = calques[visible], x = couches[visible].x;
      if (x !== D.diapos[i]) return; // carton : l'image de la diapositive n'est pas encore entrée
      const img = c.querySelector('img')!;
      const reduit = mouvementReduit.matches;
      // Pendant l'ouverture du carton, l'entrée et la caméra suivent l'horloge du carton (figée
      // en pause) ; la caméra y vit aux instants négatifs, juste avant la voix.
      const ouv = enCarton && ouvre;
      const e = ouv ? tempsOuverture() : enEntree ? chronoEntree.t : Infinity;
      const opacite = entreeNette ? 1 : adoucir(e / (reduit ? FONDU_REDUIT : FONDU));
      const gris = reduit ? 0 : 1 - adoucir(e / revelation(x));
      const f = reduit || x.ouv ? 1 : 1 + RECUL * (1 - adoucir(e / DUREE_RECUL));
      majSurimpressions(t);
      // Intermède avec un cadre : la caméra suit l'horloge de l'intermède.
      const su = x.suite;
      const r = su?.type === 'chant' && su.cadre && (enSuite || suiteFini)
        ? cadreIntermede(x, su as SuiteChant & { cadre: Rect }, suiteFini ? su.duree : horlogeSuite.lire(sa))
        : cadreA(x, ouv ? tempsOuverture() - OUVERTURE : t);
      couches[visible].r = r;
      img.style.transform = transformation(c, x, r, f);
      img.style.filter = gris > 0.002 ? `grayscale(${gris.toFixed(3)})` : '';
      c.style.opacity = opacite.toFixed(3);
      if (opacite >= 1 && sortant >= 0) {
        calques[sortant].style.opacity = '0';
        calques[sortant].classList.remove('est-visible');
        sortant = -1;
      }
      if (enEntree && !ouv && e >= dureeEntree(x)) {
        enEntree = false;
        chronoEntree.zero();
      }
    }

    let raf = 0;
    function boucle(ts: number) {
      horloge.image = horlogeSuite.image = ts / 1000;
      rendre();
      if (enCarton) majTemps();
      if (enSuite) majSuite();
      raf = joue || (enEntree && chronoEntree.tourne) || chronoCarton.tourne ? requestAnimationFrame(boucle) : 0;
    }
    function animer() { if (!raf) raf = requestAnimationFrame(boucle); }
    // Onglet en arrière-plan (requestAnimationFrame suspendu) : l'état final de l'entrée est
    // posé quand même.
    let filet = 0;
    function assurerFin() {
      clearTimeout(filet);
      filet = window.setTimeout(() => { rendre(); if (enEntree && chronoEntree.tourne) assurerFin(); }, 2000);
    }

    /** Met l'image de la diapositive courante à l'écran ; `fondu` : avec l'entrée animée. */
    function montrerImage(x: Diapo, fondu: boolean, couvert = false) {
      const ancien = visible;
      const k = fondu ? 1 - visible : visible;
      const c = calques[k];
      const img = c.querySelector('img')!;
      cadre(c, x);
      if (img.getAttribute('src') !== x.img) img.src = x.img;
      img.alt = x.alt;
      couches[k] = { x, r: cadreA(x, 0) };
      entreeNette = fondu && couvert;
      if (entreeNette) {
        // Sous un écran couvrant : l'ancienne image disparaît tout de suite (jamais d'éclair à la
        // levée de l'écran) ; la nouvelle, opaque, garde la révélation gris → couleur et le recul.
        for (const [j, a] of calques.entries()) {
          if (j === k) continue;
          a.style.opacity = '0';
          a.classList.remove('est-visible');
          a.querySelector('img')!.alt = '';
        }
        sortant = -1;
      }
      if (fondu) {
        // Le calque entrant passe au-dessus ; l'ancien reste opaque dessous, figé.
        if (sortant >= 0 && sortant !== ancien) calques[sortant].style.opacity = '0';
        const a = calques[ancien];
        a.style.zIndex = '0';
        if (!entreeNette) a.style.opacity = '1';
        a.querySelector('img')!.alt = '';
        c.style.zIndex = '1';
        c.style.opacity = entreeNette ? '1' : '0';
        c.classList.add('est-visible');
        visible = k;
        sortant = entreeNette ? -1 : ancien;
        enEntree = true;
        chronoEntree.zero();
        chronoEntree.relancer();
        animer();
        assurerFin();
      } else {
        enEntree = false;
        chronoEntree.zero();
      }
      rendre();
    }

    // --- Frise du temps -----------------------------------------------------------------------
    const friseCarton = racine.querySelector<HTMLElement>('.frise-t--carton');
    const friseSur = racine.querySelector<HTMLElement>('.frise-t--surimpression');
    const ORIGINE: DateFrise = { j0: 0, j1: 0, x0: 0, x1: 0, libelle: '' };
    let derniere = -1;     // dernière diapositive affichée : sa date est la « date précédente »
    let minuterieFrise = 0;

    /** Saut notable : plus de 3 mois vers l'avant, ou tout retour en arrière (même règle que
     *  verifier.py). */
    const sautNotable = (de: DateFrise, a: DateFrise) => a.j1 < de.j0 || a.j0 - de.j1 > D.saut;

    /** Étiquettes des années : toutes, ou une sur 2, 5 ou 10 selon la place. */
    function graduer(f: HTMLElement) {
      const w = f.clientWidth;
      const annees = [...f.querySelectorAll<HTMLElement>('.frise-t__annee')];
      if (!w || !annees.length) return;
      const besoin = Math.max(...annees.slice(0, 3).map((e) => e.offsetWidth)) * 1.6;
      const pas = [1, 2, 5, 10].find((p) => (p * w) / annees.length >= besoin) ?? 10;
      annees.forEach((e) => e.classList.toggle('est-masquee', Number(e.dataset.a) % pas !== 0));
    }
    /** Date du curseur, centrée sur lui mais gardée dans la frise. */
    function placerDate(f: HTMLElement, dt: DateFrise) {
      const el = f.querySelector<HTMLElement>('.frise-t__date')!;
      const w = f.clientWidth, demi = w ? (el.offsetWidth / 2 / w) * 100 : 0;
      el.style.left = `${Math.min(100 - demi, Math.max(demi, (dt.x0 + dt.x1) / 2)).toFixed(3)}%`;
    }
    /** Curseur sur `dt` (trait, ou court segment pour une durée). */
    function poserCurseur(f: HTMLElement, dt: DateFrise, transition: boolean) {
      const c = f.querySelector<HTMLElement>('.frise-t__curseur')!, el = f.querySelector<HTMLElement>('.frise-t__date')!;
      c.style.transition = el.style.transition = transition ? '' : 'none';
      c.style.left = `${dt.x0}%`;
      c.style.width = `${Math.max(0, dt.x1 - dt.x0)}%`;
      el.textContent = dt.libelle;
      placerDate(f, dt);
    }
    /** Le curseur glisse de `de` à `a` (CSS, ~1 s, ease-in-out) ; segment de l'acte `k` marqué. */
    function glisser(f: HTMLElement, de: DateFrise, a: DateFrise, k: number) {
      graduer(f);
      f.querySelectorAll('.frise-t__acte').forEach((e, j) => e.classList.toggle('est-courant', j === k));
      poserCurseur(f, de, false);
      void f.offsetWidth;
      const bouge = !mouvementReduit.matches && (de.x0 !== a.x0 || de.x1 !== a.x1);
      poserCurseur(f, a, bouge);
    }
    function cacherFrise() {
      clearTimeout(minuterieFrise);
      friseSur?.classList.remove('est-visible');
    }
    /** Surimpression 3,6 s au bas de l'image ; horloge murale (éphémère, indépendante de la
     *  voix : une pause ne la fige pas). */
    function montrerFrise(de: DateFrise, a: DateFrise, k: number) {
      if (!friseSur) return;
      clearTimeout(minuterieFrise);
      friseSur.classList.remove('est-visible');
      void friseSur.offsetWidth;
      friseSur.classList.add('est-visible');
      glisser(friseSur, de, a, k);
      minuterieFrise = window.setTimeout(cacherFrise, SURIMPRESSION * 1000);
    }
    /** Après un redimensionnement : graduation et date recalées (le curseur est en %). */
    function ajusterFrises() {
      for (const f of [friseCarton, friseSur]) {
        if (!f) continue;
        graduer(f);
        const x = D.diapos[i].date;
        if (x && f.querySelector('.frise-t__date')!.textContent) placerDate(f, x);
      }
    }

    // --- Textes et compteurs ---------------------------------------------------------------
    /** Cartouche : l'ancien s'efface, le nouveau entre ~0,6 s après l'image (CSS). */
    /** Bandeaux (cartouches de l'image et de la musique) : bien visibles quelques secondes à
     *  chaque changement (~12 s), puis cachés en fondu lent ; le survol ou la pause les ramène (CSS). */
    const ESTOMPE = 12000;   // ms
    const REAPPARITION = 4000; // ms : après un toucher sur l'image (téléphone)
    const minuteriesEstompe = new Map<HTMLElement, number>();
    function estomperPlusTard(el: HTMLElement, delai = ESTOMPE) {
      el.classList.remove('est-discret');
      clearTimeout(minuteriesEstompe.get(el));
      minuteriesEstompe.set(el, window.setTimeout(() => el.classList.add('est-discret'), delai));
    }
    /** Toucher sur l'image : les cartouches cachés reviennent quelques secondes. */
    function revelerCartouches() {
      for (const el of [elLegende, elMusique]) if (el.classList.contains('est-discret')) estomperPlusTard(el, REAPPARITION);
    }
    function changerCartouche(x: Diapo) {
      racine.querySelectorAll('.lecteur__legende--sortant').forEach((e) => e.remove());
      if (elLegende.classList.contains('est-visible')) {
        const copie = elLegende.cloneNode(true) as HTMLElement;
        copie.setAttribute('aria-hidden', 'true');
        elLegende.after(copie);
        void copie.offsetWidth;
        copie.classList.add('lecteur__legende--sortant');
        window.setTimeout(() => copie.remove(), 500);
      }
      elLegende.innerHTML = x.legende;
      elLegende.classList.remove('est-visible');
      void elLegende.offsetWidth;
      elLegende.classList.add('est-visible');
      estomperPlusTard(elLegende);
    }
    /** Sous-titre en fondu croisé ; l'ancien texte, sorti du flux, ne change pas la hauteur. */
    function changerSousTitre(texte: string) {
      elSt.querySelectorAll('.st--sortant').forEach((e) => e.remove());
      const ancien = elSt.querySelector<HTMLElement>('.st');
      if (ancien && ancien.textContent === texte) return;
      if (ancien) {
        ancien.classList.add('st--sortant');
        ancien.setAttribute('aria-hidden', 'true');
        window.setTimeout(() => ancien.remove(), 700);
      }
      const s = document.createElement('span');
      s.className = 'st st--entrant';
      s.textContent = texte;
      elSt.append(s);
      void s.offsetWidth;
      s.classList.remove('st--entrant');
    }

    // --- Cartes de lieu et citations en surimpression (spec 12, 2026-10-07) ---------------------
    // Contenu posé à l'entrée de l'image ; affichage dérivé de l'instant de l'audio (rendre) : pause,
    // reprise et sauts restent justes. Médaillon ~5 s quand la voix dit le lieu (zone couverte pour
    // la caméra) ; citation mot à mot (sous-titre masqué), qui l'emporte sur le médaillon (fenêtres
    // déjà arbitrées au build). Au changement d'image, l'ancien contenu s'efface en fondu (copie).
    const elLieu = racine.querySelector<HTMLElement>('.lieu');
    const elPlan = elLieu?.querySelector<HTMLElement>('.lieu__plan') ?? null;
    const elMots = racine.querySelector<HTMLElement>('.mots');
    const elPortraits = racine.querySelector<HTMLElement>('.portraits');
    let portraitsEls: HTMLElement[] = [];
    let portraitsDits = -1;
    let motsEls: HTMLElement[][] = [];
    let motsDits = -1;
    /** Taille du médaillon : ~un quart de la hauteur de la scène (plancher lisible), selon le fond.
     *  À plusieurs lieux (spec 12, « Sans bordures, et médaillon plus grand ») : une fois et demie
     *  plus grand (~240 × 180 px au lieu de 160 × 120 sur ordinateur), dans la limite de la place
     *  (40 % de la hauteur, la moitié de la largeur), téléphone compris. */
    function tailleLieu() {
      const L = D.diapos[i].lieu, c = elLieu?.querySelector<HTMLElement>('.lieu__carte');
      if (!L || !c) return;
      const H = scene.clientHeight, W = scene.clientWidth;
      let h = Math.max(W < 700 ? 92 : 120, Math.min(230, H * 0.24));
      const multiple = Boolean(L.points?.length);
      if (multiple) h = Math.min(1.5 * h, 300, H * 0.4);
      let w = h * L.ratio;
      const lmax = W * (multiple ? 0.5 : 0.46);
      if (w > lmax) { w = lmax; h = w / L.ratio; }
      c.style.width = `${Math.round(w)}px`;
      c.style.height = `${Math.round(h)}px`;
      elLieu!.style.maxWidth = `${Math.round(w) + 12}px`;
    }
    /** Rangée de portraits (spec 12, « Portraits des personnes nommées ») : ovales d'environ 17 %
     *  de la hauteur de la scène (78 à 118 px de haut sur ordinateur, 50 sur téléphone), réduits si
     *  la rangée ne tient pas à côté du médaillon de lieu (coin opposé). Puis la citation : si elle
     *  touche la rangée, elle monte au-dessus d'elle, pour toute la diapositive (rien ne bouge
     *  pendant qu'elle est lue). */
    function taillePortraits() {
      const P = D.diapos[i].portraits;
      if (!elPortraits || !P) return;
      const H = scene.clientHeight, W = scene.clientWidth;
      const gauche = parseFloat(getComputedStyle(elPortraits).left) || 8;
      let h = Math.max(W < 700 ? 50 : 78, Math.min(118, H * 0.17));
      elPortraits.style.setProperty('--ovale-h', `${Math.round(h)}px`);
      const lieu = D.diapos[i].lieu && elLieu ? elLieu.offsetWidth + gauche : 0;
      const place = W - 2 * gauche - lieu;
      if (elPortraits.offsetWidth > place && place > 0) {
        h = Math.max(34, h * (place / elPortraits.offsetWidth));
        elPortraits.style.setProperty('--ovale-h', `${Math.round(h)}px`);
      }
      if (elMots) elMots.style.bottom = '';
      if (elMots && D.diapos[i].citation) {
        const libre = (W - elMots.offsetWidth) / 2;
        if (libre < gauche + elPortraits.offsetWidth + 8) elMots.style.bottom = `calc(var(--frise-bas, 0px) + ${Math.round(elPortraits.offsetHeight + gauche + 8)}px)`;
      }
    }
    // --- Objets de musée et manuscrits (spec 12, « Enrichissements visuels », 2026-10-08) -----
    const elObjet = racine.querySelector<HTMLElement>('.objet');
    const elManuscrit = racine.querySelector<HTMLElement>('.manuscrit');
    const msDoc = elManuscrit?.querySelector<HTMLElement>('.manuscrit__doc') ?? null;
    const msHalo = elManuscrit?.querySelector<HTMLElement>('.manuscrit__halo') ?? null;
    let msEtat = '';
    /** Objet : image d'environ 22 % de la hauteur de la scène (96 à 200 px sur ordinateur, 56 au
     *  moins sur téléphone ; 1,3 fois plus pour un objet très étroit), 30 % de la largeur au plus
     *  (34 % sur téléphone). */
    function tailleObjet() {
      const O = D.diapos[i].objet;
      if (!elObjet || !O) return;
      const H = scene.clientHeight, W = scene.clientWidth;
      let h = Math.max(W < 700 ? 56 : 96, Math.min(200, H * 0.22));
      // Objet très étroit (sabre) : un peu plus haut, sinon il ne se lit pas.
      if (O.ratio < 0.5) h = Math.min(h * 1.3, H * 0.3);
      let l = h * O.ratio;
      const lmax = W * (W < 700 ? 0.34 : 0.3);
      if (l > lmax) { l = lmax; h = l / O.ratio; }
      elObjet.style.setProperty('--objet-h', `${Math.round(h)}px`);
      elObjet.style.setProperty('--objet-l', `${Math.round(l)}px`);
    }
    /** Manuscrit : la page tient entre le cartouche et le bas occupé de son côté (médaillon de lieu
     *  à droite, portraits à gauche, objet dans son coin), 72 % de la hauteur de la scène au plus,
     *  40 % de sa largeur au plus (46 % sur téléphone), centrée dans cette bande ; la légende est
     *  comptée. Il ne réserve rien pour la caméra (comme la citation, il passe devant l'image). */
    function tailleManuscrit() {
      const M = D.diapos[i].manuscrit;
      if (!elManuscrit || !M) return;
      const H = scene.clientHeight, W = scene.clientWidth, ecart = W < 700 ? 6 : 12;
      // Sous le cartouche en entier (la réduction des marges de la caméra ne vaut pas ici).
      const haut = Math.min(hautBrut, 0.4 * H);
      const libre = H - haut - Math.min(basCotes[M.cote], 0.45 * H) - 2 * ecart;
      let h = Math.min(H * 0.72, libre - 44), l = h * M.ratio;
      const lmax = W * (W < 700 ? 0.46 : 0.4);
      if (l > lmax) { l = lmax; h = l / M.ratio; }
      const poser = () => {
        elManuscrit.style.setProperty('--ms-l', `${Math.round(l)}px`);
        elManuscrit.style.setProperty('--ms-h', `${Math.round(h)}px`);
      };
      poser();
      // La légende compte : si le tout dépasse la bande libre, la page est réduite d'autant.
      const trop = elManuscrit.offsetHeight - libre;
      if (trop > 0) { h = Math.max(60, h - trop); l = h * M.ratio; poser(); }
      elManuscrit.style.setProperty('--ms-haut', `${Math.round(haut + ecart + Math.max(0, (libre - elManuscrit.offsetHeight) / 2))}px`);
    }
    /** Zoom du manuscrit à l'instant `t` : de la page entière (1 s après son entrée) au passage
     *  éclairé (2,5 s de trajet, courbe douce, zoom logarithmique, 2,4 fois au plus, le passage
     *  occupant ~80 % de la page), puis halo en 1,2 s ; mouvement réduit : pas de zoom, halo
     *  d'emblée. Dérivé de l'instant lissé de l'audio : pause, reprise et sauts justes. */
    function majManuscrit(t: number) {
      const M = D.diapos[i].manuscrit;
      if (!msDoc || !msHalo || !M) return;
      const doux = (v: number) => { const u = Math.max(0, Math.min(1, v)); return u * u * (3 - 2 * u); };
      const [x0, y0, x1, y1] = M.halo, cx = (x0 + x1) / 2, cy = (y0 + y1) / 2;
      const cible = Math.max(1, Math.min(2.4, 0.8 / (x1 - x0), 0.8 / (y1 - y0)));
      const reduit = mouvementReduit.matches;
      const p = reduit ? 0 : doux((t - M.a - 1) / 2.5);
      const z = Math.pow(cible, p);
      const tx = Math.min(0, Math.max(1 - z, 0.5 - z * cx)), ty = Math.min(0, Math.max(1 - z, 0.5 - z * cy));
      const q = reduit ? (t >= M.a + 0.8 ? 1 : 0) : doux((t - M.a - 3) / 1.2);
      const etat = `translate(${(tx * 100).toFixed(3)}%, ${(ty * 100).toFixed(3)}%) scale(${z.toFixed(5)})|${q.toFixed(3)}`;
      if (etat === msEtat) return;
      msEtat = etat;
      const [tr, op] = etat.split('|');
      msDoc.style.transform = tr;
      msHalo.style.setProperty('--p', op);
    }
    // --- Chiffres clés et dates républicaines (spec 12, « Enrichissements visuels », point 4) --
    const elChiffre = racine.querySelector<HTMLElement>('.chiffre');
    const elChiffreValeur = elChiffre?.querySelector<HTMLElement>('.chiffre__valeur') ?? null;
    const elDate = racine.querySelector<HTMLElement>('.date-rep');
    const DEFILE = 1.4; // s : le chiffre défile jusqu'à sa valeur (courbe qui ralentit)
    const ecrireNombre = (v: number) => String(Math.round(v)).replace(/\B(?=(\d{3})+(?!\d))/g, '\u202f');
    /** Chiffre : ~15 % de la hauteur de la scène (54 à 112 px ; 40 px au moins sur téléphone).
     *  Centré dans le tiers inférieur ; s'il se montre en même temps qu'une surimpression de coin
     *  bas qui le toucherait, ou que la date républicaine, il monte au-dessus d'elle pour toute la
     *  diapositive (rien ne bouge pendant qu'il est là). Il ne réserve rien pour la caméra. */
    function tailleChiffre() {
      const x = D.diapos[i], C = x.chiffre;
      if (!elChiffre || !C) return;
      const H = scene.clientHeight, W = scene.clientWidth;
      elChiffre.style.setProperty('--chiffre-t', `${Math.round(Math.max(W < 700 ? 40 : 54, Math.min(112, H * 0.15)))}px`);
      elChiffre.style.removeProperty('--chiffre-bas');
      const ensemble = (f: { a: number; b: number } | null) => !!f && Math.min(f.b, C.b) > Math.max(f.a, C.a);
      const ecart = W < 700 ? 6 : 10;
      let bas = H * (W < 700 ? 0.06 : 0.07);
      const libre = (W - elChiffre.offsetWidth) / 2;
      for (const [el, f] of [[elLieu, x.lieu], [elPortraits, x.portraits], [elObjet, x.objet]] as const) {
        if (!el || !ensemble(f)) continue;
        const cs = getComputedStyle(el);
        const bord = Math.max(...[cs.left, cs.right].map((v) => parseFloat(v)).filter((v) => isFinite(v) && v >= 0 && v < W / 3), 0);
        if (el.offsetWidth + bord + 8 > libre) bas = Math.max(bas, el.offsetHeight + bord + ecart);
      }
      if (elDate && ensemble(x.date)) {
        const bord = W < 700 ? 8 : 12;
        bas = Math.max(bas, elDate.offsetHeight + bord + ecart);
      }
      elChiffre.style.setProperty('--chiffre-bas', `${Math.round(bas)}px`);
    }
    /** Valeur du chiffre à l'instant `t` : de 0 à sa valeur en 1,4 s (par pas ronds : 1, 10 ou
     *  1 000 selon sa grandeur), puis fixe ; sous 20, ou en mouvement réduit, la valeur d'emblée. */
    let chiffreTexte = '';
    function majChiffre(t: number) {
      const C = D.diapos[i].chiffre;
      if (!elChiffreValeur || !C) return;
      const p = mouvementReduit.matches || !C.defile ? 1 : Math.max(0, Math.min(1, (t - C.a) / DEFILE));
      const pas = Math.max(1, Math.pow(10, Math.floor(Math.log10(C.valeur)) - 2));
      const v = p >= 1 ? C.valeur : Math.round((C.valeur * (1 - Math.pow(1 - p, 3))) / pas) * pas;
      const texte = ecrireNombre(v);
      if (texte !== chiffreTexte) { elChiffreValeur.textContent = texte; chiffreTexte = texte; }
    }

    /** Copie qui s'efface (transition CSS) pendant que l'original reçoit le contenu suivant. */
    function effacer(el: HTMLElement) {
      if (!el.classList.contains('est-visible')) return;
      const copie = el.cloneNode(true) as HTMLElement;
      el.after(copie);
      void copie.offsetWidth;
      copie.classList.remove('est-visible');
      window.setTimeout(() => copie.remove(), 900);
      el.classList.remove('est-visible');
    }
    function chargerSurimpressions(x: Diapo | null) {
      if (elLieu) effacer(elLieu);
      if (elMots) effacer(elMots);
      if (elPortraits) effacer(elPortraits);
      if (elObjet) effacer(elObjet);
      if (elManuscrit) effacer(elManuscrit);
      if (elChiffre) effacer(elChiffre);
      if (elDate) effacer(elDate);
      lecteur.classList.remove('avec-citation', 'avec-lieu', 'avec-portraits', 'avec-objet', 'avec-manuscrit', 'avec-chiffre', 'avec-date');
      // Chiffre et date : contenu posé d'emblée (invisible).
      const CH = x?.chiffre, DR = x?.date;
      if (elChiffre && CH) {
        elChiffre.querySelector('.chiffre__prefixe')!.textContent = CH.prefixe;
        elChiffre.querySelector('.chiffre__mesure')!.textContent = CH.texte;
        elChiffre.querySelector('.chiffre__unite')!.textContent = CH.unite;
        chiffreTexte = '';
        majChiffre(CH.a);
      }
      if (elDate && DR) {
        elDate.querySelector('.date-rep__rep')!.textContent = DR.republicain;
        elDate.querySelector('.date-rep__greg')!.textContent = DR.gregorien;
      }
      // Objet et manuscrit : contenu posé d'emblée (invisible), si bien que la place réservée ne
      // change pas pendant la diapositive.
      const O = x?.objet, M = x?.manuscrit;
      for (const [el, v] of [[elObjet, O], [elManuscrit, M]] as const) {
        if (!el || !v) continue;
        el.querySelector('img')!.src = v.src;
        el.querySelector('.objet__nom')!.textContent = v.nom;
        el.querySelector('.objet__legende')!.textContent = v.legende;
        el.classList.toggle('est-gauche', v.cote === 'gauche');
      }
      if (M && msHalo) {
        const [x0, y0, x1, y1] = M.halo;
        Object.assign(msHalo.style, { left: `${x0 * 100}%`, top: `${y0 * 100}%`, width: `${(x1 - x0) * 100}%`, height: `${(y1 - y0) * 100}%` });
        msEtat = '';
      }
      tailleObjet();
      const L = x?.lieu;
      if (elLieu && L) {
        elLieu.querySelectorAll<HTMLElement>('.lieu__fond').forEach((f) => f.classList.toggle('est-actif', f.dataset.fond === L.fond));
        if (L.fond === 'paris' && elPlan && L.vue) {
          const [taille, position] = L.vue.split(';');
          if (!elPlan.style.backgroundImage) elPlan.style.backgroundImage = `url("${elPlan.dataset.src}")`;
          elPlan.style.backgroundSize = taille;
          elPlan.style.backgroundPosition = position;
        }
        const pt = elLieu.querySelector<HTMLElement>('.lieu__point')!;
        pt.style.left = `${L.x}%`;
        pt.style.top = `${L.y}%`;
        elLieu.querySelector('.lieu__nom')!.textContent = L.nom;
        elLieu.querySelector('.lieu__credit')!.textContent = L.credit ?? '';
        tailleLieu();
      }
      const C = x?.citation;
      motsEls = [];
      motsDits = -1;
      if (elMots && !C) elMots.querySelector('.mots__texte')!.innerHTML = '';
      if (elMots && C) {
        elMots.classList.remove('est-signe');
        elMots.querySelector('.mots__texte')!.innerHTML = C.html;
        elMots.querySelector('.mots__auteur')!.textContent = C.auteur;
        motsEls = C.mots.map(() => []);
        elMots.querySelectorAll<HTMLElement>('.m').forEach((m) => motsEls[Number(m.dataset.k)]?.push(m));
      }
      // Portraits : tous les ovales sont posés d'emblée (invisibles), si bien que la rangée garde
      // sa taille ; chacun paraît à son nom (majSurimpressions).
      const P = x?.portraits;
      portraitsEls = [];
      portraitsDits = -1;
      if (elPortraits) {
        elPortraits.replaceChildren();
        elPortraits.classList.toggle('est-seul', P?.gens.length === 1);
        for (const g of P?.gens ?? []) {
          const fig = document.createElement('figure');
          fig.className = 'portrait';
          const ovale = document.createElement('span');
          ovale.className = 'portrait__ovale';
          const img = document.createElement('img');
          img.src = g.src;
          img.alt = '';
          img.decoding = 'async';
          ovale.append(img);
          const leg = document.createElement('figcaption');
          const nom = document.createElement('span'), sep = document.createElement('span'), dates = document.createElement('span');
          nom.className = 'portrait__nom'; nom.textContent = g.nom;
          sep.className = 'portrait__sep'; sep.textContent = ' · ';
          dates.className = 'portrait__dates'; dates.textContent = g.dates;
          leg.append(nom, sep, dates);
          fig.append(ovale, leg);
          elPortraits.append(fig);
          portraitsEls.push(fig);
        }
        taillePortraits();
      }
      tailleChiffre();
    }
    /** Surimpressions possibles : lecture lancée, ni carton ni segment après la voix. */
    const surimpressionsActives = () => lance && !enCarton && !enSuite && !suiteFini;
    function majSurimpressions(t: number) {
      const x = D.diapos[i], actif = surimpressionsActives();
      const L = x.lieu, C = x.citation, P = x.portraits, O = x.objet, M = x.manuscrit;
      if (elObjet && O) {
        const vu = actif && t >= O.a && t < O.b;
        if (vu !== elObjet.classList.contains('est-visible')) { elObjet.classList.toggle('est-visible', vu); lecteur.classList.toggle('avec-objet', vu); }
      }
      if (elManuscrit && M) {
        const vu = actif && t >= M.a && t < M.b;
        if (vu !== elManuscrit.classList.contains('est-visible')) { elManuscrit.classList.toggle('est-visible', vu); lecteur.classList.toggle('avec-manuscrit', vu); }
        majManuscrit(t);
      }
      const CH = x.chiffre, DR = x.date;
      if (elChiffre && CH) {
        const vu = actif && t >= CH.a && t < CH.b;
        if (vu !== elChiffre.classList.contains('est-visible')) { elChiffre.classList.toggle('est-visible', vu); lecteur.classList.toggle('avec-chiffre', vu); }
        majChiffre(t);
      }
      if (elDate && DR) {
        const vu = actif && t >= DR.a && t < DR.b;
        if (vu !== elDate.classList.contains('est-visible')) { elDate.classList.toggle('est-visible', vu); lecteur.classList.toggle('avec-date', vu); }
      }
      // Deux surimpressions au plus (spec 12) : la frise du temps cède dès que deux autres sont là.
      if ([elLieu, elPortraits, elObjet, elManuscrit, elMots, elChiffre, elDate].filter((e) => e?.classList.contains('est-visible')).length >= 2) cacherFrise();
      if (elLieu && L) {
        const vu = actif && t >= L.a && t < L.b;
        if (vu !== elLieu.classList.contains('est-visible')) { elLieu.classList.toggle('est-visible', vu); lecteur.classList.toggle('avec-lieu', vu); }
      }
      if (elPortraits && P) {
        const vu = actif && t >= P.a && t < P.b;
        if (vu !== elPortraits.classList.contains('est-visible')) { elPortraits.classList.toggle('est-visible', vu); lecteur.classList.toggle('avec-portraits', vu); }
        // Chaque ovale paraît quand la voix attaque le nom (le premier dès l'entrée de la rangée) ;
        // les précédents restent.
        let n = 0;
        while (n < P.gens.length && P.gens[n].t <= t + 0.06) n++;
        n = Math.max(1, n);
        if (n !== portraitsDits) {
          portraitsEls.forEach((e, k) => e.classList.toggle('est-dit', k < n));
          portraitsDits = n;
        }
        // Deux surimpressions au plus (spec 12) : la frise du temps cède quand médaillon de lieu et
        // portraits sont là ensemble (la citation, elle, la masque déjà).
        if (vu && elLieu?.classList.contains('est-visible')) cacherFrise();
      }
      if (!elMots || !C) return;
      const vu = actif && t >= C.a && t < C.b;
      if (vu !== elMots.classList.contains('est-visible')) {
        elMots.classList.toggle('est-visible', vu);
        lecteur.classList.toggle('avec-citation', vu);
        if (vu) cacherFrise();
      }
      // Mots dits (le mot paraît quand la voix l'attaque) ; mouvement réduit : la citation entière.
      let n = 0;
      if (mouvementReduit.matches) n = t >= C.a ? C.mots.length : 0;
      else while (n < C.mots.length && C.mots[n] <= t + 0.06) n++;
      if (n !== motsDits) {
        motsEls.forEach((els, k) => els.forEach((m) => m.classList.toggle('est-dit', k < n)));
        motsDits = n;
      }
      elMots.classList.toggle('est-signe', t >= C.fin || (mouvementReduit.matches && n > 0));
    }

    /** Instant courant dans tout le diaporama (cartons, voix, pauses, intermèdes). */
    function tempsCourant() {
      if (!lance) return debuts[i];
      if (enCarton) return debuts[i] + Math.min(chronoCarton.t, prelude[i]);
      const base = debuts[i] + prelude[i];
      if (enSuite || suiteFini) {
        const c = suiteFini ? suiteEtPause[i] : Math.min(sa.currentTime || 0, suiteEtPause[i]);
        return base + voixEtPause[i] + c;
      }
      return base + Math.min(instant(), voixEtPause[i]);
    }

    function majTemps() {
      const t = tempsCourant();
      elEcoule.textContent = mmss(Math.min(total, t));
      bornes.forEach((b, k) => {
        const p = Math.max(0, Math.min(1, (t - b.t0) / (b.t1 - b.t0)));
        (segments[k].firstElementChild as HTMLElement).style.transform = `scaleX(${p})`;
        segments[k].classList.toggle('est-courant', i >= b.de && i < b.fin);
      });
    }

    // Images à venir décodées d'avance (gardées en vie, sinon le décodage est perdu) : le fondu
    // d'entrée ne commence pas par un décodage de la grande image, qui ferait sauter des images.
    const decodees = new Map<string, HTMLImageElement>();
    function precharger(k: number) {
      for (const j of [k, k + 1, k + 2]) {
        const x = D.diapos[j];
        if (!x) continue;
        if (!decodees.has(x.img)) {
          const im = new Image();
          im.src = x.img;
          im.decode().catch(() => {});
          decodees.set(x.img, im);
          for (const cle of decodees.keys()) if (decodees.size > 4) decodees.delete(cle);
        }
        if (x.lieu?.fond === 'paris' && elPlan?.dataset.src) new Image().src = elPlan.dataset.src;
        for (const g of x.portraits?.gens ?? []) new Image().src = g.src;
        if (x.objet) new Image().src = x.objet.src;
        if (x.manuscrit) new Image().src = x.manuscrit.src;
        if (j > k && x.audio) { const a = new Audio(); a.preload = 'auto'; a.src = x.audio; }
        if (x.suite && j <= k + 1) { const a = new Audio(); a.preload = 'auto'; a.src = x.suite.src; }
      }
    }

    // --- Carton de changement d'acte ---------------------------------------------------------
    function lancerCarton() {
      if (!enCarton || chronoCarton.tourne) return;
      chronoCarton.relancer();
      programmerCarton();
      animer();
    }
    /** Volets possibles (sinon, fondu court à la fin du carton). */
    const voletsPossibles = () => !mouvementReduit.matches && typeof elCarton.animate === 'function';
    /** Prochaine échéance du carton qui tourne : début de l'ouverture, puis fin du carton. */
    function programmerCarton() {
      arreterMinuterie();
      if (!enCarton || !chronoCarton.tourne) return;
      const t = chronoCarton.t, debut = prelude[i] - OUVERTURE;
      if (!ouvre && voletsPossibles()) {
        if (t < debut) { minuterie = window.setTimeout(commencerOuverture, (debut - t) * 1000); return; }
        return commencerOuverture();
      }
      minuterie = window.setTimeout(finCarton, Math.max(0, prelude[i] - t) * 1000);
    }
    /** Début de l'ouverture (dernières secondes du carton) : l'image est posée sous le carton,
     *  cadrée sur son détail d'ouverture s'il y en a un ; les volets s'écartent une fois l'image
     *  décodée, au rythme de l'horloge du carton. */
    function commencerOuverture() {
      if (!enCarton || ouvre) return;
      ouvre = true;
      programmerCarton();
      entrerImage(true, true);
      chronoEntree.zero(); // l'entrée suit l'horloge du carton (cf. rendre)
      // Sans `will-change` pendant l'ouverture, Chrome rastérise l'image à l'échelle où elle est
      // posée (le zoom le plus fort) au lieu de garder celle de l'image d'avant ; il est rétabli
      // au début du recul (`finCarton`), qui ne fait que dézoomer.
      calques[visible].querySelector('img')!.style.willChange = 'auto';
      const k = i;
      quandPrete(calques[visible].querySelector('img')!, () => {
        if (k !== i || !enCarton || !ouvre) return; // saut ou carton passé entre-temps
        ouvrirCarton();
        rendre();
        animer();
      });
    }
    /** Passer le carton (→, clic, Entrée) : l'ouverture se joue tout de suite (l'horloge du
     *  carton saute à son début, et tourne même en pause), la voix démarre à sa fin. Passé
     *  pendant l'ouverture : le carton finit aussitôt. */
    function passerCarton() {
      if (!enCarton) return;
      if (ouvre || !voletsPossibles()) return finCarton();
      chronoCarton.figer();
      chronoCarton.ecoule = Math.max(chronoCarton.ecoule, prelude[i] - OUVERTURE);
      chronoCarton.relancer();
      programmerCarton();
      animer();
    }
    /** Fin du carton (fin de l'ouverture, ou passé) : la voix démarre si la lecture est en cours. */
    function retablirWillChange() { for (const c of calques) c.querySelector('img')!.style.willChange = ''; }
    function finCarton() {
      if (!enCarton) return;
      retablirWillChange();
      arreterMinuterie();
      const ouvert = ouvre, e = tempsOuverture();
      enCarton = false;
      ouvre = false;
      chronoCarton.zero();
      elCarton.setAttribute('aria-hidden', 'true');
      if (ouvert) {
        // L'image est déjà là : la caméra passe de l'horloge du carton à celle de l'audio sans
        // rupture (instant 0). Ouverture écourtée : l'entrée finit sur son horloge propre.
        finirVolets();
        lecteur.classList.remove('en-carton');
        chronoEntree.zero();
        chronoEntree.ecoule = e;
        chronoEntree.relancer();
        animer();
        assurerFin();
        if (joue) demarrer();
        rendre();
        majTemps();
        musique();
        return;
      }
      // Sans volets (prefers-reduced-motion) : l'image est posée sous le carton, qui s'efface
      // une fois l'image décodée.
      entrerImage(true, true);
      const k = i;
      quandPrete(calques[visible].querySelector('img')!, () => {
        if (k !== i || enCarton) return; // saut entre-temps
        ouvrirCarton();
        chronoEntree.zero();
        chronoEntree.relancer();
        animer();
        assurerFin();
        if (joue) demarrer();
        majTemps();
        musique();
      });
    }

    // Volets (spec 12, « Sortie du carton d'acte en deux volets ») : deux copies du carton,
    // coupées à mi-hauteur par clip-path, s'écartent vers le haut et vers le bas et découvrent
    // l'image déjà posée et décodée dessous. Le vrai carton disparaît d'un coup sous les volets
    // (son fondu se verrait entre eux). Animation en transform seul, tenue en pause et placée à
    // chaque image sur l'horloge du carton (figée en pause, juste après un saut).
    const COURBE_VOLETS = 'cubic-bezier(0.45, 0, 0.2, 1)'; // départ doux, longue fin apaisée
    let volets: { els: HTMLElement[]; anims: Animation[] } | null = null;
    function finirVolets() {
      if (!volets) return;
      for (const a of volets.anims) a.cancel();
      for (const el of volets.els) el.remove();
      volets = null;
    }
    function majVolets() {
      if (!volets || !enCarton) return;
      const ms = tempsOuverture() * 1000;
      for (const a of volets.anims) a.currentTime = ms;
    }
    function ouvrirCarton() {
      finirVolets();
      if (!voletsPossibles()) {
        lecteur.classList.remove('en-carton'); // fondu court (CSS)
        return;
      }
      const els = (['haut', 'bas'] as const).map((cote) => {
        const v = elCarton.cloneNode(true) as HTMLElement;
        v.classList.add('lecteur__volet', `lecteur__volet--${cote}`);
        v.removeAttribute('data-action');
        v.removeAttribute('title');
        v.setAttribute('aria-hidden', 'true');
        for (const n of v.querySelectorAll('[id]')) n.removeAttribute('id');
        return v;
      });
      elCarton.after(...els);
      elCarton.style.transition = 'none';
      lecteur.classList.remove('en-carton');
      void elCarton.offsetWidth;
      elCarton.style.transition = '';
      const anims = els.map((v, k) => v.animate(
        [{ transform: 'translate3d(0, 0, 0)' }, { transform: `translate3d(0, ${k ? 51 : -51}%, 0)` }],
        { duration: OUVERTURE * 1000, easing: COURBE_VOLETS, fill: 'forwards' }));
      for (const a of anims) a.pause();
      volets = { els, anims };
      majVolets();
    }

    // --- Lecture -----------------------------------------------------------------------------
    function arreterMinuterie() { clearTimeout(minuterie); minuterie = 0; }

    /** Cartouche, sous-titre puis image de la diapositive courante (marges mesurées entre-temps). */
    function entrerImage(fondu: boolean, couvert = false) {
      const x = D.diapos[i];
      changerCartouche(x);
      changerSousTitre(x.texte);
      chargerSurimpressions(x);
      mesurerMarges();
      montrerImage(x, fondu, couvert);
    }

    function afficher(k: number, fondu = true) {
      finirVolets();
      retablirWillChange();
      // Écran couvrant l'image avant le changement : carton d'acte, carte ou panneau d'un segment.
      // (Pendant l'ouverture des volets, l'image est déjà découverte : fondu enchaîné ordinaire.)
      const sousCarton = enCarton && !ouvre;
      const carte = ov && (enSuite || suiteFini) ? ov : null;
      arreterMinuterie();
      arreterSuite(Boolean(carte));
      /** Retire la carte (ou le panneau) gardée pendant le changement, sauf si elle a resservi. */
      const leverCarte = () => {
        if (carte && carte !== ov) { carte.classList.remove('est-visible'); carte.setAttribute('aria-hidden', 'true'); }
      };
      i = Math.max(0, Math.min(N - 1, k));
      const x = D.diapos[i];
      const a = D.actes[acteDe[i]];
      // Date précédente : celle de la dernière diapositive affichée (sauts manuels compris).
      const datePrec = derniere >= 0 ? D.diapos[derniere].date : null;
      if (lance) derniere = i;
      elActeTitre.textContent = a.titre;
      elActeDates.textContent = a.dates;
      elN.textContent = String(x.n);
      audio.pause();
      if (x.audio) audio.src = x.audio; else audio.removeAttribute('src');
      ecouleSansVoix = 0; debutSansVoix = 0;
      if (lance) ecrire(CLE_POS, x.cle);
      precharger(i);
      chronoCarton.zero();
      ouvre = false;
      if (lance && prelude[i]) {
        // Carton d'acte : il couvre la scène ; l'image d'avant reste figée dessous.
        enCarton = true;
        enEntree = false;
        chronoEntree.zero();
        // Titre écrit lettre par lettre (mots insécables : pas de coupure au milieu d'un mot).
        let n = 0;
        elCartonTitre.replaceChildren(...a.titre.split(/(\s+)/).map((m) => {
          if (/^\s+$/.test(m)) return document.createTextNode(m);
          const mot = document.createElement('span');
          mot.className = 'mot';
          for (const c of m) { const l = document.createElement('span'); l.textContent = c; l.style.setProperty('--i', String(n++)); mot.append(l); }
          return mot;
        }));
        elCartonTitre.setAttribute('aria-label', a.titre);
        elCarton.style.setProperty('--lettres', String(n));
        elCartonDates.textContent = a.dates;
        elCarton.setAttribute('aria-hidden', 'false');
        cacherFrise();
        chargerSurimpressions(null);
        // Frise du carton : de la date précédente (ou du début de la période) au début de l'acte.
        if (friseCarton && x.date) glisser(friseCarton, datePrec ?? ORIGINE, x.date, acteDe[i]);
        // Retirer puis remettre la classe relance l'animation des textes du carton.
        lecteur.classList.remove('en-carton');
        void elCarton.offsetWidth;
        lecteur.classList.add('en-carton');
        // La carte d'un segment reste le temps que le carton monte (pas d'éclair de l'image dessous).
        if (carte) window.setTimeout(leverCarte, 500);
        majTemps();
        if (joue) demarrer();
        musique();
        return;
      }
      enCarton = false;
      elCarton.setAttribute('aria-hidden', 'true');
      const couvert = sousCarton || Boolean(carte);
      entrerImage(fondu, couvert);
      if (couvert && fondu) {
        // L'écran couvrant ne se lève qu'une fois la nouvelle image décodée, posée dessous.
        const j = i;
        quandPrete(calques[visible].querySelector('img')!, () => {
          leverCarte();
          if (j === i && !enCarton) lecteur.classList.remove('en-carton');
        });
      } else {
        leverCarte();
        lecteur.classList.remove('en-carton');
      }
      // Entre deux cartons : la frise en surimpression si la date fait un saut notable.
      if (lance && datePrec && x.date && sautNotable(datePrec, x.date)) montrerFrise(datePrec, x.date, acteDe[i]);
      else cacherFrise();
      majTemps();
      if (joue) demarrer();
      musique();
    }

    function demarrer() {
      const x = D.diapos[i];
      joue = true;
      lecteur.classList.add('en-lecture');
      btnLecture.setAttribute('aria-label', 'Pause');
      animer();
      musique();
      if (enCarton) return lancerCarton();
      if (enSuite) {
        sa.play().catch((e) => { if (e?.name !== 'AbortError') finSuite(); });
        return;
      }
      if (suiteFini) {
        minuterie = window.setTimeout(suivantAuto, D.pause * 1000);
        return;
      }
      if (x.audio) {
        if (audio.ended) return finDeVoix();
        if (audio.error) return finDeVoix();
        // AbortError : la source a changé avant le début de la lecture (saut rapide).
        audio.play().catch((e) => { if (e?.name !== 'AbortError') pause(); });
      } else {
        debutSansVoix = performance.now();
        minuterie = window.setTimeout(suivantAuto, (voixEtPause[i] - ecouleSansVoix) * 1000);
      }
    }
    function pause() {
      joue = false;
      lecteur.classList.remove('en-lecture');
      btnLecture.setAttribute('aria-label', 'Lecture');
      audio.pause();
      sa.pause();
      if (minuterie && debutSansVoix && !enCarton) ecouleSansVoix += (performance.now() - debutSansVoix) / 1000;
      debutSansVoix = 0;
      arreterMinuterie();
      chronoCarton.figer();
      if (raf && !(enEntree && chronoEntree.tourne)) { cancelAnimationFrame(raf); raf = 0; }
      rendre();
      majTemps();
      montrerControles();
      musique();
    }
    function finDeVoix() {
      if (!joue || enCarton || enSuite) return;
      arreterMinuterie();
      minuterie = window.setTimeout(apresVoix, D.diapos[i].pause * 1000);
    }
    /** Après la voix et sa pause : l'intermède chanté s'il y en a un, sinon la suite. */
    function apresVoix() {
      minuterie = 0;
      const c = D.diapos[i].suite;
      if (c && !suiteFini) return lancerSuite();
      suivantAuto();
    }

    // --- Segments après la voix : intermède chanté, lecture d'époque, épisode -----------------------
    // La voix s'est tue. Intermède : le chant est joué au premier plan sur l'image du moment (la
    // musique de fond se tait), avec son cartouche et ses paroles façon clip au centre de l'image
    // voilée (majParoles). Lecture : la carte
    // de citation couvre l'image (floue, voilée, immobile) et le texte y apparaît mot par mot au
    // rythme de la voix de lecture. Épisode : un panneau couvre la scène et ses visuels suivent la narration. L'horloge
    // est `sa.currentTime` (pause, reprise et sauts justes). → passe le segment.
    const cartes = new Map([...racine.querySelectorAll<HTMLElement>('.citation--lecteur')].map((e) => [e.dataset.lecture!, e]));
    const panneaux = new Map([...racine.querySelectorAll<HTMLElement>('.episode--lecteur')].map((e) => [e.dataset.episode!, e]));
    let ov: HTMLElement | null = null; // carte ou panneau affiché
    const CLASSES_SUITE = { chant: 'en-chant', lecture: 'en-citation', episode: 'en-episode' } as const;
    function lancerSuite() {
      const c = D.diapos[i].suite!;
      enSuite = true;
      suiteFini = false;
      lecteur.classList.add(CLASSES_SUITE[c.type]);
      if (sa.getAttribute('src') !== c.src) sa.src = c.src;
      try { sa.currentTime = 0; } catch { /* métadonnées pas encore chargées */ }
      if (c.type === 'chant') {
        changerCartouche({ legende: c.legende } as Diapo);
        chargerSurimpressions(null);
        // Intermède musical (œuvre instrumentale) : pas de paroles, sous-titre masqué.
        lecteur.classList.toggle('en-instrumental', c.instrumental);
        // Chant : paroles façon clip au centre de l'image voilée, sans sous-titre ni frise.
        if (!c.instrumental && c.paroles.length) {
          preparerClip(c);
          lecteur.classList.add('en-clip');
          changerSousTitre('');
          cacherFrise();
        }
      } else {
        ov = (c.type === 'lecture' ? cartes : panneaux).get(c.id) ?? null;
        if (ov) { preparer(ov, c); ov.classList.add('est-visible'); ov.setAttribute('aria-hidden', 'false'); }
        changerSousTitre('');
        chargerSurimpressions(null);
        // Pas de frise en surimpression : la carte ou le panneau en tient lieu ; la date du
        // segment (champ `date`) reste celle de son récit, et la frise reprend à la diapositive
        // suivante, comparée à celle-ci.
        cacherFrise();
      }
      majSuite();
      musique();
      if (joue) sa.play().catch((e) => { if (e?.name !== 'AbortError') finSuite(); });
      animer();
      majTemps();
    }
    /** Fin naturelle du segment (ou erreur) : pause, puis diapositive suivante. La carte ou le
     *  panneau reste, complet, jusqu'au fondu vers l'image suivante. */
    function finSuite() {
      if (!enSuite) return;
      enSuite = false;
      suiteFini = true;
      lecteur.classList.remove('en-chant', 'en-instrumental', 'en-clip');
      majSuite();
      musique();
      majTemps();
      if (joue) { arreterMinuterie(); minuterie = window.setTimeout(suivantAuto, D.pause * 1000); }
    }
    /** Sortie du segment par un saut (le cartouche et le sous-titre sont alors remplacés). */
    function arreterSuite(garderCarte = false) {
      if (!enSuite && !suiteFini) return;
      enSuite = false;
      suiteFini = false;
      sa.pause();
      lecteur.classList.remove('en-chant', 'en-instrumental', 'en-clip', 'en-citation', 'en-episode');
      // `garderCarte` : la carte reste affichée jusqu'à ce que l'image suivante soit prête (afficher).
      if (ov && !garderCarte) { ov.classList.remove('est-visible'); ov.setAttribute('aria-hidden', 'true'); }
      ov = null;
    }
    /** Mise à jour du segment en cours d'après l'horloge de son audio. */
    function majSuite() {
      const c = D.diapos[i].suite;
      if (!c || (!enSuite && !suiteFini)) return;
      const t = suiteFini ? c.duree + 2 : sa.currentTime || 0;
      if (c.type === 'chant') { if (enSuite) majParoles(); return; }
      if (!ov) return;
      if (c.type === 'lecture') majCitation(ov, c, t);
      else majEpisode(ov, c, t);
    }
    // --- Paroles des chants façon clip (spec 12, 2026-10-08) -------------------------------------
    // Chaque vers est posé d'avance au centre de l'image (mots invisibles, place réservée : rien ne
    // bouge quand ils paraissent) ; le vers en cours est visible, ses mots paraissent à leur instant
    // chanté. L'affichage dérive de l'horloge lissée de l'intermède : pause, reprise, sauts justes.
    // Sans calage au mot (repli) ou en mouvement réduit, le vers entier paraît à son début.
    const AVANCE_CLIP = 0.08; // s : le mot paraît un rien avant d'être chanté (attaque de la note)
    let clipVers: HTMLElement[][] = [], clipEls: HTMLElement[] = [], vers = -2, versMots = -1;
    function preparerClip(c: SuiteChant) {
      clipEls = []; clipVers = [];
      for (const [, v] of c.paroles) {
        const p = document.createElement('p');
        p.className = 'clip__vers';
        const mots: HTMLElement[] = [];
        const bornes = motsLus(v);
        bornes.forEach((b, k) => {
          // Un mot emporte la ponctuation qui le suit (« roi ! ») ; l'espace reste entre les mots.
          const bout = v.slice(k ? b.d : 0, k + 1 < bornes.length ? bornes[k + 1].d : v.length);
          const span = document.createElement('span');
          span.className = 'clip__mot';
          span.textContent = bout.trimEnd();
          p.append(span, bout.slice(span.textContent.length));
          mots.push(span);
        });
        elClipTexte.append(p);
        clipEls.push(p);
        clipVers.push(mots);
      }
      vers = -2; versMots = -1;
    }
    function majParoles() {
      const c = D.diapos[i].suite;
      if (!enSuite || !c || c.type !== 'chant' || !clipEls.length) return;
      const t = horlogeSuite.lire(sa) + AVANCE_CLIP;
      let k = -1;
      while (k + 1 < c.paroles.length && c.paroles[k + 1][0] <= t) k++;
      if (k !== vers) {
        clipEls.forEach((e, j) => e.classList.toggle('est-courant', j === k));
        vers = k; versMots = -1;
      }
      if (k < 0) return;
      const mots = c.paroles[k][2];
      let n = clipVers[k].length;
      if (mots && !mouvementReduit.matches) { n = 0; while (n < mots.length && mots[n] <= t) n++; }
      if (n === versMots) return;
      clipVers[k].forEach((e, j) => e.classList.toggle('est-chante', j < n));
      versMots = n;
    }

    // Éléments de chaque carte et panneau, relevés une fois (à leur premier affichage).
    interface Anim { el: Element & ElementCSSInlineStyle; t: number; d: number; p: number }
    interface EtatSegment {
      mots?: HTMLElement[][]; zone?: HTMLElement; defile?: HTMLElement; lu?: number; cour?: number; y?: number; hz?: number;
      ev?: { el: HTMLElement; t: number }[]; anims?: Anim[]; actif?: number; phrase?: number;
      traces?: { el: SVGRectElement; l: number; trace: [number, number][]; x: number }[];
      docs?: { el: HTMLElement; page: HTMLElement; l: number; h: number; vues: number[][] }[];
    }
    const etats = new WeakMap<HTMLElement, EtatSegment>();
    function preparer(el: HTMLElement, c: SuiteLecture | SuiteEpisode) {
      let e = etats.get(el);
      if (!e) {
        e = {};
        if (c.type === 'lecture') {
          e.zone = el.querySelector<HTMLElement>('.citation__texte')!;
          e.defile = el.querySelector<HTMLElement>('.citation__defile')!;
          // Éléments de chaque mot (rang `data-k` ; la ponctuation et les coupures suivent un mot).
          e.mots = c.mots.map(() => []);
          el.querySelectorAll<HTMLElement>('[data-k]').forEach((x) => e!.mots![Number(x.dataset.k)]?.push(x));
          // Fond flou : l'image du moment, chargée seulement à la première lecture.
          const f = el.querySelector<HTMLElement>('.citation__fond[data-fond]');
          if (f?.dataset.fond && !f.style.backgroundImage) f.style.backgroundImage = `url("${f.dataset.fond}")`;
        } else {
          e.ev = [...el.querySelectorAll<HTMLElement>('.ev')].map((x) => ({ el: x, t: Number(x.dataset.t) }));
          e.anims = [...el.querySelectorAll<HTMLElement>('.anim')].map((x) => ({ el: x, t: Number(x.dataset.t), d: Number(x.dataset.d || 1), p: -1 }));
          e.traces = [...el.querySelectorAll<SVGRectElement>('[data-trace]')].map((x) => ({ el: x, l: Number(x.dataset.l), trace: JSON.parse(x.dataset.trace!), x: -1 }));
          e.docs = [...el.querySelectorAll<HTMLElement>('.ev-doc[data-vues]')].map((x) => ({
            el: x, page: x.querySelector<HTMLElement>('.ev-doc__page')!, l: Number(x.dataset.l), h: Number(x.dataset.h), vues: JSON.parse(x.dataset.vues!) }));
        }
        etats.set(el, e);
      }
      // Remise à zéro : tout sera recalculé au premier rendu.
      e.lu = -1; e.cour = -1; e.y = -1; e.hz = -1; e.actif = -1; e.phrase = -2;
      e.mots?.forEach((l) => l.forEach((x) => x.classList.remove('est-lu', 'est-courant')));
      if (e.defile) e.defile.style.transform = '';
      e.anims?.forEach((a) => (a.p = -1));
      e.traces?.forEach((x) => (x.x = -1));
      if (e.zone) e.zone.scrollTop = 0;
    }

    /** Lecture : le texte apparaît mot par mot au rythme exact de la voix (instants de
     *  l'alignement forcé) : le mot en cours en noir, les mots lus en gris foncé, les suivants
     *  invisibles mais à leur place. Mouvement réduit : par phrase. Le texte qui dépasse la place
     *  défile en douceur pour garder la ligne en cours dans le bas de la zone. */
    const AVANCE_MOT = 0.06; // s : le mot paraît au moment où la voix l'attaque
    function majCitation(el: HTMLElement, c: SuiteLecture, t: number) {
      const e = etats.get(el)!;
      const N = c.mots.length;
      let lu = 0, cour = 0; // mots [0, lu) lus, [lu, cour) en cours, la suite invisible
      if (suiteFini) { lu = N; cour = N; }
      else if (mouvementReduit.matches) {
        for (const [t0, k0, k1] of c.phrases) if (t0 <= t + AVANCE_MOT) { lu = k0; cour = k1; }
      } else {
        while (cour < N && c.mots[cour] <= t + AVANCE_MOT) cour++;
        lu = Math.max(0, cour - 1);
      }
      if (lu !== e.lu || cour !== e.cour) {
        e.mots!.forEach((els, k) => {
          const etat = k < lu ? 1 : k < cour ? 2 : 0;
          for (const x of els) {
            x.classList.toggle('est-lu', etat === 1);
            x.classList.toggle('est-courant', etat === 2);
          }
        });
        e.lu = lu; e.cour = cour;
      }
      // Défilement : recalculé aussi quand la zone change de taille (plein écran, rotation).
      const z = e.zone!, hz = z.clientHeight;
      const repere = e.mots![Math.max(0, Math.min(N - 1, cour - 1))]?.[0];
      const H = e.defile!.offsetHeight;
      let y = 0;
      if (repere && H > hz + 1 && cour > 0) {
        const bas = repere.offsetTop + repere.offsetHeight;
        y = Math.max(0, Math.min(H - hz, bas - hz * 0.74));
        // Dépassement infime (marge, jambages) : on ne bouge pas pour si peu.
        if (y < repere.offsetHeight * 0.4) y = 0;
      }
      y = Math.round(y);
      if (y !== e.y || hz !== e.hz) {
        e.defile!.style.transform = y ? `translateY(${-y}px)` : '';
        z.classList.toggle('deborde', y > 0);
        e.y = y; e.hz = hz;
      }
    }

    /** Épisode : visuel actif, éléments animés (--p), tracés, zoom du document, sous-titre. */
    const AVANCE_EPISODE = 0.3; // s : l'œil devance un peu l'oreille
    function majEpisode(el: HTMLElement, c: SuiteEpisode, t: number) {
      const e = etats.get(el)!;
      const reduit = mouvementReduit.matches;
      const ta = t + AVANCE_EPISODE;
      let k = 0;
      e.ev!.forEach((v, j) => { if (v.t <= ta) k = j; });
      if (k !== e.actif) { e.ev!.forEach((v, j) => v.el.classList.toggle('est-actif', j === k)); e.actif = k; }
      for (const a of e.anims!) {
        const p = reduit ? (ta >= a.t ? 1 : 0) : adoucir((ta - a.t) / a.d);
        if (Math.abs(p - a.p) > 0.002) { a.el.style.setProperty('--p', p.toFixed(3)); a.p = p; }
      }
      for (const x of e.traces!) {
        const tr = x.trace;
        let f = 0;
        if (ta >= tr[0][0]) {
          let j = 0;
          while (j + 1 < tr.length && tr[j + 1][0] <= ta) j++;
          f = j + 1 < tr.length && !reduit ? tr[j][1] + (tr[j + 1][1] - tr[j][1]) * ((ta - tr[j][0]) / Math.max(0.001, tr[j + 1][0] - tr[j][0])) : tr[j][1];
        }
        if (Math.abs(f - x.x) > 0.0005) { x.el.setAttribute('width', (f * x.l).toFixed(1)); x.x = f; }
      }
      for (const doc of e.docs!) majDocument(doc, ta, reduit);
      // Sous-titre : la phrase en cours.
      let ph = -1;
      c.phrases.forEach(([t0], j) => { if (t0 <= t + 0.1) ph = j; });
      if (suiteFini) ph = -1;
      if (ph !== e.phrase) { e.phrase = ph; changerSousTitre(ph >= 0 ? c.phrases[ph][2] : ''); }
    }
    /** Document : la page entière, puis un zoom doux (1,4 s) sur chaque ligne lue. */
    function majDocument(doc: { el: HTMLElement; page: HTMLElement; l: number; h: number; vues: number[][] }, ta: number, reduit: boolean) {
      const W = doc.el.clientWidth, H = doc.el.clientHeight;
      if (!W || !H) return;
      const s0 = Math.min(W / doc.l, H / doc.h);
      const pw = doc.l * s0, ph = doc.h * s0;
      const entiere: Rect = [0, 0, 1, 1];
      let k = -1;
      doc.vues.forEach((v, j) => { if (v[0] <= ta + 0.4) k = j; });
      let r = entiere;
      if (k >= 0) {
        const de = (k > 0 ? doc.vues[k - 1].slice(1) : entiere) as Rect;
        const a = doc.vues[k].slice(1) as Rect;
        r = reduit ? a : melanger(de, a, adoucir((ta + 0.4 - doc.vues[k][0]) / 1.4));
      }
      const rw = (r[2] - r[0]) * pw, rh = (r[3] - r[1]) * ph;
      const z = Math.min(W / rw, H / rh);
      const tx = W / 2 - z * ((r[0] + r[2]) / 2) * pw, ty = H / 2 - z * ((r[1] + r[3]) / 2) * ph;
      doc.page.style.width = `${pw.toFixed(1)}px`;
      doc.page.style.height = `${ph.toFixed(1)}px`;
      doc.page.style.transform = `translate(${tx.toFixed(1)}px, ${ty.toFixed(1)}px) scale(${z.toFixed(4)})`;
    }
    /** Saut direct vers le segment d'une diapositive (clic dans la barre de progression) : la
     *  diapositive s'affiche, sans sa voix ni son carton, puis le segment commence. */
    function allerSuite(j: number) {
      aller(j);
      if (enCarton) {
        arreterMinuterie();
        enCarton = false;
        ouvre = false;
        finirVolets();
        chronoCarton.zero();
        lecteur.classList.remove('en-carton');
        elCarton.setAttribute('aria-hidden', 'true');
        entrerImage(false);
      }
      arreterMinuterie();
      audio.pause();
      try { audio.currentTime = Math.max(0, D.diapos[i].duree - 0.05); } catch { /* pas encore chargé */ }
      lancerSuite();
    }
    function suivantAuto() {
      minuterie = 0;
      if (i >= N - 1) { pause(); ecrire(CLE_POS, null); return; }
      afficher(i + 1);
    }
    function lancer(k = 0) {
      deverrouillerAudio();
      lance = true;
      depart.hidden = true;
      joue = true;
      afficher(k, k !== i);
      estomperPlusTard(elLegende);
      btnLecture.focus({ preventScroll: true });
      // Le lecteur entier à l'écran, s'il dépasse.
      const r = lecteur.getBoundingClientRect();
      if (r.top < 0 || r.bottom > window.innerHeight) lecteur.scrollIntoView({ behavior: mouvementReduit.matches ? 'auto' : 'smooth', block: 'start' });
    }
    function basculer() {
      deverrouillerAudio();
      if (!lance) return lancer(i);
      joue ? pause() : demarrer();
    }
    function aller(k: number) {
      k = Math.max(0, Math.min(N - 1, k));
      if (!lance) { lance = true; depart.hidden = true; }
      if (k === i && !prelude[i] && !enCarton) {
        // Retour au début de la diapositive courante (sans carton).
        arreterMinuterie();
        if (enSuite || suiteFini) {
          arreterSuite();
          changerCartouche(D.diapos[i]);
          changerSousTitre(D.diapos[i].texte);
        }
        audio.currentTime = 0; ecouleSansVoix = 0; debutSansVoix = 0;
        rendre(0);
        musique();
        if (joue) demarrer();
        majTemps();
        return;
      }
      afficher(k);
    }
    /** « Suivant » : passe le carton s'il est affiché, sinon diapositive suivante. */
    function suivant() {
      if (enCarton) return passerCarton();
      aller(i + 1);
    }

    audio.addEventListener('ended', finDeVoix);
    for (const ev of ['play', 'playing', 'pause', 'ended', 'waiting']) audio.addEventListener(ev, () => appliquerEtat());
    sa.addEventListener('ended', finSuite);
    for (const ev of ['play', 'playing', 'pause', 'ended', 'waiting']) sa.addEventListener(ev, () => appliquerEtat());
    sa.addEventListener('error', () => { if (enSuite && sa.getAttribute('src')) finSuite(); });
    sa.addEventListener('timeupdate', () => { majSuite(); majTemps(); });
    sa.addEventListener('seeked', () => majSuite());
    // timeupdate (et seeked) recalent aussi la caméra : utile après un saut en pause, et quand
    // requestAnimationFrame est suspendu (onglet en arrière-plan).
    audio.addEventListener('timeupdate', () => { if (!enCarton) { majTemps(); rendre(); } });
    audio.addEventListener('seeked', () => rendre());
    audio.addEventListener('error', () => { if (joue && !enCarton && audio.getAttribute('src')) finDeVoix(); });

    // --- Musique de fond (Web Audio API) ---------------------------------------------------------
    // Deux lecteurs <audio> (fondu enchaîné entre deux pistes) passent chacun par un gain de
    // fondu, puis par un gain commun de « ducking » réglé selon l'état du diaporama (voix,
    // respiration, carton, intermède, arrêt) et le volume choisi. L'AudioContext est créé et
    // débloqué au premier clic (« Lancer », lecture) : exigence d'iOS. Sans Web Audio, le
    // volume des éléments est réglé directement (sans rampe).
    // Position : les pistes d'un acte s'enchaînent depuis le début de l'acte (et bouclent) ;
    // après un saut vers un autre acte, la piste et l'instant sont déduits du temps du
    // diaporama. Dans un même acte, la musique continue sans à-coup (pause, sauts, reprise).
    const aFond = D.fond.some((l) => l.length > 0);
    let musiqueOn = lire(CLE_MUSIQUE) !== 'non';
    let volume = (() => { const v = Number(lire(CLE_VOLUME)); return lire(CLE_VOLUME) !== null && v >= 0 && v <= 1 ? v : VOLUME_DEFAUT; })();
    interface LecteurFond { el: HTMLAudioElement; g: GainNode | null; acte: number; piste: number; v: number; enchaine: boolean; arret: number }
    const fonds: LecteurFond[] = [0, 1].map(() => {
      const el = new Audio();
      el.preload = 'auto';
      return { el, g: null, acte: -1, piste: -1, v: 0, enchaine: false, arret: 0 };
    });
    let courant = -1;            // lecteur de fond actif (-1 : aucun)
    let ctx: AudioContext | null = null;
    let maitre: GainNode | null = null;
    let duck = 0;                 // gain de ducking visé (repli sans Web Audio)
    let etatMusique: EtatMusique = 'arret';
    let arretMusique = 0;
    let deverrouille = false;

    function deverrouillerAudio() {
      if (deverrouille) { void ctx?.resume(); return; }
      deverrouille = true;
      if (aFond) {
        try {
          const AC = window.AudioContext || (window as any).webkitAudioContext;
          ctx = new AC();
          maitre = ctx.createGain();
          maitre.gain.value = 0;
          maitre.connect(ctx.destination);
          for (const f of fonds) {
            f.g = ctx.createGain();
            f.g.gain.value = 0;
            ctx.createMediaElementSource(f.el).connect(f.g).connect(maitre);
          }
          void ctx.resume();
        } catch { ctx = null; maitre = null; fonds.forEach((f) => (f.g = null)); }
      }
      // iOS : chaque élément <audio> doit avoir été lancé une fois pendant un geste de
      // l'utilisateur. On amorce, en silence, le second lecteur de fond et celui des chants.
      const amorcer = (el: HTMLAudioElement, src: string | undefined) => {
        if (!src || !el.paused) return;
        if (!el.getAttribute('src')) el.src = src;
        el.muted = true;
        el.play().then(() => { if (el !== sa || !enSuite) el.pause(); el.muted = false; }).catch(() => { el.muted = false; });
      };
      amorcer(sa, D.diapos.find((x) => x.suite)?.suite?.src);
      amorcer(fonds[1].el, D.fond.find((l) => l.length > 1)?.[1]?.src ?? D.fond.find((l) => l.length)?.[0]?.src);
    }

    function etatCourant(): EtatMusique {
      if (!lance || !joue) return 'arret';
      if (enSuite) {
        // Intermède : la musique de fond se tait ; lecture et épisode : baissée comme sous la voix.
        if (D.diapos[i].suite?.type === 'chant') return 'chant';
        return !sa.paused && !sa.ended ? 'voix' : 'respiration';
      }
      if (enCarton) return 'carton';
      if (D.diapos[i].audio && !audio.paused && !audio.ended) return 'voix';
      return 'respiration';
    }

    /** Gain d'un lecteur de fond (fondu enchaîné), en rampe linéaire sur `duree` secondes. */
    function fondre(f: LecteurFond, cible: number, duree: number) {
      if (ctx && f.g) {
        const t = ctx.currentTime, g = f.g.gain;
        g.cancelScheduledValues(t);
        g.setValueAtTime(g.value, t);
        g.linearRampToValueAtTime(cible, t + Math.max(0.02, duree));
      }
      f.v = cible;
      if (!ctx) f.el.volume = Math.min(1, Math.max(0, cible * duck));
    }

    /** Cartouche de la musique de fond (en haut à droite) : visible tant qu'une piste de fond
     *  est en cours et la musique activée ; masqué pendant un chant (son propre cartouche). */
    function afficherMusique() {
      const f = courant >= 0 ? fonds[courant] : null;
      const p = f && f.acte >= 0 ? D.fond[f.acte]?.[f.piste] : null;
      const oui = Boolean(p && musiqueOn && lance && !(enSuite && D.diapos[i].suite?.type === 'chant'));
      if (p && elMusique.dataset.src !== p.src) {
        elMusique.dataset.src = p.src;
        elMusique.classList.remove('est-visible');
        void elMusique.offsetWidth;
        elMusique.innerHTML = p.info;
        estomperPlusTard(elMusique);
      }
      elMusique.classList.toggle('est-visible', oui);
    }

    /** Ducking : gain commun selon l'état (voix, respiration, carton, intermède, arrêt). À
     *  l'arrêt (pause, musique coupée), les lecteurs sont mis en pause après le fondu. */
    function appliquerEtat() {
      if (!aFond) return;
      const avant = etatMusique;
      etatMusique = etatCourant();
      afficherMusique();
      const cible = musiqueOn ? Math.min(1, GAINS[etatMusique] * (volume / VOLUME_DEFAUT)) : 0;
      const baisse = cible < duck;
      duck = cible;
      if (ctx && maitre) {
        const t = ctx.currentTime, g = maitre.gain;
        g.cancelScheduledValues(t);
        g.setValueAtTime(g.value, t);
        // La musique s'efface vite quand la voix entre, remonte plus doucement ensuite ; à la
        // sortie d'un carton d'acte (musique au premier plan), la descente est un fondu (~2 s).
        g.setTargetAtTime(cible, t, baisse ? (avant === 'carton' ? 0.6 : 0.12) : 0.5);
      } else {
        fonds.forEach((f) => (f.el.volume = Math.min(1, Math.max(0, f.v * duck))));
      }
      clearTimeout(arretMusique);
      if (cible === 0) {
        arretMusique = window.setTimeout(() => { if (duck === 0) fonds.forEach((f) => f.el.pause()); }, 700);
      }
    }

    /** Piste et instant de fond pour l'instant `t` du diaporama (acte de la diapositive courante). */
    function positionFond(t: number) {
      const a = acteDe[i], liste = D.fond[a];
      if (!liste?.length) return null;
      const total = liste.reduce((s, p) => s + p.duree, 0);
      let o = Math.max(0, t - bornes[a].t0) % total, j = 0;
      while (j < liste.length - 1 && o >= liste[j].duree) { o -= liste[j].duree; j++; }
      return { a, j, o: Math.min(o, Math.max(0, liste[j].duree - FONDU_PISTE - 0.5)) };
    }

    function jouerPiste(a: number, j: number, o: number, fondu: number) {
      const sortant = courant >= 0 ? fonds[courant] : null;
      const k = courant >= 0 ? 1 - courant : 0;
      const f = fonds[k], p = D.fond[a][j];
      clearTimeout(f.arret);
      f.acte = a; f.piste = j; f.enchaine = false;
      if (f.el.getAttribute('src') !== p.src) f.el.src = p.src;
      const caler = () => { try { f.el.currentTime = o; } catch { /* pas encore prêt */ } };
      if (f.el.readyState >= 1) caler(); else f.el.addEventListener('loadedmetadata', caler, { once: true });
      if (ctx && f.g) { f.g.gain.cancelScheduledValues(ctx.currentTime); f.g.gain.setValueAtTime(0, ctx.currentTime); }
      f.v = 0;
      f.el.play().catch(() => { /* bloqué ou interrompu : resynchronisé au prochain geste */ });
      fondre(f, p.volume, fondu);
      if (sortant) {
        fondre(sortant, 0, fondu);
        clearTimeout(sortant.arret);
        sortant.arret = window.setTimeout(() => { if (fonds[courant] !== sortant) sortant.el.pause(); }, fondu * 1000 + 150);
      }
      courant = k;
      afficherMusique();
    }

    /** Musique à jour : état (ducking), piste de l'acte courant, lecture ou arrêt. */
    function musique() {
      if (!aFond) return;
      appliquerEtat();
      if (!musiqueOn || !lance || !joue) return;
      const cur = courant >= 0 ? fonds[courant] : null;
      if (cur && cur.acte === acteDe[i] && cur.el.getAttribute('src')) {
        // Même acte : la musique continue (ou reprend là où elle s'était arrêtée).
        if (cur.el.paused) { cur.el.play().catch(() => {}); fondre(cur, D.fond[cur.acte][cur.piste].volume, 0.3); }
        return;
      }
      const pos = positionFond(tempsCourant());
      if (!pos) {
        if (cur) { fondre(cur, 0, FONDU_ACTE); cur.acte = -1; }
        afficherMusique();
        return;
      }
      jouerPiste(pos.a, pos.j, pos.o, cur && !cur.el.paused ? FONDU_ACTE : 0.6);
    }

    // Fin d'une piste : la suivante de l'acte (ou la première, en boucle) en fondu enchaîné.
    fonds.forEach((f, k) => {
      const suite = () => {
        if (k !== courant || f.enchaine || f.acte < 0 || !joue) return;
        const liste = D.fond[f.acte];
        if (!liste?.length) return;
        f.enchaine = true;
        jouerPiste(f.acte, (f.piste + 1) % liste.length, 0, FONDU_PISTE);
      };
      f.el.addEventListener('timeupdate', () => {
        if (f.el.duration && f.el.duration - f.el.currentTime < FONDU_PISTE) suite();
      });
      f.el.addEventListener('ended', suite);
    });

    function basculerMusique(oui = !musiqueOn) {
      if (!btnMusique) return;
      musiqueOn = oui;
      btnMusique.setAttribute('aria-pressed', String(oui));
      if (curseurVolume) curseurVolume.disabled = !oui;
      ecrire(CLE_MUSIQUE, oui ? 'oui' : 'non');
      if (oui) deverrouillerAudio();
      musique();
    }
    if (btnMusique) basculerMusique(musiqueOn);
    if (curseurVolume) {
      curseurVolume.value = String(Math.round(volume * 100));
      curseurVolume.addEventListener('input', () => {
        volume = Number(curseurVolume.value) / 100;
        ecrire(CLE_VOLUME, String(volume));
        appliquerEtat();
      });
    }
    // Pour les tests (onglet en arrière-plan : on lit l'état et les gains calculés).
    // Pour les tests : saut vers une diapositive (par son numéro) ou vers son segment.
    (racine as any).__aller = (n: number, segment = false) => {
      const k = D.diapos.findIndex((x) => x.n === n);
      if (k < 0) return;
      deverrouillerAudio();
      return segment ? allerSuite(k) : aller(k);
    };
    // Contrôle de la caméra (tests) : cadre montré à l'instant `t` de la diapositive `n`.
    // Horloge (tests) : dernier instant lissé rendu et valeur brute de l'audio.
    (racine as any).__instant = () => ({ lisse: horloge.t, brut: audio.currentTime });
    // Paroles façon clip (tests) : instant de l'intermède (brut, lissé), vers et mots affichés.
    (racine as any).__clip = () => ({ brut: sa.currentTime, lisse: horlogeSuite.t, paused: sa.paused, vers, mots: versMots, clip: lecteur.classList.contains('en-clip') });
    (racine as any).__camera = (n: number, t: number) => {
      const x = D.diapos.find((d) => d.n === n);
      if (!x) return null;
      const r = cadreA(x, t);
      return { cadre: r, vue: vue(x, r), utile: x.u, etapes: x.camera, duree: x.duree, effectives: mouvementReduit.matches ? x.camera.length : plan(x).length,
        plan: plan(x).map((e, k, P) => ({ t: e.t, de: e.de, a: e.a, ...(k ? ampleur(P[k - 1].v, e.v) : {}) })) };
    };
    (racine as any).__musique = () => ({
      etat: etatMusique, duck, musiqueOn, volume, courant, ctx: ctx?.state ?? null,
      maitre: maitre?.gain.value ?? null, enSuite, suiteFini, suite: D.diapos[i].suite?.type ?? null, i, t: tempsCourant(), total,
      fonds: fonds.map((f) => ({ src: f.el.getAttribute('src'), acte: f.acte, piste: f.piste, v: f.v, g: f.g?.gain.value ?? null, paused: f.el.paused, t: f.el.currentTime })),
    });

    // --- Contrôles ---------------------------------------------------------------------------
    racine.addEventListener('click', (e) => {
      const b = (e.target as Element).closest<HTMLElement>('[data-action]');
      if (!b || !racine.contains(b)) return;
      const action = b.dataset.action;
      if (action === 'lancer') lancer(0);
      else if (action === 'reprendre') lancer(Number(b.dataset.index));
      else if (action === 'basculer') basculer();
      else if (action === 'precedent') aller(i - 1);
      else if (action === 'suivant') suivant();
      else if (action === 'passer') passerCarton();
      else if (action === 'sous-titres') sousTitres(!lecteur.classList.contains('avec-st'));
      else if (action === 'plein-ecran') pleinEcran();
      else if (action === 'musique') basculerMusique();
    });
    segments.forEach((s) => s.addEventListener('click', (e) => {
      // Clic dans un segment : on saute à l'endroit visé ; clavier : au début de l'acte.
      const ev = e as MouseEvent;
      if (ev.detail === 0) return aller(D.diapos.findIndex((x) => x.n >= Number(s.dataset.debut)));
      const r = s.getBoundingClientRect();
      const k = segments.indexOf(s);
      const t = bornes[k].t0 + ((ev.clientX - r.left) / r.width) * (bornes[k].t1 - bornes[k].t0);
      let j = bornes[k].de;
      while (j + 1 < bornes[k].fin && debuts[j + 1] <= t) j++;
      // Dans la part d'un segment (chant, lecture, épisode) : directement au segment.
      if (D.diapos[j].suite && t >= debuts[j] + prelude[j] + voixEtPause[j]) return allerSuite(j);
      aller(j);
    }));

    function sousTitres(oui: boolean) {
      lecteur.classList.toggle('avec-st', oui);
      btnSt.setAttribute('aria-pressed', String(oui));
      mesurerMarges();
      rendre();
      ecrire(CLE_ST, oui ? 'oui' : 'non');
    }
    sousTitres(lire(CLE_ST) !== 'non');

    // Plein écran (API Fullscreen ; caché si le navigateur ne la permet pas, ex. iPhone).
    const peDispo = document.fullscreenEnabled || (document as any).webkitFullscreenEnabled;
    if (!peDispo) btnPe.hidden = true;
    function pleinEcran() {
      const el = document.fullscreenElement ?? (document as any).webkitFullscreenElement;
      if (el) (document.exitFullscreen ?? (document as any).webkitExitFullscreen).call(document);
      else (lecteur.requestFullscreen ?? (lecteur as any).webkitRequestFullscreen).call(lecteur);
    }
    // Après un changement de taille, la caméra est recalculée pour l'instant courant ; les
    // calques figés (sortant d'un fondu, image sous un carton) sont reposés sur leur cadre.
    function recadrer() {
      couches.forEach((c, k) => { if (c.x) cadre(calques[k], c.x); });
      tailleLieu();
      taillePortraits();
      tailleObjet();
      mesurerMarges();
      tailleChiffre();
      couches.forEach((c, k) => { if (c.x && (k !== visible || c.x !== D.diapos[i])) poser(k); });
      rendre();
      ajusterFrises();
      majSuite();
    }
    const auRedimensionnement = () => {
      recadrer();
      btnPe.setAttribute('aria-pressed', String(Boolean(document.fullscreenElement)));
      montrerControles();
    };
    document.addEventListener('fullscreenchange', auRedimensionnement);
    new ResizeObserver(recadrer).observe(scene);

    // En plein écran, légende et contrôles s'effacent après 3 s d'inactivité.
    let inactivite = 0;
    function montrerControles() {
      lecteur.classList.remove('inactif');
      clearTimeout(inactivite);
      inactivite = window.setTimeout(() => {
        if (joue && document.fullscreenElement === lecteur) lecteur.classList.add('inactif');
      }, 3000);
    }
    for (const ev of ['mousemove', 'touchstart', 'keydown']) lecteur.addEventListener(ev, montrerControles, { passive: true });

    // Clavier : espace, ← →, F, S, Entrée (passer le carton) — sauf dans un champ de saisie.
    document.addEventListener('keydown', (e) => {
      if (e.ctrlKey || e.metaKey || e.altKey) return;
      const cible = e.target instanceof Element ? e.target : document.body;
      if (cible.closest('input, textarea, select, [contenteditable]')) return;
      if (e.key === ' ' || e.key === 'Spacebar') {
        if (cible.closest('button, a')) return; // le bouton s'active de lui-même
        e.preventDefault(); basculer();
      } else if (e.key === 'ArrowLeft') { e.preventDefault(); aller(i - 1); }
      else if (e.key === 'ArrowRight') { e.preventDefault(); suivant(); }
      else if (e.key === 'Enter') {
        // Pendant un carton, Entrée le passe (même si le focus est sur le bouton de lecture).
        const bouton = cible.closest('button, a');
        if (!enCarton || (bouton && bouton !== btnLecture)) return;
        e.preventDefault(); passerCarton();
      }
      else if (e.key === 'f' || e.key === 'F') { if (peDispo) pleinEcran(); }
      else if (e.key === 's' || e.key === 'S') sousTitres(!lecteur.classList.contains('avec-st'));
      else if ((e.key === 'm' || e.key === 'M') && btnMusique) basculerMusique();
    });

    // Balayage gauche/droite sur l'image.
    let x0 = 0, y0 = 0;
    scene.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; y0 = e.touches[0].clientY; }, { passive: true });
    scene.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - x0, dy = e.changedTouches[0].clientY - y0;
      if (Math.abs(dx) > 50 && Math.abs(dx) > 1.5 * Math.abs(dy)) dx < 0 ? suivant() : aller(i - 1);
      else if (Math.abs(dx) < 12 && Math.abs(dy) < 12) revelerCartouches();
    }, { passive: true });

    // Reprise : « Reprendre à la diapositive 37 ». La position est mémorisée par la clé stable
    // de la diapositive (son fichier Commons) ; un ancien numéro (format d'avant, chiffres
    // seuls) est accepté une fois, puis réécrit sous forme de clé.
    const memo = lire(CLE_POS);
    let k = memo ? D.diapos.findIndex((x) => x.cle === memo) : -1;
    if (k < 0 && memo && /^\d+$/.test(memo)) {
      k = D.diapos.findIndex((x) => x.n === Number(memo));
      ecrire(CLE_POS, k >= 0 ? D.diapos[k].cle : null);
    }
    if (k > 0) {
      btnReprendre.hidden = false;
      btnReprendre.dataset.index = String(k);
      btnReprendre.textContent = `Reprendre à la diapositive ${D.diapos[k].n}`;
    }

    cadre(calques[0], D.diapos[0]);
    mesurerMarges();
    rendre(0);
    majTemps();
    precharger(0);
  }

  for (const r of document.querySelectorAll<HTMLElement>('.diaporama')) monter(r);
</script>

