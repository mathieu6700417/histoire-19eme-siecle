<!-- Frise du temps : son HTML est injecté (set:html), d'où des styles globaux, préfixés par .diaporama. -->
<style is:global>
  /* Frise du temps : la période graduée par année, les actes en filets alternés (gris clair /
     gris moyen, l'acte courant en noir), crans des années, curseur noir (trait fin, ou court
     segment pour une durée) et sa date en petites capitales. Strictement monochrome. */
  .diaporama .frise-t { --frise-glisse: 1s; width: 100%; font-variant-numeric: oldstyle-nums; }
  .diaporama .frise-t__piste { position: relative; height: 2.6rem; }
  .diaporama .frise-t__acte {
    position: absolute;
    bottom: 0.45rem;
    height: 2px;
    background: #a9a69f;
    border-right: 2px solid var(--c-fond);
  }
  .diaporama .frise-t__acte--pair { background: #75726c; }
  .diaporama .frise-t__acte.est-courant { background: var(--c-texte); height: 3px; bottom: calc(0.45rem - 0.5px); }
  .diaporama .frise-t__cran {
    position: absolute;
    bottom: calc(0.45rem - 3px);
    width: 1px;
    height: 8px;
    margin-left: -0.5px;
    background: #a9a69f;
  }
  .diaporama .frise-t__curseur {
    position: absolute;
    bottom: calc(0.45rem - 7px);
    height: 16px;
    min-width: 1.5px;
    border-inline: 1px solid var(--c-texte);
    background: linear-gradient(var(--c-texte), var(--c-texte)) center / 100% 3px no-repeat;
    transform: translateX(-1px);
    transition: left var(--frise-glisse) ease-in-out 0.5s, width var(--frise-glisse) ease-in-out 0.5s;
  }
  .diaporama .frise-t__date {
    position: absolute;
    top: 0;
    transform: translateX(-50%);
    white-space: nowrap;
    font-size: 0.95rem;
    line-height: 1.2;
    font-variant: small-caps;
    font-variant-numeric: oldstyle-nums;
    letter-spacing: 0.04em;
    color: var(--c-texte);
    transition: left var(--frise-glisse) ease-in-out 0.5s;
  }
  .diaporama .frise-t__annees { position: relative; height: 1.2rem; }
  .diaporama .frise-t__annee {
    position: absolute;
    top: 0;
    transform: translateX(-50%);
    font-size: 0.8rem;
    line-height: 1.2;
    color: var(--c-texte-doux);
  }
  .diaporama .frise-t__annee.est-masquee { visibility: hidden; }

  /* Dans le carton : sous le titre et les dates ; le curseur glisse à partir de 0,6 s. */
  .diaporama .frise-t--carton { max-width: min(38rem, 100%); margin-top: var(--e-3); text-align: left; }
  .diaporama .frise-t--carton .frise-t__curseur { transition-delay: 0.6s; }
  .diaporama .frise-t--carton .frise-t__date { transition-delay: 0.6s; }
  .diaporama .en-carton .frise-t--carton { animation: frise-entree 900ms cubic-bezier(0.2, 0.6, 0.3, 1) 300ms both; }
  @keyframes frise-entree { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: none; } }

  /* En surimpression : bandeau blanc cassé voilé, fin, centré au bas de l'image (au-dessus des
     bandeaux du bas en plein écran : --frise-bas, posé par le script). Éphémère. */
  .diaporama .frise-t--surimpression {
    position: absolute;
    left: 50%;
    bottom: calc(var(--frise-bas, 0px) + var(--e-2));
    z-index: 2;
    width: min(40rem, calc(100% - 2 * var(--e-3)));
    padding: 0.35rem 1.1rem 0.15rem;
    background: rgba(251, 250, 247, 0.88);
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, 4px);
    transition: opacity 600ms ease, transform 600ms ease, visibility 0s linear 600ms;
  }
  .diaporama .frise-t--surimpression.est-visible {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
    transition: opacity 400ms ease, transform 400ms ease, visibility 0s;
  }
  .diaporama .lecteur.en-carton .frise-t--surimpression { visibility: hidden; }
  @media (prefers-reduced-motion: reduce) {
    .diaporama .frise-t__curseur, .diaporama .frise-t__date { transition: none !important; }
    .diaporama .en-carton .frise-t--carton { animation: none; }
    .diaporama .frise-t--surimpression, .diaporama .frise-t--surimpression.est-visible {
