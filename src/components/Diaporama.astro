---
// Lecteur d'un diaporama narré de la section « Le siècle en images » (spec 12).
//
// Usage : <Diaporama diaporama={d} />, où `d` est le contenu d'un fichier
// src/data/diaporamas/NN-<slug>.json (voir src/utils/diaporamas.ts pour le format).
// Images et voix sont servies depuis public/diaporamas/<slug>/ (préparées par
// scripts/diaporamas/).
//
// - Image en couleur (exception de la spec 11 : c'est une visionneuse), fondu enchaîné ;
//   tout le reste est monochrome. Caméra calée sur la narration (spec 12, révision du
//   2026-10-07) : chaque diapositive porte 1 à 3 cadres ; la caméra rejoint chacun à l'instant
//   où la voix en parle. L'horloge est `audio.currentTime` (aucune minuterie propre) : pause,
//   saut, redimensionnement et plein écran restent justes.
// - Cartouche (titre, auteur, date) en haut à gauche de l'image, sous-titres (activables, choix mémorisé), barre de progression
//   découpée en actes, clavier (espace, ← →, F, S), plein écran, balayage sur téléphone,
//   reprise mémorisée (localStorage, toujours dans un try/catch).
// - Animations d'entrée (spec 12, révision du 2026-10-07) : fondu enchaîné avec révélation
//   gris → couleur, léger recul (composé avec la caméra, sans la décaler), cartouche décalé,
//   sous-titre en fondu croisé, carton de changement d'acte (12 s, musique au premier plan, compté dans la durée totale,
//   passable d'un clic, de Entrée ou de →). Ses 3,5 dernières secondes sont l'ouverture en deux
//   volets, sur un détail zoomé de l'image (`image.ouverture`) puis un recul de 5 s avec la voix ;
//   passé, le carton joue aussitôt son ouverture. Le carton se fige avec la pause ; l'entrée
//   d'une image (1,8 s au plus) va toujours à son terme.
// - Frise du temps (spec 12, frise simplifiée du 2026-10-09) : un filet de la première à la
//   dernière année, une graduation par année sans étiquette, un curseur et sa date au-dessus.
//   Dans chaque carton d'acte, le curseur glisse de la date précédente au début du nouvel acte ;
//   entre deux cartons, la frise passe 4 s au bas de l'image à chaque changement d'année ou
//   retour en arrière, toujours affichée : elle pousse les autres surimpressions du bas plus
//   haut. « Date précédente » : celle de la dernière diapositive affichée, si bien que les sauts
//   manuels restent justes ; positions en %, donc indifférentes à la taille.
// - Rien ne joue sans clic. Sans JavaScript, la page est un livre d'images : la liste des
//   diapositives avec image, légende et narration.
// - Script du lecteur : modules de src/scripts/diaporama/ (point d'entrée lecteur.ts) ; carte des
//   modules dans scripts/diaporamas/README.md, « Lecteur : carte des modules ». Ce fichier garde
//   le gabarit HTML et les styles.
import { typographie } from '../utils/typographie.mjs';
import CarteCitation from './CarteCitation.astro';
import EpisodeVisuels from './EpisodeVisuels.astro';
import Surimpressions from './Surimpressions.astro';
import Generique from './Generique.astro';
import { dureesGenerique, imagesGenerique, indicatif, urlCommun } from '../utils/diaporamas';
import { CARTON, PAUSE, MOSAIQUE, VOLET, avantApres, debutPlongee, instantsSerie, plansDe, texteLu, zoneUtileDe, etapesCamera, versUtile, zoneUtile, pauseApres, friseDe, minutageLecture, motsLus, phrasesDe, planParis, surimpressionsDe, urlCommons, urlMedia, type Diaporama, type Episode, type FondCarte, type ImageDiapo, type ImageSerie, type Intermede, type Lecture, type PisteFond } from '../utils/diaporamas';

interface Props { diaporama: Diaporama }
const { diaporama: d } = Astro.props;

const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
const t = (s?: string) => (s ? typographie(s.trim()) : '');

/** Légende de notice : auteur, *titre*, date, technique. Conservation. (HTML échappé) */
function legende(x: Diaporama['diapositives'][number]) { return legendeImage(x.image); }
function legendeImage(i: { titre?: string; auteur?: string; date?: string; technique?: string; conservation?: string; commons: string }) {
  const tete = [i.auteur && esc(t(i.auteur)), `<cite>${esc(t(i.titre ?? ''))}</cite>`, i.date && esc(t(i.date)), i.technique && esc(t(i.technique))]
    .filter(Boolean).join(', ');
  const lieu = i.conservation ? ` ${esc(t(i.conservation))}.` : '';
  return `<span class="notice">${tete}.${lieu}</span> <a class="notice__commons" href="${esc(urlCommons(i.commons))}" rel="noopener" target="_blank">Commons</a>`;
}

/** Cartouche du lecteur (spec 12, « Cartouches lisibles ») : trois lignes, *titre court*,
 *  auteur, « date · technique » (HTML échappé). Le titre officiel reste dans le livre et l'`alt`.
 *  Image mise en mouvement par IA (spec 16) : une quatrième ligne le signale (masquée par le CSS
 *  avec la préférence « réduire les animations », où l'image reste fixe). */
function cartouche(x: Diaporama['diapositives'][number]) { return cartoucheImage(x.image, Boolean(videoDe(x))); }
function cartoucheImage(i: { titre: string; titre_court?: string; auteur?: string; date?: string; technique?: string }, ia = false) {
  const quand = [i.date && esc(t(i.date)), i.technique && esc(t(i.technique))].filter(Boolean).join(' · ');
  return `<cite>${esc(t(i.titre_court || i.titre))}</cite>${i.auteur ? `<span>${esc(t(i.auteur))}</span>` : ''}${quand ? `<span>${quand}</span>` : ''}`
    + (ia ? '<span class="lecteur__legende-ia">mise en mouvement par IA</span>' : '');
}
/** Clip d'une image mise en mouvement (spec 16) ; sans effet sur un avant / après (sur une mosaïque,
 *  il paraît après la plongée). */
const videoDe = (x: Diaporama['diapositives'][number]) => (x.image.video && !x.image.apres ? x.image.video : null);

/** Cartouche d'un intermède dans le lecteur : *œuvre* et compositeur rédigés à la main
 *  (`cartouche`), sans troncature ; l'interprète au survol seulement. */
function cartoucheIntermede(c: Intermede) {
  if (!c.cartouche) return cartoucheChant(c);
  const voix = [c.interprete && esc(t(c.interprete)), c.enregistrement && esc(t(c.enregistrement))].filter(Boolean).join(', ');
  return `<cite>${esc(t(c.cartouche.oeuvre))}</cite><span>${esc(t(c.cartouche.compositeur))}</span>${voix ? `<span class="lecteur__legende-voix">${voix}</span>` : ''}`;
}
/** Cartouche d'un intermède chanté : *titre*, auteur et date, interprète et enregistrement. */
function cartoucheChant(c: Intermede) {
  const sous = [c.auteur && esc(t(c.auteur)), c.date && esc(t(c.date))].filter(Boolean).join(', ');
  const voix = [c.interprete && esc(t(c.interprete)), c.enregistrement && esc(t(c.enregistrement))].filter(Boolean).join(', ');
  return `<cite>${esc(t(c.titre))}</cite>${sous ? `<span>${sous}</span>` : ''}${voix ? `<span class="lecteur__legende-voix">${voix}</span>` : ''}`;
}
/** Cartouche de la musique de fond, sur deux lignes rédigées à la main (`cartouche`) :
 *  « Symphonie nº 87, menuet » / « Joseph Haydn, 1785 », sans troncature. À défaut, le titre et
 *  le compositeur tels quels. L'interprète n'apparaît qu'au survol (et dans les crédits). */
function cartoucheMusique(p: PisteFond) {
  const oeuvre = p.cartouche?.oeuvre ?? p.titre;
  const auteur = p.cartouche?.compositeur ?? [p.compositeur, p.date].filter(Boolean).join(', ');
  const voix = p.interprete ? `<span class="m-voix">${esc(t(p.interprete))}</span>` : '';
  return `<span class="m-ligne"><cite>${esc(t(oeuvre))}</cite></span><span class="m-auteur">${esc(t(auteur))}</span>${voix}`;
}
/** Image entière sur fond noir (drapeau `image.entier`) : sujet du rapprochement (dans la zone
 *  utile) et zoom final ; null sans le drapeau. */
function entierDe(i: ImageDiapo, u: [number, number, number, number]) {
  if (!i.entier) return null;
  return { v: i.entier_vers ? versUtile(i.entier_vers, u) : null, z: Math.min(2, Math.max(1, i.entier_zoom ?? 1.3)) };
}
/** Image d'une série pour le lecteur (spec 14) : zone utile, dimensions, cartouche, instant et
 *  étapes de caméra (cadres ramenés dans la zone utile). */
function planLecteur(i: ImageDiapo, legende: string, instant: number, camera: { c: [number, number, number, number]; t: number }[], entier = true) {
  const u = zoneUtileDe(i);
  return { en: entier ? entierDe(i, u) : null, img: urlMedia(d.slug, i.fichier), u, l: (i.largeur ?? 1600) * (u[2] - u[0]), h: (i.hauteur ?? 1200) * (u[3] - u[1]),
    alt: t(i.titre), legende, t: instant, camera: camera.map((e) => ({ c: versUtile(e.c, u), t: e.t })) };
}
/** Série sans narration (galerie, lecture) : un cadre par image, tenu de son instant à la suivante. */
function serieLecteur(images: ImageSerie[], duree: number, legende: (i: ImageDiapo) => string, situes: (number | null)[] = []) {
  const T = instantsSerie(images, duree, situes);
  return images.map((g, k) => planLecteur(g.image, legende(g.image), T[k], [{ c: g.image.camera?.[0]?.cadre ?? [0, 0, 1, 1], t: T[k] }]));
}
/** Ligne d'une image dans un cartouche ou une carte : titre court, auteur, date (HTML échappé). */
const ligneImage = (i: ImageDiapo) => [`<i>${esc(t(i.titre_court || i.titre))}</i>`, i.auteur && esc(t(i.auteur)), i.date && esc(t(i.date))].filter(Boolean).join(', ');
/** Cartouche d'une image de galerie (spec 14) : sous l'œuvre entendue, la ligne de l'image ; pour
 *  une galerie nouvelle (`theme`), le thème en tête, puis l'image, la musique au survol. */
function cartoucheGalerie(c: Intermede, i: ImageDiapo) {
  if (!c.theme) return `${cartoucheIntermede(c)}<span class="lecteur__legende-image">${ligneImage(i)}</span>`;
  const musique = [c.cartouche?.oeuvre ?? c.titre, c.cartouche?.compositeur ?? c.auteur].filter(Boolean).map((v) => esc(t(v))).join(', ');
  return `<cite>${esc(t(c.theme))}</cite><span class="lecteur__legende-image">${ligneImage(i)}</span><span class="lecteur__legende-voix">Musique : ${musique}</span>`;
}
/** Instants des images d'une lecture qui portent `quand` : début du premier mot du passage. */
function instantsLecture(l: Lecture, mots: number[]) {
  const texte = texteLu(l), bornes = motsLus(texte);
  return (l.images ?? []).map((g) => {
    const pos = g.quand ? texte.indexOf(g.quand) : -1;
    const k = pos < 0 ? -1 : bornes.findIndex((b) => b.f > pos);
    return k < 0 ? null : Math.max(0, mots[k] - 0.3);
  });
}
const intermedeApres = new Map((d.musique?.intermedes ?? []).filter((c) => c.duree).map((c) => [c.apres, c]));
// Lectures d'époque et épisodes (spec 12, révision du 2026-10-07) : insérés après la voix d'une
// diapositive, comme les intermèdes chantés (un seul segment après une diapositive donnée).
const lectureApres = new Map((d.lectures ?? []).filter((l) => l.audio?.duree).map((l) => [l.apres, l]));
const episodeApres = new Map((d.episodes ?? []).filter((e) => e.audio?.duree).map((e) => [e.apres, e]));
const fonds: Record<string, FondCarte> = Object.fromEntries(
  Object.values(import.meta.glob<{ default: FondCarte }>('../data/diaporamas/fonds/*.json', { eager: true })).map((m) => [m.default.nom, m.default]));

/** Portrait d'une lecture : l'image d'une diapositive (recadrée) ou son propre fichier. */
function portraitDe(l: Lecture) {
  const p = l.portrait;
  if (!p) return null;
  if (p.diapositive) {
    const x = d.diapositives.find((y) => y.n === p.diapositive);
    if (!x) return null;
    return { src: urlMedia(d.slug, x.image.fichier), largeur: x.image.largeur ?? 1000, hauteur: x.image.hauteur ?? 1300, cadre: p.cadre,
      credit: [x.image.auteur, x.image.date].filter(Boolean).join(', ') };
  }
  if (!p.fichier || !p.largeur) return null;
  return { src: urlMedia(d.slug, p.fichier), largeur: p.largeur, hauteur: p.hauteur ?? p.largeur, cadre: p.cadre,
    credit: [p.auteur, p.date].filter(Boolean).join(', ') };
}
/** Image du moment d'une lecture (fond flou de sa carte) : celle de la diapositive qu'elle suit. */
function fondDe(l: Lecture) {
  const x = d.diapositives.find((y) => y.n === l.apres);
  // Avant / après : l'image montrée à la fin de la voix est l'image « après ».
  return x ? urlMedia(d.slug, x.image.apres?.fichier ?? x.image.fichier) : undefined;
}
/** Phrases horodatées d'un épisode, avec leur texte (sous-titres). */
function phrasesEpisode(e: Episode) {
  const bornes = phrasesDe(e.narration);
  const ph = e.audio?.phrases ?? [];
  if (ph.length !== bornes.length) return [[0, e.audio?.duree ?? 0, t(e.narration)]];
  return bornes.map((b, k) => [ph[k][0], ph[k][1], t(e.narration.slice(b.d, b.f))]);
}

const acteDe = (n: number) => [...d.actes].reverse().find((a) => a.debut <= n) ?? d.actes[0];
const frise = friseDe(d);

// Cartes de lieu et citations en surimpression (spec 12, 2026-10-07) : fenêtres d'affichage
// calculées au build ; la citation est découpée en mots (`.m`, rang `data-k` dans `motsLus` ; la
// ponctuation détachée suit le mot précédent).
const plan = planParis(d.slug);
function surimpressions(x: Diaporama['diapositives'][number]) {
  const s = surimpressionsDe(x, fonds, plan);
  // Portraits des personnes nommées (spec 12, 2026-10-08) : rangée en bas à gauche.
  const portraits = s.portraits ? { ...s.portraits, gens: s.portraits.gens.map((g) => ({ ...g, nom: t(g.nom) })) } : null;
  // Objet de musée et manuscrit (spec 12, « Enrichissements visuels ») : fenêtres déjà arbitrées.
  const objet = s.objet ? { ...s.objet, nom: t(s.objet.nom), legende: t(s.objet.legende) } : null;
  const manuscrit = s.manuscrit ? { ...s.manuscrit, nom: t(s.manuscrit.nom), legende: t(s.manuscrit.legende) } : null;
  // Chiffre clé et date républicaine (point 4) : fenêtres déjà arbitrées.
  const chiffre = s.chiffre ? { ...s.chiffre, prefixe: t(s.chiffre.prefixe), unite: t(s.chiffre.unite) } : null;
  const date = s.date ? { ...s.date, republicain: t(s.date.republicain), gregorien: t(s.date.gregorien) } : null;
  if (!s.citation) return { lieu: s.lieu ? { ...s.lieu, nom: t(s.lieu.nom), credit: t(s.lieu.credit) } : null, citation: null, portraits, objet, manuscrit, chiffre, dateRep: date };
  let k = 0;
  // Le guillemet fermant fait corps avec le dernier mot : il paraît avec lui.
  const jetons = t(s.citation.texte).split(/( +)/);
  const dernier = jetons.findLastIndex((m) => m.trim());
  const html = jetons.map((m, j) => (/^ +$/.test(m) ? ' '
    : `<span class="m" data-k="${/[\p{L}\p{N}]/u.test(m) ? k++ : Math.max(0, k - 1)}">${esc(m)}${j === dernier ? '\u00a0»' : ''}</span>`)).join('');
  const c = s.citation;
  const mots = k === c.mots.length ? c.mots : Array(k).fill(c.mots[0]); // repli : tous ensemble
  return {
    lieu: s.lieu ? { ...s.lieu, nom: t(s.lieu.nom), credit: t(s.lieu.credit) } : null,
    citation: { a: c.a, b: c.b, fin: c.fin, mots, html, auteur: t(`— ${c.prudence ? 'attribué à ' : ''}${c.auteur}`) },
    portraits, objet, manuscrit, chiffre, dateRep: date,
  };
}

// Données transmises au script (textes déjà mis en typographie française).
const donnees = {
  slug: d.slug,
  pause: PAUSE,
  carton: CARTON,
  // `reperes` : dates clés de l'acte pour la frise animée du carton (position en %, date, libellé).
  actes: d.actes.map((a) => ({ titre: t(a.titre), dates: t(a.dates), debut: a.debut,
    reperes: frise ? (a.reperes ?? []).slice(0, 3).map((r) => { const p = frise.dater(r.date, r.date_fin); return { x: Math.round((p.x0 + p.x1) * 50) / 100, date: t(p.libelle), texte: t(r.libelle) }; }) : [] })),
  diapos: d.diapositives.map((x, k) => ({
    n: x.n,
    // Clé stable de la reprise : le fichier Commons de l'image, qui survit aux renumérotations
    // (celui de l'image « après » pour un avant / après : l'image avant peut servir ailleurs).
    cle: x.image.apres?.commons ?? x.image.commons,
    img: urlMedia(d.slug, x.image.fichier),
    // Zone utile (spec 12, « Sans bordures ») : le lecteur ne voit que cette partie de l'image ;
    // `l` × `h` en sont les dimensions (px de l'image servie) et tous les cadres (caméra,
    // ouverture, intermède) y sont exprimés, ramenés dedans.
    u: zoneUtile(x),
    en: x.image.apres || x.mosaique ? null : entierDe(x.image, zoneUtile(x)),
    l: (x.image.largeur ?? 1600) * (zoneUtile(x)[2] - zoneUtile(x)[0]),
    h: (x.image.hauteur ?? 1200) * (zoneUtile(x)[3] - zoneUtile(x)[1]),
    alt: t(x.image.titre),
    legende: cartouche(x),
    texte: t(x.narration),
    audio: x.audio ? urlMedia(d.slug, x.audio.fichier) : '',
    duree: x.audio?.duree ?? 0,
    // Pause après la voix (allongée si la narration finit par une citation en surimpression).
    pause: pauseApres(x),
    camera: etapesCamera(x).map((e) => ({ ...e, c: versUtile(e.c, zoneUtile(x)) })),
    // Détail zoomé découvert à la sortie du carton d'acte (première diapositive d'un acte).
    ouv: x.image.ouverture ? versUtile(x.image.ouverture, zoneUtile(x)) : null,
    date: frise ? { ...frise.diapos[k], libelle: t(frise.diapos[k].libelle) } : null,
    ...surimpressions(x),
    // Avant / après (point 3) : image après, instant du volet, étapes de la caméra sur l'image après.
    ap: x.image.apres ? (() => {
      const ap = x.image.apres!, a = avantApres(x)!, u = a.u;
      return { img: urlMedia(d.slug, ap.fichier), u, l: (ap.largeur ?? 1600) * (u[2] - u[0]), h: (ap.hauteur ?? 1200) * (u[3] - u[1]),
        alt: t(ap.titre), legende: cartoucheImage(ap), t: a.t, camera: a.camera };
    })() : null,
    // Plans (spec 14) : images suivantes de la diapositive, chacune à son instant de la voix.
    plans: x.plans?.length && !x.image.apres && !x.mosaique ? plansDe(x).map((p) => planLecteur(p.image, cartoucheImage(p.image), p.t, p.camera)) : null,
    // Image mise en mouvement par IA (spec 16) : clip muet en boucle sur la zone utile (mouvement.ts).
    video: videoDe(x) ? { src: urlMedia(d.slug, videoDe(x)!.fichier), duree: videoDe(x)!.duree } : null,
    // Mosaïque (point 5) : vignettes (la principale est l'image de la diapositive), cartouche d'une ligne.
    mos: x.mosaique ? {
      legende: `<cite>${esc(t(x.mosaique.legende))}</cite>`,
      principale: x.mosaique.principale,
      vignettes: x.mosaique.vignettes.map((v) => {
        const u = zoneUtileDe(v);
        return { img: urlMedia(d.slug, v.fichier ?? x.image.fichier), u, l: (v.largeur ?? 1000) * (u[2] - u[0]), h: (v.hauteur ?? 800) * (u[3] - u[1]), c: v.cadre ?? null };
      }),
    } : null,
    // Segment joué après la voix : intermède chanté, lecture d'époque ou épisode.
    suite: intermedeApres.has(x.n) ? (() => {
      const c = intermedeApres.get(x.n)!;
      return { type: 'chant', src: urlMedia(d.slug, c.fichier), duree: c.duree!, legende: cartoucheIntermede(c), paroles: c.paroles.map(([s, v, m]) => [s, t(v), m && motsLus(t(v)).length === m.length ? m.map(([d]) => d) : null]), instrumental: !!c.instrumental, cadre: c.cadre ? versUtile(c.cadre, zoneUtile(x)) : null,
        galerie: c.galerie?.length ? serieLecteur(c.galerie, c.duree!, (i) => cartoucheGalerie(c, i)) : null };
    })() : lectureApres.has(x.n) ? (() => {
      const l = lectureApres.get(x.n)!;
      const m = minutageLecture(l);
      return { type: 'lecture', id: l.id, src: urlMedia(d.slug, l.audio!.fichier), duree: l.audio!.duree, mots: m.mots, phrases: m.phrases,
        date: frise && l.date ? { ...frise.dater(l.date), libelle: t(frise.dater(l.date).libelle) } : null,
        images: l.images?.length ? serieLecteur(l.images, l.audio!.duree, ligneImage, instantsLecture(l, m.mots)) : null };
    })() : episodeApres.has(x.n) ? (() => {
      const e = episodeApres.get(x.n)!;
      return { type: 'episode', id: e.id, src: urlMedia(d.slug, e.audio!.fichier), duree: e.audio!.duree, phrases: phrasesEpisode(e),
        date: frise && e.date ? { ...frise.dater(e.date), libelle: t(frise.dater(e.date).libelle) } : null };
    })() : null,
  })),
  // Avant / après et mosaïques (spec 12, points 3 et 5) : durée du volet, minutage de la grille.
  volet: VOLET,
  mosaique: MOSAIQUE,
  // Musique de fond : les pistes de chaque acte (dans l'ordre des actes), enchaînées en fondu.
  fond: d.actes.map((a) => (d.musique?.fond ?? []).filter((p) => p.acte === a.id && p.duree)
    .map((p) => ({ src: urlMedia(d.slug, p.fichier), duree: p.duree!, volume: p.volume ?? 1, info: cartoucheMusique(p) }))),
  // Générique d'ouverture et récapitulatif de fin (spec 12, révision du 2026-10-09) : indicatif commun.
  generique: dureesGenerique(d).ouverture && imagesGenerique(d).length ? {
    images: imagesGenerique(d).length,
    ouverture: { src: urlCommun(indicatif.extraits.ouverture.fichier), duree: dureesGenerique(d).ouverture },
    fin: { src: urlCommun(indicatif.extraits.fin.fichier), duree: dureesGenerique(d).fin, accord: dureesGenerique(d).accordFin },
  } : null,
};
const premiere = d.diapositives[0];

/** Frise du temps simplifiée (spec 12, révision du 2026-10-09), même dessin dans le carton d'acte
 *  et en bas de l'image : un filet de la première à la dernière année (ces deux années aux
 *  extrémités), une petite graduation par année sans étiquette, le curseur (trait fin, ou court
 *  segment pour une durée) et sa date au-dessus. Dans le carton d'acte, à la place du curseur,
 *  l'intervalle de l'acte en segment noir épais, sans date (retour du 2026-10-09). Monochrome. */
function friseHtml(classe: string) {
  if (!frise) return '';
  const crans = [...frise.annees.map((a) => a.x0), 100].map((x, k, X) => `<span class="frise-t__cran${k === 0 || k === X.length - 1 ? ' frise-t__cran--borne' : ''}" style="left:${x}%"></span>`).join('');
  const a0 = frise.annees[0].a, a1 = frise.annees.at(-1)!.a;
  return `<div class="frise-t ${classe}" aria-hidden="true"><span class="frise-t__borne">${a0}</span><div class="frise-t__piste"><span class="frise-t__date"></span><span class="frise-t__filet"></span>${crans}${classe === 'frise-t--carton' ? '<span class="frise-t__acte"></span>' : ''}<span class="frise-t__curseur"></span></div><span class="frise-t__borne">${a1}</span></div>`;
}
// Dans chaque calque, après l'image : la boîte du clip d'une image mise en mouvement (spec 16,
// mouvement.ts : même transformation que l'image), les plans et les galeries de la spec 14 (images
// posées par le script, en fondu croisé), l'image « après » d'un avant / après (sous un volet qui la
// découvre, et sa ligne), puis la grille d'une mosaïque. Vides et masqués hors de ces diapositives.
const CALQUE_SUITE = '<div class="lecteur__video" hidden><video muted playsinline preload="auto" disablepictureinpicture aria-hidden="true"></video></div>'
  + '<div class="lecteur__plans" hidden></div><div class="lecteur__apres" hidden><img alt="" decoding="async" /></div><span class="lecteur__trait" hidden></span><div class="mosaique" hidden></div>';
const sectionsLivre = d.actes.map((a, i) => ({
  ...a,
  diapos: d.diapositives.filter((x) => x.n >= a.debut && (i === d.actes.length - 1 || x.n < d.actes[i + 1].debut)),
}));
---

<div class="diaporama" data-slug={d.slug}>
  <script is:inline>document.currentScript.parentElement.classList.add('avec-js');</script>
  <script type="application/json" class="diaporama__donnees" set:html={JSON.stringify(donnees).replace(/</g, '\\u003c')} />

  <div class="lecteur" role="region" aria-label={typographie(`Diaporama : ${d.titre}`)}>
    <p class="lecteur__acte" aria-hidden="true"><span class="lecteur__acte-titre">{t(acteDe(1).titre)}</span> <span class="lecteur__acte-dates">{t(acteDe(1).dates)}</span></p>
    <div class="lecteur__scene">
      <div class="lecteur__calque est-visible"><img src={urlMedia(d.slug, premiere.image.fichier)} alt={t(premiere.image.titre)} width={premiere.image.largeur} height={premiere.image.hauteur} decoding="async" /><Fragment set:html={CALQUE_SUITE} /></div>
      <div class="lecteur__calque"><img alt="" decoding="async" /><Fragment set:html={CALQUE_SUITE} /></div>
      <div class="lecteur__clip"><div class="clip__voile"></div><div class="clip__texte"></div></div>
      <p class="lecteur__legende est-visible" set:html={cartouche(premiere)} />
      <p class="lecteur__musique" aria-live="off"></p>
      <div class="lecteur__carton" data-action="passer" aria-hidden="true" title="Passer (Entrée)">
        <p class="lecteur__carton-titre"></p>
        <span class="lecteur__carton-filet"></span>
        <p class="lecteur__carton-dates"></p>
        {frise && <Fragment set:html={friseHtml('frise-t--carton')} />}
        {frise && <ul class="carton-reperes" aria-hidden="true"></ul>}
      </div>
      {[...lectureApres.values()].map((l) => <CarteCitation lecture={l} portrait={portraitDe(l)} fond={fondDe(l)} illustree={Boolean(l.images?.length)} mode="lecteur" />)}
      {[...episodeApres.values()].map((e) => <EpisodeVisuels episode={e} slug={d.slug} fonds={fonds} mode="lecteur" />)}
      {frise && <Fragment set:html={friseHtml('frise-t--surimpression')} />}
      <Surimpressions diaporama={d} fonds={fonds} plan={plan} />
      <div class="lecteur__depart">
        <button type="button" class="lecteur__bouton-depart" data-action="lancer">Lancer le diaporama</button>
        <button type="button" class="lecteur__bouton-depart lecteur__reprendre" data-action="reprendre" hidden></button>
      </div>
    </div>
    <p class="lecteur__soustitre"><span class="st">{t(premiere.narration)}</span></p>
    <Generique diaporama={d} />

    <div class="lecteur__progression" aria-label="Actes du diaporama">
      <div class="lecteur__piste">
        {d.actes.map((a) => (
          <button type="button" class="lecteur__segment" data-debut={a.debut} title={t(`${a.titre} (${a.dates})`)} aria-label={typographie(`Aller à l'acte : ${a.titre} (${a.dates})`)}>
            <span class="lecteur__rempli"></span>
          </button>
        ))}
      </div>
    </div>

    <div class="lecteur__controles">
      <div class="lecteur__groupe">
        <button type="button" class="lecteur__btn" data-action="precedent" aria-label="Diapositive précédente" title="Précédente (←)">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 5v14M19 5l-10 7 10 7z" /></svg>
        </button>
        <button type="button" class="lecteur__btn lecteur__btn--lecture" data-action="basculer" aria-label="Lecture" title="Lecture / pause (espace)">
          <svg class="icone-lecture" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4.5l13 7.5-13 7.5z" /></svg>
          <svg class="icone-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" /></svg>
        </button>
        <button type="button" class="lecteur__btn" data-action="suivant" aria-label="Diapositive suivante" title="Suivante (→)">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 5v14M5 5l10 7-10 7z" /></svg>
        </button>
      </div>
      <p class="lecteur__compteur" aria-live="polite"><span class="sr-only">Diapositive </span><span class="lecteur__n">1</span> / {d.diapositives.length}</p>
      <p class="lecteur__temps"><span class="lecteur__ecoule">0:00</span> / <span class="lecteur__total"></span></p>
      <div class="lecteur__groupe lecteur__groupe--options">
        {d.musique && (
          <span class="lecteur__reglage-musique">
            <button type="button" class="lecteur__option" data-action="musique" aria-pressed="true" title="Musique de fond (M)">Musique</button>
            <input type="range" class="lecteur__volume" min="0" max="100" step="5" value="80" aria-label="Volume de la musique de fond" title="Volume de la musique de fond" />
          </span>
        )}
        <button type="button" class="lecteur__option" data-action="sous-titres" aria-pressed="true" title="Sous-titres (S)">Sous-titres</button>
        <button type="button" class="lecteur__option" data-action="plein-ecran" title="Plein écran (F)">Plein écran</button>
      </div>
    </div>
    <audio class="lecteur__audio" preload="auto"></audio>
    <audio class="lecteur__suite" preload="auto"></audio>
  </div>

  <div class="livre">
    <p class="livre__note">{typographie('Le lecteur a besoin de JavaScript ; voici le diaporama sous forme de livre d\'images, avec le texte de la voix off.')}</p>
    {sectionsLivre.map((a) => (
      <section class="livre__acte">
        <h2>{t(a.titre)} <span class="livre__dates">{t(a.dates)}</span></h2>
        <ol start={a.debut}>
          {a.diapos.map((x) => (
            <li>
              <figure>
                <img src={urlMedia(d.slug, x.image.fichier)} alt={t(x.image.titre)} width={x.image.largeur} height={x.image.hauteur} loading="lazy" decoding="async" />
                <figcaption set:html={legende(x)} />
              </figure>
              {videoDe(x) && (
                <figure class="livre__apres livre__video">
                  <video src={urlMedia(d.slug, videoDe(x)!.fichier)} poster={urlMedia(d.slug, x.image.fichier)} width={videoDe(x)!.largeur} height={videoDe(x)!.hauteur} controls muted playsinline preload="none"></video>
                  <figcaption set:html={`<span class="livre__marque">Mise en mouvement par IA :</span> ${esc(t(`clip muet de ${Math.round(videoDe(x)!.duree)} s calculé d'après l'image ci-dessus par le modèle ${videoDe(x)!.modele} (poids ouverts) ; seul le document original fait foi.`))}`} />
                </figure>
              )}
              {x.image.apres && (
                <figure class="livre__apres">
                  <img src={urlMedia(d.slug, x.image.apres.fichier)} alt={t(x.image.apres.titre)} width={x.image.apres.largeur} height={x.image.apres.hauteur} loading="lazy" decoding="async" />
                  <figcaption set:html={`<span class="livre__marque">Après :</span> ${legendeImage(x.image.apres)}`} />
                </figure>
              )}
              {(x.plans ?? []).map((p) => (
                <figure class="livre__apres">
                  <img src={urlMedia(d.slug, p.image.fichier)} alt={t(p.image.titre)} width={p.image.largeur} height={p.image.hauteur} loading="lazy" decoding="async" />
                  <figcaption set:html={`<span class="livre__marque">Puis :</span> ${legendeImage(p.image)}`} />
                </figure>
              ))}
              {x.mosaique && (
                <div class="livre__mosaique">
                  <p class="livre__marque">{t(x.mosaique.legende)}</p>
                  <ul>
                    {x.mosaique.vignettes.filter((_, k) => k !== x.mosaique!.principale).map((v) => (
                      <li><figure>
                        <img src={urlMedia(d.slug, v.fichier ?? x.image.fichier)} alt={t(v.titre ?? '')} width={v.largeur} height={v.hauteur} loading="lazy" decoding="async" />
                        <figcaption set:html={legendeImage(v)} />
                      </figure></li>
                    ))}
                  </ul>
                </div>
              )}
              <p>{t(x.narration)}</p>
              {intermedeApres.has(x.n) && (
                <div class="livre__chant">
                  <p class="livre__chant-titre" set:html={`${intermedeApres.get(x.n)!.instrumental ? 'Intermède musical' : 'Intermède chanté'} : ${cartoucheChant(intermedeApres.get(x.n)!).replace(/<span[^>]*>/g, ' — ').replace(/<\/span>/g, '')}`} />
                  {intermedeApres.get(x.n)!.paroles.length > 0 && <p class="livre__paroles">{intermedeApres.get(x.n)!.paroles.map(([, v], k) => <Fragment>{k > 0 && <br />}{t(v)}</Fragment>)}</p>}
                  {(intermedeApres.get(x.n)!.galerie ?? []).length > 0 && (
                    <div class="livre__mosaique">
                      <p class="livre__marque">{t(intermedeApres.get(x.n)!.theme ?? 'Images montrées pendant la musique')}</p>
                      <ul>{intermedeApres.get(x.n)!.galerie!.map((g) => (
                        <li><figure>
                          <img src={urlMedia(d.slug, g.image.fichier)} alt={t(g.image.titre)} width={g.image.largeur} height={g.image.hauteur} loading="lazy" decoding="async" />
                          <figcaption set:html={legendeImage(g.image)} />
                        </figure></li>
                      ))}</ul>
                    </div>
                  )}
                </div>
              )}
              {lectureApres.has(x.n) && (
                <div class="livre__lecture">
                  <p class="livre__segment-titre">Lecture</p>
                  <CarteCitation lecture={lectureApres.get(x.n)!} portrait={portraitDe(lectureApres.get(x.n)!)} mode="livre" />
                  {(lectureApres.get(x.n)!.images ?? []).length > 0 && (
                    <div class="livre__mosaique">
                      <p class="livre__marque">Images montrées pendant la lecture</p>
                      <ul>{lectureApres.get(x.n)!.images!.map((g) => (
                        <li><figure>
                          <img src={urlMedia(d.slug, g.image.fichier)} alt={t(g.image.titre)} width={g.image.largeur} height={g.image.hauteur} loading="lazy" decoding="async" />
                          <figcaption set:html={legendeImage(g.image)} />
                        </figure></li>
                      ))}</ul>
                    </div>
                  )}
                </div>
              )}
              {episodeApres.has(x.n) && (() => {
                const e = episodeApres.get(x.n)!;
                return (
                  <section class="livre__episode">
                    <h3 class="livre__segment-titre">Épisode · {t(e.titre)}</h3>
                    <p>{t(e.narration)}</p>
                    <EpisodeVisuels episode={e} slug={d.slug} fonds={fonds} mode="livre" />
                    <p class="livre__sources">{t(`Sources : ${e.sources.join(' ; ')}.`)}</p>
                  </section>
                );
              })()}
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>
</div>

<script>
  // Lecteur : modules dans src/scripts/diaporama/ (carte : scripts/diaporamas/README.md,
  // « Lecteur : carte des modules »).
  import '../scripts/diaporama/lecteur';
</script>

<style>
  .diaporama { margin-top: var(--e-3); }

  /* Sans JavaScript : le livre d'images ; avec : le lecteur. */
  .diaporama:not(.avec-js) .lecteur { display: none; }
  .diaporama.avec-js .livre { display: none; }

  .lecteur { position: relative; display: flex; flex-direction: column; background: var(--c-fond); }
  .lecteur__acte {
    margin: 0 0 var(--e-2);
    font-variant: small-caps;
    letter-spacing: 0.1em;
    color: var(--c-texte-doux);
    text-align: center;
    min-height: 1.6em;
  }
  .lecteur__acte-dates { font-variant: normal; font-variant-numeric: oldstyle-nums; letter-spacing: 0; }
  .lecteur__acte-dates::before { content: '· '; }
  .lecteur__acte-dates:empty { display: none; }

  /* Scène : fond blanc cassé à peine plus soutenu, filet fin, pas de noir de cinéma. */
  .lecteur__scene {
    position: relative;
    /* La scène et ses commandes tiennent dans la fenêtre une fois le lecteur en haut. */
    height: clamp(260px, calc(100vh - 310px), 720px);
    height: clamp(260px, calc(100svh - 310px), 720px);
    background: #f1efea;
    border: 1px solid var(--c-filet);
    overflow: hidden;
    touch-action: pan-y;
    /* Marges des cartouches du haut, reprises par toutes les surimpressions de coin (spec 12,
       « Marges des surimpressions du bas ») : à gauche et à droite, et depuis le bas de l'image. */
    --marge-x: var(--e-2);
    --marge-y: var(--e-2);
  }
  .lecteur__calque {
    position: absolute;
    inset: 0;
    margin: auto;
    overflow: hidden;
    opacity: 0;
  }
  /* Opacité, filtre et transformation sont ensuite posés à chaque image par le script
     (fondu enchaîné, révélation gris → couleur, recul d'entrée, caméra). */
  .lecteur__calque.est-visible { opacity: 1; }
  .lecteur__calque img {
    display: block;
    position: absolute;
    left: 0;
    top: 0;
    max-width: none;
    transform-origin: 0 0;
    will-change: transform, filter;
  }

  /* Avant / après : l'image après, au-dessus de l'image avant, découverte par un volet (clip-path
     posé par le script) dont le bord est une ligne verticale fine (blanc cassé bordé de gris). */
  .lecteur__calque :global(.lecteur__apres) { position: absolute; inset: 0; overflow: hidden; }
  .lecteur__calque :global(.lecteur__plans) { position: absolute; inset: 0; overflow: hidden; }
  /* Image mise en mouvement par IA (spec 16) : la boîte du clip a la taille de l'image et reçoit sa
     transformation (mouvement.ts) ; le clip, étiré sur la zone utile, entre en fondu une fois
     l'entrée de l'image finie (`est-vivante`, FONDU_CLIP) et s'efface de même sous un plan. */
  .lecteur__calque :global(.lecteur__video) { position: absolute; left: 0; top: 0; transform-origin: 0 0; opacity: 0; will-change: transform, opacity; }
  .lecteur__calque :global(.lecteur__video.est-vivante) { opacity: 1; }
  .lecteur__calque :global(.lecteur__video) { transition: opacity 1.2s ease; }
  .lecteur__calque :global(.lecteur__video video) { display: block; position: absolute; max-width: none; object-fit: fill; background: transparent; }
  .lecteur__calque :global(.lecteur__plans img) { will-change: transform, opacity; }
  .lecteur__calque :global(.lecteur__plans img), .lecteur__calque :global(.lecteur__apres img), .lecteur__calque :global(.mosaique img) {
    display: block;
    position: absolute;
    left: 0;
    top: 0;
    max-width: none;
    transform-origin: 0 0;
    will-change: transform;
  }
  /* Image entière d'une série (drapeau `image.entier`) : fond noir sous l'image, même fondu. */
  .lecteur__calque :global(.lecteur__noir) { position: absolute; inset: 0; background: #000; will-change: opacity; }
  .lecteur__calque :global(.lecteur__trait) {
    position: absolute;
    top: 0;
    bottom: 0;
    left: -2px;
    width: 1px;
    background: rgba(251, 250, 247, 0.95);
    border-left: 1px solid rgba(26, 26, 26, 0.4);
    will-change: transform;
  }
  /* Mosaïque : grille de vignettes (fins filets de papier entre les cases), transformée en bloc
     pendant la plongée ; la case de l'image principale passe au-dessus et s'agrandit. */
  .lecteur__calque :global(.mosaique) { position: absolute; left: 0; top: 0; width: 100%; height: 100%; transform-origin: 0 0; will-change: transform; }
  .lecteur__calque :global(.tuile) { position: absolute; overflow: hidden; transform-origin: 50% 50%; }
  .lecteur__calque :global(.tuile--principale) { z-index: 1; }
  .lecteur__calque :global([hidden]) { display: none; }

  .lecteur__depart {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--e-2);
    background: rgba(251, 250, 247, 0.55);
  }
  .lecteur__depart[hidden] { display: none; }
  .lecteur__bouton-depart {
    font: inherit;
    font-size: 1.15rem;
    font-variant: small-caps;
    letter-spacing: 0.08em;
    min-height: 44px;
    padding: var(--e-2) var(--e-4);
    color: var(--c-texte);
    background: var(--c-fond);
    border: 1px solid var(--c-texte);
    border-radius: 0;
    cursor: pointer;
  }
  .lecteur__bouton-depart:hover { text-decoration: underline; text-underline-offset: 0.2em; }
  .lecteur__reprendre { border-color: var(--c-texte-doux); color: var(--c-texte-doux); font-size: 1rem; }
  .lecteur__bouton-depart:focus-visible, .lecteur__btn:focus-visible, .lecteur__option:focus-visible,
  .lecteur__segment:focus-visible { outline: 1px solid var(--c-texte); outline-offset: 2px; }

  /* Légende de notice et sous-titre. */
  /* Cartouche en haut à gauche de l'image : titre, auteur, date. */
  .lecteur__legende {
    position: absolute;
    top: var(--marge-y);
    left: var(--marge-x);
    z-index: 1;
    max-width: min(26rem, 45%);
    margin: 0;
    padding: 0.4rem 0.75rem 0.45rem;
    background: rgba(251, 250, 247, 0.95);
    border: 1px solid rgba(26, 26, 26, 0.22);
    line-height: 1.35;
    pointer-events: none;
    /* Entrée décalée : fondu et petit glissement ~0,6 s après l'image ; sortie en fondu court
       (copie temporaire de l'ancien cartouche). */
    opacity: 0;
    transform: translateY(-6px);
  }
  .lecteur__legende.est-visible {
    opacity: 1;
    transform: none;
    transition: opacity 600ms ease 600ms, transform 700ms cubic-bezier(0.2, 0.6, 0.3, 1) 600ms;
  }
  .lecteur__legende.lecteur__legende--sortant { opacity: 0; transform: none; transition: opacity 300ms ease; }
  @media (prefers-reduced-motion: reduce) {
    .lecteur__legende { transform: none; }
    .lecteur__legende.est-visible { transition: opacity 200ms ease 150ms; }
    .lecteur__legende.lecteur__legende--sortant { transition-duration: 150ms; }
  }

  /* Cartouche de la musique de fond, en haut à droite : même famille que celui de l'image
     (deux lignes, aucune troncature) ; l'interprète n'apparaît qu'au survol. */
  .lecteur__musique {
    position: absolute;
    top: var(--marge-y);
    right: var(--marge-x);
    z-index: 1;
    max-width: min(24rem, 40%);
    margin: 0;
    padding: 0.4rem 0.75rem 0.45rem;
    background: rgba(251, 250, 247, 0.95);
    border: 1px solid rgba(26, 26, 26, 0.22);
    line-height: 1.35;
    text-align: right;
    color: #3a3a3a;
    hyphens: none;
    -webkit-hyphens: none;
    opacity: 0;
    transform: translateY(-6px);
    transition: opacity 400ms ease, transform 400ms ease;
  }
  .lecteur__musique.est-visible {
    opacity: 1;
    transform: none;
    transition: opacity 700ms ease 300ms, transform 800ms cubic-bezier(0.2, 0.6, 0.3, 1) 300ms;
  }
  .lecteur__musique :global(.m-ligne) { display: block; }
  .lecteur__musique :global(.m-ligne)::before { content: '♪ '; color: var(--c-texte); }
  .lecteur__musique :global(cite) { font-style: italic; font-size: 1rem; color: var(--c-texte); }
  .lecteur__musique :global(.m-auteur) { display: block; font-size: 0.85rem; font-variant: small-caps; letter-spacing: 0.03em; }
  .lecteur__musique :global(.m-voix) { display: none; font-style: italic; font-size: 0.8rem; }
  .lecteur__musique:hover :global(.m-voix) { display: block; }
  @media (prefers-reduced-motion: reduce) {
    .lecteur__musique, .lecteur__musique.est-visible { transform: none; transition: opacity 200ms ease; }
  }

  /* Estompage : ~12 s après chaque changement, les deux cartouches disparaissent en fondu
     lent ; le survol de leur coin (zone invisible un peu plus large, active même cachés : un
     élément d'opacité 0 reçoit toujours le pointeur), la pause ou un toucher sur l'image
     (téléphone) les ramènent. */
  .lecteur__legende, .lecteur__musique { pointer-events: auto; hyphens: none; -webkit-hyphens: none; }
  .lecteur__legende.est-visible::before, .lecteur__musique.est-visible::before {
    content: '';
    position: absolute;
