    .diaporama .frise-t--surimpression, .diaporama .frise-t--surimpression.est-visible {
      transform: translate(-50%, 0);
      transition: opacity 200ms ease, visibility 0s linear 200ms;
    }
    .diaporama .frise-t--surimpression.est-visible { transition: opacity 200ms ease, visibility 0s; }
