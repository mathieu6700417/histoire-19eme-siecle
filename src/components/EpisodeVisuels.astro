---
// Visuels d'un épisode (spec 12, « Lectures d'époque et épisodes ») : cartons typographiques,
// chiffres, barres, courbe, carte et document d'époque surligné, tous monochromes, rendus en
// HTML/SVG à partir des données du JSON de la période.
//
// Synchronisation : chaque élément animé porte `data-t` (instant de départ, en secondes dans
// l'audio de l'épisode : le passage `quand` de la narration, situé dans sa phrase horodatée) et
// `data-d` (durée de l'animation). Le script de Diaporama.astro pose, d'après `audio.currentTime`,
// la variable CSS `--p` (0 → 1) sur chacun ; tout le rendu se règle sur `--p` : pause, reprise et
// sauts restent justes. Une courbe porte `data-trace` ([instant, fraction de l'axe], …) ; un
// document, `data-vues` (cadres de zoom successifs). En mode « livre » (sans JavaScript), tout est
// posé à `--p: 1` et les visuels sont empilés.
import { typographie } from '../utils/typographie.mjs';
import { bornesDate, instantPassage, urlCommons, urlMedia, type Episode, type FondCarte, type VisuelEpisode, type ElementCarte } from '../utils/diaporamas';

interface Props { episode: Episode; slug: string; fonds: Record<string, FondCarte>; mode: 'lecteur' | 'livre' }
const { episode: e, slug, fonds, mode } = Astro.props;
const t = (s?: string) => (s ? typographie(s.trim()) : '');
const duree = e.audio?.duree ?? 30;
/** Instant d'un passage de la narration (0 si absent ou non donné). */
const T = (q?: string, defaut = 0) => (q ? instantPassage(e.narration, q, duree, e.audio?.phrases) ?? defaut : defaut);
const r2 = (x: number) => Math.round(x * 100) / 100;

const debuts = e.visuels.map((v, k) => (k === 0 ? 0 : T(v.quand)));
/** Instant d'un élément : son passage, sinon un peu après l'entrée de son visuel (en cascade). */
const quandEl = (k: number, q: string | undefined, rang: number) => r2(q ? T(q, debuts[k] + 0.5) : debuts[k] + 0.5 + rang * 0.35);
const uid = `ep-${e.id}`;

// --- Courbe -----------------------------------------------------------------------------------
const C = { l: 64, r: 584, h: 34, b: 262, W: 600, H: 300 };
function courbe(v: Extract<VisuelEpisode, { type: 'courbe' }>, k: number) {
  const jours = v.points.map(([d]) => bornesDate(d)[0]);
  const a0 = new Date(Date.UTC(1970, 0, 1 + jours[0])).getUTCFullYear();
  const a1 = new Date(Date.UTC(1970, 0, 1 + jours.at(-1)!)).getUTCFullYear() + 1;
  const j0 = Date.UTC(a0, 0, 1) / 864e5, j1 = Date.UTC(a1, 0, 1) / 864e5;
  const X = (j: number) => C.l + ((j - j0) / (j1 - j0)) * (C.r - C.l);
  const Y = (y: number) => C.b - (y / v.ymax) * (C.b - C.h);
  const d = v.points.map(([, y], i) => `${i ? 'L' : 'M'}${X(jours[i]).toFixed(1)},${Y(y).toFixed(1)}`).join('');
  const frac = (j: number) => r2((X(j) - C.l) / (C.r - C.l));
  // Le tracé atteint chaque repère quand la voix le nomme ; puis il finit en 2 s.
  const trace: [number, number][] = [[r2(debuts[k] + 0.4), frac(jours[0])]];
  for (const rp of v.reperes) if (rp.quand) trace.push([T(rp.quand), frac(bornesDate(rp.date)[0])]);
  trace.sort((a, b) => a[0] - b[0]);
  trace.push([r2(trace.at(-1)![0] + 2), 1]);
  const annees = Array.from({ length: a1 - a0 + 1 }, (_, i) => a0 + i);
  return { d, X, Y, trace, annees, jours: (s: string) => bornesDate(s)[0], etiquettes: placerEtiquettes(v, X, Y, jours) };
}

// Étiquettes des repères (spec 12, « Graphiques des épisodes ») : « date · valeur en clair »
// (« janv. 1791 · 91,5 livres »), jamais de notation d'époque non expliquée ; placées
// automatiquement là où elles ne touchent ni la courbe, ni les axes, ni les autres repères.
const MOIS = ['janv.', 'févr.', 'mars', 'avr.', 'mai', 'juin', 'juil.', 'août', 'sept.', 'oct.', 'nov.', 'déc.'];
/** « janv. 1791 » (« 1791 » pour une année seule). */
function dateCourte(d: string) {
  const [a, m] = d.split('-');
  return m ? `${MOIS[Number(m) - 1]} ${a}` : a;
}
/** Valeur en clair : nombre à la française (une ou deux décimales au plus) et unité du point
 *  (`unite_point`, sinon le premier mot de `unite`). `libelle` du repère, s'il est donné, la
 *  remplace (formulation rédigée : « moins d'une demi-livre »). */
function valeurClaire(v: Extract<VisuelEpisode, { type: 'courbe' }>, y: number) {
  const unite = v.unite_point ?? v.unite.split(' ')[0];
  const n = Math.abs(y) >= 10 ? Math.round(y * 10) / 10 : Math.round(y * 100) / 100;
  return `${String(n).replace('.', ',')} ${unite}`;
}
const LARGEUR_CAR = 8.8, HAUT_TEXTE = 15, BAS_TEXTE = 5; // texte à 18 px (estimation prudente)
function placerEtiquettes(v: Extract<VisuelEpisode, { type: 'courbe' }>, X: (j: number) => number, Y: (y: number) => number, jours: number[]) {
  const pts = v.points.map(([, y], i) => [X(jours[i]), Y(y)] as [number, number]);
  const pris: [number, number, number, number][] = [];
  const reperes = v.reperes.map((rp) => {
    const y = v.points.find(([d]) => d === rp.date)?.[1] ?? 0;
    return { rp, x: X(bornesDate(rp.date)[0]), y: Y(y), texte: `${dateCourte(rp.date)} · ${rp.libelle ?? valeurClaire(v, y)}` };
  });
  // Un rectangle (marge de 4 px) touche-t-il la courbe, un repère ou une étiquette déjà posée ?
  const touche = ([x0, y0, x1, y1]: [number, number, number, number], soi: { x: number; y: number }) => {
    const a = [x0 - 4, y0 - 4, x1 + 4, y1 + 4];
    const dedans = (x: number, y: number) => x >= a[0] && x <= a[2] && y >= a[1] && y <= a[3];
    for (let i = 1; i < pts.length; i++) {
      const [p, q] = [pts[i - 1], pts[i]], n = Math.ceil(Math.hypot(q[0] - p[0], q[1] - p[1]) / 2) + 1;
      for (let k = 0; k <= n; k++) if (dedans(p[0] + ((q[0] - p[0]) * k) / n, p[1] + ((q[1] - p[1]) * k) / n)) return true;
    }
    for (const r of reperes) if (Math.abs(r.x - (x0 + x1) / 2) < (x1 - x0) / 2 + 8 && Math.abs(r.y - (y0 + y1) / 2) < (y1 - y0) / 2 + 8) return true;
    for (const b of pris) if (!(x1 + 6 < b[0] || x0 - 6 > b[2] || y1 + 4 < b[1] || y0 - 4 > b[3])) return true;
    return false;
  };
  return reperes.map((r) => {
    const l = r.texte.length * LARGEUR_CAR;
    // Positions candidates (décalage de la ligne de base, ancrage), de la plus naturelle à la plus lointaine.
    const essais: [number, number, 'start' | 'middle' | 'end'][] = [];
    // Au-delà de ~40 px, un filet relie l'étiquette à son point.
    for (let e = 0; e <= 200; e += 16) {
      essais.push([0, -14 - e, 'middle'], [0, 28 + e, 'middle'], [12, -12 - e, 'start'], [-12, -12 - e, 'end'],
        [12, 26 + e, 'start'], [-12, 26 + e, 'end'], [14 + e, 6, 'start'], [-14 - e, 6, 'end']);
    }
    let choix: [number, number, number, number, number, number, string] | null = null;
    for (const [dx, dy, ancre] of essais) {
      const bx = r.x + dx, by = r.y + dy;
      const x0 = ancre === 'start' ? bx : ancre === 'end' ? bx - l : bx - l / 2;
      const rect: [number, number, number, number] = [x0, by - HAUT_TEXTE, x0 + l, by + BAS_TEXTE];
      // Dans la zone du graphique : ni sur les graduations (gauche, bas), ni hors du cadre.
      if (rect[0] < C.l + 2 || rect[2] > C.W - 2 || rect[1] < 2 || rect[3] > C.b - 4) continue;
      if (touche(rect, r)) continue;
      choix = [bx, by, ...rect, ancre];
      break;
    }
    // Repli (aucune place libre) : au-dessus, ancré pour rester dans le cadre.
    if (!choix) {
      const ancre = r.x + l / 2 > C.W - 2 ? 'end' : r.x - l / 2 < C.l + 2 ? 'start' : 'middle';
      const x0 = ancre === 'start' ? r.x : ancre === 'end' ? r.x - l : r.x - l / 2;
      choix = [r.x, r.y - 16, x0, r.y - 31, x0 + l, r.y - 11, ancre];
    }
    pris.push([choix[2], choix[3], choix[4], choix[5]]);
    const loin = Math.abs(choix[1] - r.y) > 44;
    // Filet vertical du point vers le bord le plus proche de l'étiquette.
    const filet = loin ? (choix[1] < r.y ? [r.y - 8, choix[5] + 3] : [r.y + 8, choix[3] - 3]) : null;
    return { x: r.x, y: r.y, tx: choix[0], ty: choix[1], ancre: choix[6], texte: r.texte, rp: r.rp, filet };
  });
}

// --- Carte ------------------------------------------------------------------------------------
function projeter(f: FondCarte, [lon, lat]: [number, number]): [number, number] {
  const { cadre, echelle, cx } = f.projection;
  return [r2((lon - cadre[0]) * cx * echelle), r2((cadre[3] - lat) * echelle)];
}
/** Position d'une étiquette autour d'un point : décalage et ancrage du texte. */
function etiquette(p: [number, number], position = 'droite', ecart = 16) {
  const [x, y] = p;
  if (position === 'gauche') return { x: x - ecart, y: y + 10, ancre: 'end' };
  if (position === 'haut') return { x, y: y - ecart - 2, ancre: 'middle' };
  if (position === 'bas') return { x, y: y + ecart + 26, ancre: 'middle' };
  return { x: x + ecart, y: y + 10, ancre: 'start' };
}
function centre(pts: [number, number][]): [number, number] {
  return [pts.reduce((s, p) => s + p[0], 0) / pts.length, pts.reduce((s, p) => s + p[1], 0) / pts.length];
}
const fleche = (f: FondCarte, el: Extract<ElementCarte, { type: 'fleche' }>) => {
  const [x0, y0] = projeter(f, el.de), [x1, y1] = projeter(f, el.a);
  // Légère courbe (point de contrôle décalé perpendiculairement).
  const mx = (x0 + x1) / 2 - (y1 - y0) * 0.18, my = (y0 + y1) / 2 + (x1 - x0) * 0.18;
  // Pointe : triangle à l'arrivée, orienté selon la tangente (du point de contrôle à l'arrivée).
  const n = Math.hypot(x1 - mx, y1 - my) || 1, ux = (x1 - mx) / n, uy = (y1 - my) / n, L = 26, l = 13;
  const pointe = `M${(x1 + ux * 6).toFixed(1)},${(y1 + uy * 6).toFixed(1)} L${(x1 - ux * L + uy * l).toFixed(1)},${(y1 - uy * L - ux * l).toFixed(1)} L${(x1 - ux * L - uy * l).toFixed(1)},${(y1 - uy * L + ux * l).toFixed(1)}Z`;
  return { d: `M${x0},${y0} Q${mx.toFixed(1)},${my.toFixed(1)} ${x1},${y1}`, pointe, depart: [x0, y0] as [number, number] };
};

// --- Document ---------------------------------------------------------------------------------
/** Vue de zoom autour d'une ligne : le cadre élargi (contexte), assez grand pour rester net. */
function vue([x0, y0, x1, y1]: [number, number, number, number], ratio: number): [number, number, number, number] {
  let w = Math.max(0.42, (x1 - x0) * 1.5), h = Math.max((y1 - y0) * 3, w * ratio * 0.62);
  w = Math.min(1, w); h = Math.min(1, h);
  const cx = (x0 + x1) / 2, cy = (y0 + y1) / 2;
  const a = Math.min(1 - w, Math.max(0, cx - w / 2)), b = Math.min(1 - h, Math.max(0, cy - h / 2));
  return [r2(a), r2(b), r2(a + w), r2(b + h)].map((x) => Math.round(x * 1000) / 1000) as [number, number, number, number];
}
const statique = mode === 'livre';
---

<div class={`episode episode--${mode}`} data-episode={e.id} aria-hidden={mode === 'lecteur' ? 'true' : undefined}>
  {mode === 'lecteur' && <p class="episode__titre"><span class="episode__marque">Épisode</span> {t(e.titre)}</p>}
  <div class="episode__visuels">
    {e.visuels.map((v, k) => (
      <div class={`ev ev--${v.type}${k === 0 && statique ? ' est-actif' : ''}`} data-t={debuts[k]}>
        {v.type === 'carton' && (
          <div class="ev-carton">
            <p class="ev-carton__texte anim" data-t={r2(debuts[k] + 0.1)} data-d="1.2">{t(v.texte)}</p>
            <span class="ev-carton__filet anim" data-t={r2(debuts[k] + 0.4)} data-d="1"></span>
            {v.sous && <p class="ev-carton__sous anim" data-t={r2(debuts[k] + 0.7)} data-d="1">{t(v.sous)}</p>}
          </div>
        )}

        {v.type === 'chiffres' && (
          <Fragment>
            {v.titre && <p class="ev-titre">{t(v.titre)}</p>}
            <div class={`ev-chiffres ev-chiffres--${v.items.length}`}>
              {v.items.map((it, j) => (
                <div class={`ev-chiffre anim${it.accent ? ' est-accent' : ''}${it.valeur.length > 8 ? ' est-long' : ''}`} data-t={quandEl(k, it.quand, j)} data-d="1">
                  <span class="ev-chiffre__valeur">{t(it.valeur)}</span>
                  {it.unite && <span class="ev-chiffre__unite">{t(it.unite)}</span>}
                  <span class="ev-chiffre__libelle">{t(it.libelle)}</span>
                </div>
              ))}
            </div>
            {v.source && <p class="ev-source">{t(`Source : ${v.source}`)}</p>}
          </Fragment>
        )}

        {v.type === 'barres' && (
          <Fragment>
            <p class="ev-titre">{t(v.titre)} <span class="ev-titre__unite">{t(`en ${v.unite === '%' ? 'pourcentage' : v.unite}`)}</span></p>
            <div class="ev-barres">
              {v.barres.map((b, j) => (
                <div class={`ev-barre anim${b.accent ? ' est-accent' : ''}`} data-t={quandEl(k, b.quand, j)} data-d="1.2" style={`--v:${(b.valeur / v.max).toFixed(4)}`}>
                  <span class="ev-barre__libelle">{t(b.libelle)}</span>
                  <span class="ev-barre__piste"><span class="ev-barre__rempli"></span></span>
                  <span class="ev-barre__valeur">{t(b.affichage ?? String(b.valeur))}{b.note && <Fragment> <em>{t(b.note)}</em></Fragment>}</span>
                </div>
              ))}
            </div>
            <p class="ev-source">{t(`Source : ${v.source}`)}</p>
          </Fragment>
        )}

        {v.type === 'courbe' && (() => {
          const c = courbe(v, k);
          return (
            <Fragment>
              <p class="ev-titre">{t(v.titre)} <span class="ev-titre__unite">{t(`en ${v.unite}`)}</span></p>
              <svg class="ev-courbe" viewBox={`0 0 ${C.W} ${C.H}`} role="img" aria-label={t(v.titre)}>
                <defs><clipPath id={`${uid}-trace-${k}`}><rect class="ev-courbe__masque" x={C.l - 6} y="0" height={C.H} width={statique ? C.r - C.l + 12 : 0} data-l={C.r - C.l + 12} data-trace={statique ? undefined : JSON.stringify(c.trace)} /></clipPath></defs>
                {[0, 25, 50, 75, 100].filter((y) => y <= v.ymax).map((y) => (
                  <g class="ev-courbe__grille"><line x1={C.l} x2={C.r} y1={c.Y(y)} y2={c.Y(y)} /><text x={C.l - 10} y={c.Y(y) + 6} text-anchor="end">{y}</text></g>
                ))}
                {c.annees.map((a, i) => (
                  <g class="ev-courbe__axe">
                    <line x1={c.X(Date.UTC(a, 0, 1) / 864e5)} x2={c.X(Date.UTC(a, 0, 1) / 864e5)} y1={C.b} y2={C.b + 7} />
                    {i < c.annees.length - 1 && <text x={c.X(Date.UTC(a, 6, 1) / 864e5)} y={C.b + 28} text-anchor="middle">{a}</text>}
                  </g>
                ))}
                <path class="ev-courbe__ligne" d={c.d} clip-path={`url(#${uid}-trace-${k})`} />
                {c.etiquettes.map((et, j) => (
                  <g class="ev-courbe__repere anim" data-t={quandEl(k, et.rp.quand, j)} data-d="0.8">
                    {et.filet && <line class="ev-courbe__filet" x1={et.x} x2={et.x} y1={et.filet[0].toFixed(1)} y2={et.filet[1].toFixed(1)} />}
                    <circle cx={et.x} cy={et.y} r="5" />
                    <text x={et.tx.toFixed(1)} y={et.ty.toFixed(1)} text-anchor={et.ancre}>{t(et.texte)}</text>
                  </g>
                ))}
              </svg>
              <p class="ev-source">{t(`Source : ${v.source}`)}</p>
            </Fragment>
          );
        })()}

        {v.type === 'carte' && (() => {
          const f = fonds[v.fond];
          if (!f) return null;
          return (
            <Fragment>
              <p class="ev-titre">{t(v.titre)}</p>
              <div class="ev-carte">
                <svg class="ev-carte__svg" viewBox={`0 0 ${f.largeur} ${f.hauteur}`} role="img" aria-label={t(v.titre)}>
                  <defs>
                    <pattern id={`${uid}-hachures`} width="14" height="14" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><line x1="0" y1="0" x2="0" y2="14" /></pattern>
                  </defs>
                  <path class="ev-carte__terres" d={f.terres} />
                  <path class="ev-carte__france" d={f.france} />
                  {f.fleuves.map((d) => <path class="ev-carte__fleuve" d={d} />)}
                  {v.elements.map((el, j) => {
                    const tj = quandEl(k, el.quand, j);
                    if (el.type === 'zone') {
                      const pts = el.points.map((p) => projeter(f, p));
                      const [cx, cy] = centre(pts);
                      return (
                        <g class="ev-carte__zone anim" data-t={tj} data-d="1.2">
                          <path d={`M${pts.map((p) => p.join(',')).join(' L')}Z`} fill={`url(#${uid}-hachures)`} />
                          <text x={cx} y={cy + 70} text-anchor="middle">{t(el.libelle)}</text>
                        </g>
                      );
                    }
                    if (el.type === 'fleche') {
                      const fl = fleche(f, el);
                      const et = etiquette(fl.depart, el.position ?? 'haut', 14);
                      return (
                        <g class="ev-carte__fleche anim" data-t={tj} data-d="1.4">
                          <path class="ev-carte__trait" d={fl.d} pathLength="1" />
                          <path class="ev-carte__pointe" d={fl.pointe} />
                          <text x={et.x} y={et.y} text-anchor={et.ancre}>{t(el.libelle)}</text>
                        </g>
                      );
                    }
                    const p = projeter(f, el.lieu);
                    const et = etiquette(p, el.position);
                    return (
                      <g class={`ev-carte__ville anim${el.capitale ? ' est-capitale' : ''}${el.rebelle ? ' est-rebelle' : ''}`} data-t={tj} data-d="0.7">
                        {el.capitale ? <rect x={p[0] - 7} y={p[1] - 7} width="14" height="14" /> : <circle cx={p[0]} cy={p[1]} r={el.rebelle ? 10 : 7} />}
                        <text x={et.x} y={et.y} text-anchor={et.ancre}>{t(el.libelle)}</text>
                      </g>
                    );
                  })}
                </svg>
                {v.legende && (
                  <ul class="ev-carte__legende">
                    {v.legende.map(([cle, lib]) => <li><span class={`ev-signe ev-signe--${cle}`}></span>{t(lib)}</li>)}
                  </ul>
                )}
              </div>
              <p class="ev-source">{t(`${v.source}`)}</p>
            </Fragment>
          );
        })()}

        {v.type === 'document' && (() => {
          const i = v.image;
          const L = i.largeur ?? 1000, H = i.hauteur ?? 1300;
          const vues = v.lignes.map((l, j) => [quandEl(k, l.quand, j), ...vue(l.cadre, H / L)]);
          return (
            <Fragment>
              <div class="ev-doc" data-vues={statique ? undefined : JSON.stringify(vues)} data-l={L} data-h={H}>
                <div class="ev-doc__page" style={`aspect-ratio:${L}/${H}`}>
                  <img src={urlMedia(slug, i.fichier)} alt={t(i.titre)} width={L} height={H} loading="lazy" decoding="async" />
                  {v.lignes.map((l, j) => (
                    <span class="ev-doc__surligne anim" data-t={quandEl(k, l.quand, j)} data-d="1.4"
                      style={`left:${(l.cadre[0] * 100).toFixed(2)}%;top:${(l.cadre[1] * 100).toFixed(2)}%;width:${((l.cadre[2] - l.cadre[0]) * 100).toFixed(2)}%;height:${((l.cadre[3] - l.cadre[1]) * 100).toFixed(2)}%`}></span>
                  ))}
                </div>
              </div>
              <p class="ev-source">{t(`${i.titre}, ${i.auteur}, ${i.date}, ${i.conservation}.`)} <a href={urlCommons(i.commons)} rel="noopener" target="_blank">Commons</a></p>
              {statique && (
                <ul class="ev-doc__lignes">{v.lignes.map((l) => <li>« {t(l.texte)} »</li>)}</ul>
              )}
            </Fragment>
          );
        })()}
      </div>
    ))}
  </div>
</div>

<style>
  /* Tout est monochrome : noir, gris, blanc cassé ; hachures et styles de trait. Les animations
     se règlent sur --p (0 → 1), posé par le script du lecteur. */
  .episode { --p-defaut: 0; }
  .episode--lecteur {
    position: absolute;
    inset: 0;
    z-index: 2;
    container-type: size;
    display: flex;
    flex-direction: column;
    padding: 0.6rem max(var(--e-3), 4cqw) max(0.5rem, calc(var(--frise-bas, 0px) + 0.4rem));
    background: var(--c-fond);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 600ms ease, visibility 0s linear 600ms;
