---
// Visuels d'un épisode (spec 12, « Lectures d'époque et épisodes ») : cartons typographiques,
// chiffres, barres, courbe, carte, chronologie et document d'époque surligné, tous monochromes, rendus en
// HTML/SVG à partir des données du JSON de la période.
//
// Synchronisation : chaque élément animé porte `data-t` (instant de départ, en secondes dans
// l'audio de l'épisode : le passage `quand` de la narration, situé dans sa phrase horodatée) et
// `data-d` (durée de l'animation). Le script de Diaporama.astro pose, d'après `audio.currentTime`,
// la variable CSS `--p` (0 → 1) sur chacun ; tout le rendu se règle sur `--p` : pause, reprise et
// sauts restent justes. Une courbe porte `data-trace` ([instant, fraction de l'axe], …) ; un
// document, `data-vues` (cadres de zoom successifs). En mode « livre » (sans JavaScript), tout est
// posé à `--p: 1` et les visuels sont empilés.
import { typographie } from '../utils/typographie.mjs';
import { bornesDate, libelleDate, instantPassage, urlCommons, urlMedia, type Episode, type FondCarte, type VisuelEpisode, type ElementCarte } from '../utils/diaporamas';

interface Props { episode: Episode; slug: string; fonds: Record<string, FondCarte>; mode: 'lecteur' | 'livre' }
const { episode: e, slug, fonds, mode } = Astro.props;
const t = (s?: string) => (s ? typographie(s.trim()) : '');
const duree = e.audio?.duree ?? 30;
/** Instant d'un passage de la narration (0 si absent ou non donné). */
const T = (q?: string, defaut = 0) => (q ? instantPassage(e.narration, q, duree, e.audio?.phrases) ?? defaut : defaut);
const r2 = (x: number) => Math.round(x * 100) / 100;

const debuts = e.visuels.map((v, k) => (k === 0 ? 0 : T(v.quand)));
/** Instant d'un élément : son passage, sinon un peu après l'entrée de son visuel (en cascade). */
const quandEl = (k: number, q: string | undefined, rang: number) => r2(q ? T(q, debuts[k] + 0.5) : debuts[k] + 0.5 + rang * 0.35);
const uid = `ep-${e.id}`;

// --- Courbe -----------------------------------------------------------------------------------
const C = { l: 64, r: 584, h: 34, b: 262, W: 600, H: 300 };
function courbe(v: Extract<VisuelEpisode, { type: 'courbe' }>, k: number) {
  const jours = v.points.map(([d]) => bornesDate(d)[0]);
  const a0 = new Date(Date.UTC(1970, 0, 1 + jours[0])).getUTCFullYear();
  const a1 = new Date(Date.UTC(1970, 0, 1 + jours.at(-1)!)).getUTCFullYear() + 1;
  const j0 = Date.UTC(a0, 0, 1) / 864e5, j1 = Date.UTC(a1, 0, 1) / 864e5;
  const X = (j: number) => C.l + ((j - j0) / (j1 - j0)) * (C.r - C.l);
  const Y = (y: number) => C.b - (y / v.ymax) * (C.b - C.h);
  const d = v.points.map(([, y], i) => `${i ? 'L' : 'M'}${X(jours[i]).toFixed(1)},${Y(y).toFixed(1)}`).join('');
  const frac = (j: number) => r2((X(j) - C.l) / (C.r - C.l));
  // Le tracé atteint chaque repère quand la voix le nomme ; puis il finit en 2 s.
  const trace: [number, number][] = [[r2(debuts[k] + 0.4), frac(jours[0])]];
  for (const rp of v.reperes) if (rp.quand) trace.push([T(rp.quand), frac(bornesDate(rp.date)[0])]);
  trace.sort((a, b) => a[0] - b[0]);
  trace.push([r2(trace.at(-1)![0] + 2), 1]);
  const annees = Array.from({ length: a1 - a0 + 1 }, (_, i) => a0 + i);
  return { d, X, Y, trace, annees, jours: (s: string) => bornesDate(s)[0], etiquettes: placerEtiquettes(v, X, Y, jours) };
}

// Étiquettes des repères (spec 12, « Graphiques des épisodes ») : « date · valeur en clair »
// (« janv. 1791 · 91,5 livres »), jamais de notation d'époque non expliquée ; placées
// automatiquement là où elles ne touchent ni la courbe, ni les axes, ni les autres repères.
const MOIS = ['janv.', 'févr.', 'mars', 'avr.', 'mai', 'juin', 'juil.', 'août', 'sept.', 'oct.', 'nov.', 'déc.'];
/** « janv. 1791 » (« 1791 » pour une année seule). */
function dateCourte(d: string) {
  const [a, m] = d.split('-');
  return m ? `${MOIS[Number(m) - 1]} ${a}` : a;
}
/** Valeur en clair : nombre à la française (une ou deux décimales au plus) et unité du point
 *  (`unite_point`, sinon le premier mot de `unite`). `libelle` du repère, s'il est donné, la
 *  remplace (formulation rédigée : « moins d'une demi-livre »). */
function valeurClaire(v: Extract<VisuelEpisode, { type: 'courbe' }>, y: number) {
  const unite = v.unite_point ?? v.unite.split(' ')[0];
  const n = Math.abs(y) >= 10 ? Math.round(y * 10) / 10 : Math.round(y * 100) / 100;
  return `${String(n).replace('.', ',')} ${unite}`;
}
const LARGEUR_CAR = 8.8, HAUT_TEXTE = 15, BAS_TEXTE = 5; // texte à 18 px (estimation prudente)
function placerEtiquettes(v: Extract<VisuelEpisode, { type: 'courbe' }>, X: (j: number) => number, Y: (y: number) => number, jours: number[]) {
  const pts = v.points.map(([, y], i) => [X(jours[i]), Y(y)] as [number, number]);
  const pris: [number, number, number, number][] = [];
  const reperes = v.reperes.map((rp) => {
    const y = v.points.find(([d]) => d === rp.date)?.[1] ?? 0;
    return { rp, x: X(bornesDate(rp.date)[0]), y: Y(y), texte: `${dateCourte(rp.date)} · ${rp.libelle ?? valeurClaire(v, y)}` };
  });
  // Un rectangle (marge de 4 px) touche-t-il la courbe, un repère ou une étiquette déjà posée ?
  const touche = ([x0, y0, x1, y1]: [number, number, number, number], soi: { x: number; y: number }) => {
    const a = [x0 - 4, y0 - 4, x1 + 4, y1 + 4];
    const dedans = (x: number, y: number) => x >= a[0] && x <= a[2] && y >= a[1] && y <= a[3];
    for (let i = 1; i < pts.length; i++) {
      const [p, q] = [pts[i - 1], pts[i]], n = Math.ceil(Math.hypot(q[0] - p[0], q[1] - p[1]) / 2) + 1;
      for (let k = 0; k <= n; k++) if (dedans(p[0] + ((q[0] - p[0]) * k) / n, p[1] + ((q[1] - p[1]) * k) / n)) return true;
    }
    for (const r of reperes) if (Math.abs(r.x - (x0 + x1) / 2) < (x1 - x0) / 2 + 8 && Math.abs(r.y - (y0 + y1) / 2) < (y1 - y0) / 2 + 8) return true;
    for (const b of pris) if (!(x1 + 6 < b[0] || x0 - 6 > b[2] || y1 + 4 < b[1] || y0 - 4 > b[3])) return true;
    return false;
  };
  return reperes.map((r) => {
    const l = r.texte.length * LARGEUR_CAR;
    // Positions candidates (décalage de la ligne de base, ancrage), de la plus naturelle à la plus lointaine.
    const essais: [number, number, 'start' | 'middle' | 'end'][] = [];
    // Au-delà de ~40 px, un filet relie l'étiquette à son point.
    for (let e = 0; e <= 200; e += 16) {
      essais.push([0, -14 - e, 'middle'], [0, 28 + e, 'middle'], [12, -12 - e, 'start'], [-12, -12 - e, 'end'],
        [12, 26 + e, 'start'], [-12, 26 + e, 'end'], [14 + e, 6, 'start'], [-14 - e, 6, 'end']);
    }
    let choix: [number, number, number, number, number, number, string] | null = null;
    for (const [dx, dy, ancre] of essais) {
      const bx = r.x + dx, by = r.y + dy;
      const x0 = ancre === 'start' ? bx : ancre === 'end' ? bx - l : bx - l / 2;
      const rect: [number, number, number, number] = [x0, by - HAUT_TEXTE, x0 + l, by + BAS_TEXTE];
      // Dans la zone du graphique : ni sur les graduations (gauche, bas), ni hors du cadre.
      if (rect[0] < C.l + 2 || rect[2] > C.W - 2 || rect[1] < 2 || rect[3] > C.b - 4) continue;
      if (touche(rect, r)) continue;
      choix = [bx, by, ...rect, ancre];
      break;
    }
    // Repli (aucune place libre) : au-dessus, ancré pour rester dans le cadre.
    if (!choix) {
      const ancre = r.x + l / 2 > C.W - 2 ? 'end' : r.x - l / 2 < C.l + 2 ? 'start' : 'middle';
      const x0 = ancre === 'start' ? r.x : ancre === 'end' ? r.x - l : r.x - l / 2;
      choix = [r.x, r.y - 16, x0, r.y - 31, x0 + l, r.y - 11, ancre];
    }
    pris.push([choix[2], choix[3], choix[4], choix[5]]);
    const loin = Math.abs(choix[1] - r.y) > 44;
    // Filet vertical du point vers le bord le plus proche de l'étiquette.
    const filet = loin ? (choix[1] < r.y ? [r.y - 8, choix[5] + 3] : [r.y + 8, choix[3] - 3]) : null;
    return { x: r.x, y: r.y, tx: choix[0], ty: choix[1], ancre: choix[6], texte: r.texte, rp: r.rp, filet };
  });
}

// --- Carte ------------------------------------------------------------------------------------
function projeter(f: FondCarte, [lon, lat]: [number, number]): [number, number] {
  const { cadre, echelle, cx } = f.projection;
  return [r2((lon - cadre[0]) * cx * echelle), r2((cadre[3] - lat) * echelle)];
}
/** Position d'une étiquette autour d'un point : décalage et ancrage du texte. */
function etiquette(p: [number, number], position = 'droite', ecart = 16, k = 1) {
  const [x, y] = p;
  if (position === 'gauche') return { x: r2(x - ecart), y: r2(y + 10 * k), ancre: 'end' };
  if (position === 'haut') return { x, y: r2(y - ecart - 2 * k), ancre: 'middle' };
  if (position === 'bas') return { x, y: r2(y + ecart + 26 * k), ancre: 'middle' };
  return { x: r2(x + ecart), y: r2(y + 10 * k), ancre: 'start' };
}
/** Fenêtre de la carte (viewBox) : le fond entier ou le recadrage `cadre` [lon0, lat0, lon1, lat1],
 *  et `k`, rapport de taille à l'écran (libellés et traits gardent leur taille apparente). */
function fenetre(f: FondCarte, cadre?: [number, number, number, number]) {
  if (!cadre) return { vb: `0 0 ${f.largeur} ${f.hauteur}`, k: 1 };
  const [x0, y0] = projeter(f, [cadre[0], cadre[3]]), [x1, y1] = projeter(f, [cadre[2], cadre[1]]);
  return { vb: `${x0} ${y0} ${r2(x1 - x0)} ${r2(y1 - y0)}`, k: r2(Math.max((x1 - x0) / f.largeur, (y1 - y0) / f.hauteur)) };
}
const anneau = (f: FondCarte, r: [number, number][]) => `M${r.map((p) => projeter(f, p).join(',')).join(' L')}Z`;
/** Libellé sur plusieurs lignes (`\n`), centré verticalement sur le point. */
function lignes(x: number, y: number, texte: string, hl = 1.1) {
  const ls = texte.split('\n');
  return ls.map((l, i) => ({ x, dy: i === 0 ? `${r2(-(ls.length - 1) * hl / 2 + 0.35)}em` : `${hl}em`, l }));
}
function centre(pts: [number, number][]): [number, number] {
  return [pts.reduce((s, p) => s + p[0], 0) / pts.length, pts.reduce((s, p) => s + p[1], 0) / pts.length];
}
const fleche = (f: FondCarte, el: Extract<ElementCarte, { type: 'fleche' }>, k = 1) => {
  const [x0, y0] = projeter(f, el.de), [x1, y1] = projeter(f, el.a);
  // Légère courbe (point de contrôle décalé perpendiculairement).
  const mx = (x0 + x1) / 2 - (y1 - y0) * 0.18, my = (y0 + y1) / 2 + (x1 - x0) * 0.18;
  // Pointe : triangle à l'arrivée, orienté selon la tangente (du point de contrôle à l'arrivée).
  // Pointe à taille d'écran constante : réduite comme les libellés sur une carte recadrée (k).
  const n = Math.hypot(x1 - mx, y1 - my) || 1, ux = (x1 - mx) / n, uy = (y1 - my) / n, L = 26 * k, l = 13 * k;
  const pointe = `M${(x1 + ux * 6 * k).toFixed(1)},${(y1 + uy * 6 * k).toFixed(1)} L${(x1 - ux * L + uy * l).toFixed(1)},${(y1 - uy * L - ux * l).toFixed(1)} L${(x1 - ux * L - uy * l).toFixed(1)},${(y1 - uy * L + ux * l).toFixed(1)}Z`;
  return { d: `M${x0},${y0} Q${mx.toFixed(1)},${my.toFixed(1)} ${x1},${y1}`, pointe, depart: [x0, y0] as [number, number] };
};

// --- Document ---------------------------------------------------------------------------------
/** Vue de zoom autour d'une ligne : le cadre élargi (contexte), assez grand pour rester net. */
function vue([x0, y0, x1, y1]: [number, number, number, number], ratio: number): [number, number, number, number] {
  let w = Math.max(0.42, (x1 - x0) * 1.5), h = Math.max((y1 - y0) * 3, w * ratio * 0.62);
  w = Math.min(1, w); h = Math.min(1, h);
  const cx = (x0 + x1) / 2, cy = (y0 + y1) / 2;
  const a = Math.min(1 - w, Math.max(0, cx - w / 2)), b = Math.min(1 - h, Math.max(0, cy - h / 2));
  return [r2(a), r2(b), r2(a + w), r2(b + h)].map((x) => Math.round(x * 1000) / 1000) as [number, number, number, number];
}

// --- Chronologie (spec 12, « Chronologie animée ») ------------------------------------------
// Positions en % de la boîte de la frise, calculées ici une fois pour deux mises en page :
// horizontale (ordinateur : axe au milieu, bulles alternées au-dessus et au-dessous, sur deux
// rangs de chaque côté, jamais l'une sur l'autre) et verticale (téléphone : axe à gauche, bulles
// à droite, empilées au plus près de leur date). Les connecteurs sont des lignes SVG (viewBox
// 0 0 100 100 étirée) ; le curseur suit `data-trace` ([instant, fraction de la frise], …).
const CH = { h0: 4, h1: 96, axe: 50, larg: 20, bords: { haut: [42, 19], bas: [58, 81] }, v0: 4, v1: 96, vx: 11, vbx: 19, haut: 14, ecart: 1.2 };
function chrono(v: Extract<VisuelEpisode, { type: 'chronologie' }>, k: number) {
  const d0 = bornesDate(v.debut)[0], d1 = bornesDate(v.fin)[1] + 1;
  const f = (d: string) => Math.min(1, Math.max(0, (bornesDate(d)[0] - d0) / (d1 - d0)));
  const a0 = Number(v.debut.slice(0, 4)), a1 = Number(v.fin.slice(0, 4)) + 1;
  const graduations = [] as { f: number; annee: number; bout: boolean }[];
  for (let a = a0; a <= a1; a++) {
    const x = f(`${a}-01-01`);
    if (bornesDate(`${a}-01-01`)[0] >= d0 && bornesDate(`${a}-01-01`)[0] <= d1) graduations.push({ f: r2(x), annee: a, bout: false });
  }
  if (graduations.length) { graduations[0].bout = true; graduations[graduations.length - 1].bout = true; }
  const ev = v.evenements.map((e, j) => ({ ...e, f: f(e.date), t: quandEl(k, e.quand, j) }));
  // Horizontal : premier emplacement libre, côté alterné d'abord, rang 0 puis 1, puis l'autre côté.
  const poses: { cote: 'haut' | 'bas'; rang: number; x: number }[] = [];
  const hz = ev.map((e, j) => {
    const x = CH.h0 + (CH.h1 - CH.h0) * e.f;
    const xc = Math.min(100 - CH.larg / 2 - 0.5, Math.max(CH.larg / 2 + 0.5, x));
    const prefere = j % 2 === 0 ? 'haut' : 'bas', autre = prefere === 'haut' ? 'bas' : 'haut';
    const essais = [[prefere, 0], [autre, 0], [prefere, 1], [autre, 1]] as ['haut' | 'bas', number][];
    const libre = essais.find(([c, r]) => !poses.some((p) => p.cote === c && p.rang === r && Math.abs(p.x - xc) < CH.larg + 1)) ?? essais[3];
    poses.push({ cote: libre[0], rang: libre[1], x: xc });
    const y = CH.bords[libre[0]][libre[1]];
    return { x: r2(x), xc: r2(xc), y, cote: libre[0] };
  });
  // Vertical : bulles empilées au plus près de leur date, sans se toucher, dans la boîte.
  const vy = ev.map((e) => CH.v0 + (CH.v1 - CH.v0) * e.f);
  const hautes = vy.map((y) => y - CH.haut / 2);
  for (let j = 0; j < hautes.length; j++) hautes[j] = Math.max(hautes[j], 0, j ? hautes[j - 1] + CH.haut + CH.ecart : 0);
  for (let j = hautes.length - 1; j >= 0; j--) hautes[j] = Math.min(hautes[j], (j < hautes.length - 1 ? hautes[j + 1] - CH.ecart : 100) - CH.haut);
  const vt = ev.map((_, j) => ({ y: r2(vy[j]), top: r2(hautes[j]), milieu: r2(hautes[j] + CH.haut / 2) }));
  // Curseur : du début de la frise, il glisse en 1 s vers chaque date quand la bulle paraît.
  const trace: [number, number][] = [[0, 0]];
  ev.forEach((e) => { const prec = trace[trace.length - 1][1]; trace.push([Math.max(e.t, trace[trace.length - 1][0]), prec], [r2(Math.max(e.t, trace[trace.length - 1][0]) + 1), r2(e.f)]); });
  return { ev, hz, vt, graduations, trace };
}
const statique = mode === 'livre';
---

<div class={`episode episode--${mode}`} data-episode={e.id} aria-hidden={mode === 'lecteur' ? 'true' : undefined}>
  {mode === 'lecteur' && <p class="episode__titre"><span class="episode__marque">Épisode</span> {t(e.titre)}</p>}
  <div class="episode__visuels">
    {e.visuels.map((v, k) => (
      <div class={`ev ev--${v.type}${k === 0 && statique ? ' est-actif' : ''}`} data-t={debuts[k]}>
        {v.type === 'carton' && (
          <div class="ev-carton">
            <p class="ev-carton__texte anim" data-t={r2(debuts[k] + 0.1)} data-d="1.2">{t(v.texte)}</p>
            <span class="ev-carton__filet anim" data-t={r2(debuts[k] + 0.4)} data-d="1"></span>
            {v.sous && <p class="ev-carton__sous anim" data-t={r2(debuts[k] + 0.7)} data-d="1">{t(v.sous)}</p>}
          </div>
        )}

        {v.type === 'chiffres' && (
          <Fragment>
            {v.titre && <p class="ev-titre">{t(v.titre)}</p>}
            <div class={`ev-chiffres ev-chiffres--${v.items.length}`}>
              {v.items.map((it, j) => (
                <div class={`ev-chiffre anim${it.accent ? ' est-accent' : ''}${it.valeur.length > 8 ? ' est-long' : ''}`} data-t={quandEl(k, it.quand, j)} data-d="1">
                  <span class="ev-chiffre__valeur">{t(it.valeur)}</span>
                  {it.unite && <span class="ev-chiffre__unite">{t(it.unite)}</span>}
                  <span class="ev-chiffre__libelle">{t(it.libelle)}</span>
                </div>
              ))}
            </div>
            {v.source && <p class="ev-source">{t(`Source : ${v.source}`)}</p>}
          </Fragment>
        )}

        {v.type === 'barres' && (
          <Fragment>
            <p class="ev-titre">{t(v.titre)} <span class="ev-titre__unite">{t(`en ${v.unite === '%' ? 'pourcentage' : v.unite}`)}</span></p>
            <div class="ev-barres">
              {v.barres.map((b, j) => (
                <div class={`ev-barre anim${b.accent ? ' est-accent' : ''}`} data-t={quandEl(k, b.quand, j)} data-d="1.2" style={`--v:${(b.valeur / v.max).toFixed(4)}`}>
                  <span class="ev-barre__libelle">{t(b.libelle)}</span>
                  <span class="ev-barre__piste"><span class="ev-barre__rempli"></span></span>
                  <span class="ev-barre__valeur">{t(b.affichage ?? String(b.valeur))}{b.note && <Fragment> <em>{t(b.note)}</em></Fragment>}</span>
                </div>
              ))}
            </div>
            <p class="ev-source">{t(`Source : ${v.source}`)}</p>
          </Fragment>
        )}

        {v.type === 'courbe' && (() => {
          const c = courbe(v, k);
          return (
            <Fragment>
              <p class="ev-titre">{t(v.titre)} <span class="ev-titre__unite">{t(`en ${v.unite}`)}</span></p>
              <svg class="ev-courbe" viewBox={`0 0 ${C.W} ${C.H}`} role="img" aria-label={t(v.titre)}>
                <defs><clipPath id={`${uid}-trace-${k}`}><rect class="ev-courbe__masque" x={C.l - 6} y="0" height={C.H} width={statique ? C.r - C.l + 12 : 0} data-l={C.r - C.l + 12} data-trace={statique ? undefined : JSON.stringify(c.trace)} /></clipPath></defs>
                {[0, 25, 50, 75, 100].filter((y) => y <= v.ymax).map((y) => (
                  <g class="ev-courbe__grille"><line x1={C.l} x2={C.r} y1={c.Y(y)} y2={c.Y(y)} /><text x={C.l - 10} y={c.Y(y) + 6} text-anchor="end">{y}</text></g>
                ))}
                {c.annees.map((a, i) => (
                  <g class="ev-courbe__axe">
                    <line x1={c.X(Date.UTC(a, 0, 1) / 864e5)} x2={c.X(Date.UTC(a, 0, 1) / 864e5)} y1={C.b} y2={C.b + 7} />
                    {i < c.annees.length - 1 && <text x={c.X(Date.UTC(a, 6, 1) / 864e5)} y={C.b + 28} text-anchor="middle">{a}</text>}
                  </g>
                ))}
                <path class="ev-courbe__ligne" d={c.d} clip-path={`url(#${uid}-trace-${k})`} />
                {c.etiquettes.map((et, j) => (
                  <g class="ev-courbe__repere anim" data-t={quandEl(k, et.rp.quand, j)} data-d="0.8">
                    {et.filet && <line class="ev-courbe__filet" x1={et.x} x2={et.x} y1={et.filet[0].toFixed(1)} y2={et.filet[1].toFixed(1)} />}
                    <circle cx={et.x} cy={et.y} r="5" />
                    <text x={et.tx.toFixed(1)} y={et.ty.toFixed(1)} text-anchor={et.ancre}>{t(et.texte)}</text>
                  </g>
                ))}
              </svg>
              <p class="ev-source">{t(`Source : ${v.source}`)}</p>
            </Fragment>
          );
        })()}

        {v.type === 'carte' && (() => {
          const f = fonds[v.fond];
          if (!f) return null;
          const fen = fenetre(f, v.cadre);
          return (
            <Fragment>
              <p class="ev-titre">{t(v.titre)}</p>
              <div class="ev-carte">
                <svg class={`ev-carte__svg${v.cadre ? ' est-recadree' : ''}`} viewBox={fen.vb} style={`--k:${fen.k}`} role="img" aria-label={t(v.titre)}>
                  <defs>
                    <pattern id={`${uid}-hachures-${k}`} width={r2(14 * fen.k)} height={r2(14 * fen.k)} patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><line x1="0" y1="0" x2="0" y2={r2(14 * fen.k)} /></pattern>
                    <clipPath id={`${uid}-terres-${k}`}><path d={f.terres} /></clipPath>
                  </defs>
                  <path class="ev-carte__terres" d={f.terres} />
                  <path class="ev-carte__france" d={f.france} />
                  {f.fleuves.map((d) => <path class="ev-carte__fleuve" d={d} />)}
                  {v.elements.map((el, j) => {
                    const tj = quandEl(k, el.quand, j);
                    if (el.type === 'zone') {
                      // Plusieurs anneaux possibles (`parties`), découpés sur les terres : les points en
                      // mer peuvent rester larges.
                      const parties = el.parties ?? (el.points ? [el.points] : []);
                      const style = el.style ?? 'hachures';
                      const [cx, cy] = el.etiquette ? projeter(f, el.etiquette) : (() => { const c = centre(parties[0].map((p) => projeter(f, p))); return [c[0], c[1] + 70 * fen.k]; })();
                      return (
                        <g class={`ev-carte__zone est-${style} anim`} data-t={tj} data-d="1.2">
                          <path d={parties.map((r) => anneau(f, r)).join(' ')} clip-path={`url(#${uid}-terres-${k})`} fill={style === 'hachures' ? `url(#${uid}-hachures-${k})` : undefined} />
                          {el.libelle && <text x={r2(cx)} y={r2(cy)} text-anchor="middle">{lignes(r2(cx), r2(cy), t(el.libelle)).map((x) => <tspan x={x.x} dy={x.dy}>{x.l}</tspan>)}</text>}
                        </g>
                      );
                    }
                    if (el.type === 'trait') {
                      const et = el.etiquette && projeter(f, el.etiquette);
                      return (
                        <g class="ev-carte__fleuve-nomme anim" data-t={tj} data-d="1.6">
                          <path class="ev-carte__trace" d={`M${el.points.map((p) => projeter(f, p).join(',')).join(' L')}`} pathLength="1" />
                          {el.libelle && et && <text x={et[0]} y={et[1]} text-anchor="middle">{t(el.libelle)}</text>}
                        </g>
                      );
                    }
                    if (el.type === 'fleche') {
                      const fl = fleche(f, el, fen.k);
                      const et = etiquette(fl.depart, el.position ?? 'haut', 14 * fen.k);
                      return (
                        <g class="ev-carte__fleche anim" data-t={tj} data-d="1.4">
                          <path class="ev-carte__trait" d={fl.d} pathLength="1" />
                          <path class="ev-carte__pointe" d={fl.pointe} />
                          <text x={et.x} y={et.y} text-anchor={et.ancre}>{t(el.libelle)}</text>
                        </g>
                      );
                    }
                    const p = projeter(f, el.lieu);
                    const et = etiquette(p, el.position, 16 * fen.k, fen.k);
                    const m = 7 * fen.k;
                    return (
                      <g class={`ev-carte__ville anim${el.capitale ? ' est-capitale' : ''}${el.rebelle ? ' est-rebelle' : ''}`} data-t={tj} data-d="0.7">
                        {el.capitale ? <rect x={r2(p[0] - m)} y={r2(p[1] - m)} width={r2(2 * m)} height={r2(2 * m)} /> : <circle cx={p[0]} cy={p[1]} r={r2((el.rebelle ? 10 : 7) * fen.k)} />}
                        <text x={et.x} y={et.y} text-anchor={et.ancre}>{t(el.libelle)}</text>
                      </g>
                    );
                  })}
                </svg>
                {v.legende && (
                  <ul class="ev-carte__legende">
                    {v.legende.map(([cle, lib]) => <li><span class={`ev-signe ev-signe--${cle}`}></span>{t(lib)}</li>)}
                  </ul>
                )}
              </div>
              <p class="ev-source">{t(`${v.source}`)}</p>
            </Fragment>
          );
        })()}

        {v.type === 'chronologie' && (() => {
          const c = chrono(v, k);
          const n = c.ev.length;
          return (
            <Fragment>
              {v.titre && <p class="ev-titre">{t(v.titre)}</p>}
              <div class="ev-chrono" role="img" aria-label={t(v.titre ?? 'Chronologie')}>
                <span class="ev-chrono__axe"></span>
                {c.graduations.map((g) => (
                  <span class={`ev-chrono__grad${g.bout ? ' est-bout' : ''}`} style={`--f:${g.f}`}>{g.bout && <span class="ev-chrono__annee">{g.annee}</span>}</span>
                ))}
                <svg class="ev-chrono__liens ev-chrono__liens--h" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                  {c.ev.map((e, j) => <line class="anim" data-t={e.t} data-d="0.8" x1={c.hz[j].x} y1={CH.axe} x2={c.hz[j].xc} y2={c.hz[j].y} />)}
                </svg>
                <svg class="ev-chrono__liens ev-chrono__liens--v" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                  {c.ev.map((e, j) => <line class="anim" data-t={e.t} data-d="0.8" x1={CH.vx} y1={c.vt[j].y} x2={CH.vbx} y2={c.vt[j].milieu} />)}
                </svg>
                {c.ev.map((e, j) => (
                  <span class="ev-chrono__point anim" data-t={e.t} data-d="0.6" style={`--f:${r2(e.f)}`}></span>
                ))}
                {c.ev.map((e, j) => (
                  <div class={`ev-chrono__bulle est-${c.hz[j].cote} anim`} data-t={e.t} data-d="0.8"
                    style={`--hx:${c.hz[j].xc};--hy:${c.hz[j].y};--vy:${c.vt[j].top}`}>
                    <div class="ev-chrono__corps anim" data-t={j < n - 1 ? c.ev[j + 1].t : 99999} data-d="0.6">
                      <span class="ev-chrono__date">{t(libelleDate(e.date.slice(0, 7)))}</span>
                      <span class="ev-chrono__libelle">{t(e.libelle)}</span>
                      {e.precision && <span class="ev-chrono__precision">{t(e.precision)}</span>}
                    </div>
                  </div>
                ))}
                {!statique && <span class="ev-chrono__curseur" data-trace={JSON.stringify(c.trace)} data-l="1"></span>}
              </div>
              <p class="ev-source">{t(`Source : ${v.source}`)}</p>
            </Fragment>
          );
        })()}

        {v.type === 'image' && (() => {
          const i = v.image;
          // Zoom lent sur toute la durée du panneau (jusqu'au visuel suivant, ou la fin de l'épisode).
          const fin = k + 1 < e.visuels.length ? debuts[k + 1] : duree;
          return (
            <Fragment>
              <figure class="ev-image">
                <img class="anim" data-t={debuts[k]} data-d={r2(Math.max(4, fin - debuts[k] + 1))} src={urlMedia(slug, i.fichier)} alt={t(i.titre)}
                  width={i.largeur} height={i.hauteur} loading="lazy" decoding="async" style={`object-position:${v.position ?? '50% 35%'}`} />
              </figure>
              <p class="ev-source">{v.legende && <Fragment>{t(v.legende)}{' '}</Fragment>}{t(`${[i.auteur, i.titre_court || i.titre, i.date, i.technique].filter(Boolean).join(', ')}.${i.conservation ? ` ${i.conservation}.` : ''}`)} <a href={urlCommons(i.commons)} rel="noopener" target="_blank">Commons</a></p>
            </Fragment>
          );
        })()}

        {v.type === 'document' && (() => {
          const i = v.image;
          const L = i.largeur ?? 1000, H = i.hauteur ?? 1300;
          const vues = v.lignes.map((l, j) => [quandEl(k, l.quand, j), ...vue(l.cadre, H / L)]);
          return (
            <Fragment>
              <div class="ev-doc" data-vues={statique ? undefined : JSON.stringify(vues)} data-l={L} data-h={H}>
                <div class="ev-doc__page" style={`aspect-ratio:${L}/${H}`}>
                  <img src={urlMedia(slug, i.fichier)} alt={t(i.titre)} width={L} height={H} loading="lazy" decoding="async" />
                  {v.lignes.map((l, j) => (
                    <span class="ev-doc__surligne anim" data-t={quandEl(k, l.quand, j)} data-d="1.4"
                      style={`left:${(l.cadre[0] * 100).toFixed(2)}%;top:${(l.cadre[1] * 100).toFixed(2)}%;width:${((l.cadre[2] - l.cadre[0]) * 100).toFixed(2)}%;height:${((l.cadre[3] - l.cadre[1]) * 100).toFixed(2)}%`}></span>
                  ))}
                </div>
              </div>
              <p class="ev-source">{t(`${i.titre}, ${i.auteur}, ${i.date}, ${i.conservation}.`)} <a href={urlCommons(i.commons)} rel="noopener" target="_blank">Commons</a></p>
              {statique && (
                <ul class="ev-doc__lignes">{v.lignes.map((l) => <li>« {t(l.texte)} »</li>)}</ul>
              )}
            </Fragment>
          );
        })()}
      </div>
    ))}
  </div>
</div>

<style>
  /* Tout est monochrome : noir, gris, blanc cassé ; hachures et styles de trait. Les animations
     se règlent sur --p (0 → 1), posé par le script du lecteur. */
  .episode { --p-defaut: 0; }
  .episode--lecteur {
    position: absolute;
    inset: 0;
    z-index: 2;
    container-type: size;
    display: flex;
    flex-direction: column;
    padding: 0.6rem max(var(--e-3), 4cqw) max(0.5rem, calc(var(--frise-bas, 0px) + 0.4rem));
    background: var(--c-fond);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 600ms ease, visibility 0s linear 600ms;
  }
  .episode--lecteur.est-visible { opacity: 1; visibility: visible; transition: opacity 600ms ease, visibility 0s; }
  .episode__titre {
    flex: none;
    margin: 0 auto;
    padding-bottom: 0.3rem;
    border-bottom: 1px solid var(--c-filet);
    font-variant: small-caps;
    letter-spacing: 0.1em;
    font-size: clamp(0.85rem, 2.4cqw, 1.15rem);
    text-align: center;
    color: var(--c-texte);
  }
  .episode__marque { color: var(--c-texte-doux); }
  .episode__marque::after { content: ' ·'; }
  .episode--lecteur .episode__visuels { position: relative; flex: 1; min-height: 0; margin-top: 0.4rem; }
  .episode--lecteur .ev {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 600ms ease;
  }
  .episode--lecteur .ev.est-actif { opacity: 1; }
  .episode--lecteur .ev--carte, .episode--lecteur .ev--courbe, .episode--lecteur .ev--document, .episode--lecteur .ev--image { justify-content: flex-start; }
  /* Image d'époque plein cadre (spec 14) : elle remplit le panneau, recadrée, avec un zoom très
     lent réglé sur --p ; sa notice dessous. Dans le livre : l'image entière, immobile. */
  .ev-image { margin: 0; width: 100%; }
  .ev-image img { display: block; width: 100%; height: auto; }
  .episode--lecteur .ev-image { flex: 1 1 0; min-height: 0; overflow: hidden; }
  .episode--lecteur .ev-image img { height: 100%; object-fit: cover; transform: scale(calc(1 + 0.07 * var(--p, 0))); transform-origin: 50% 40%; will-change: transform; }
  @media (prefers-reduced-motion: reduce) { .episode--lecteur .ev-image img { transform: none; } }
  @media (prefers-reduced-motion: reduce) { .episode--lecteur .ev, .episode--lecteur { transition-duration: 150ms; } }

  .anim { --p: var(--p-defaut); }
  .episode--livre .anim { --p: 1; }

  .ev-titre {
    margin: 0 0 0.7rem;
    font-size: clamp(0.95rem, 2.8cqw, 1.5rem);
    text-align: center;
    font-style: italic;
  }
  /* L'unité est dite une fois, sous le titre. */
  .ev-titre__unite { display: block; margin-top: 0.15em; font-style: normal; font-variant: small-caps; letter-spacing: 0.05em; color: var(--c-texte-doux); font-size: 0.85em; }
  .ev-source {
    flex: none;
    max-width: 46rem;
    margin: 0.5rem 0 0;
    font-size: clamp(0.68rem, 1.6cqw, 0.85rem);
    line-height: 1.3;
    hyphens: none;
    -webkit-hyphens: none;
    color: var(--c-texte-doux);
    text-align: center;
  }
  .ev-source a { color: inherit; }

  /* Carton typographique : comme une page de titre. */
  .ev-carton { text-align: center; }
  .ev-carton__texte {
    margin: 0;
    font-family: var(--f-titre);
    font-variant: small-caps;
    letter-spacing: 0.1em;
    font-size: clamp(1.4rem, 6cqw, 3rem);
    line-height: 1.2;
    opacity: var(--p);
    transform: translateY(calc((1 - var(--p)) * 6px));
  }
  .ev-carton__filet { display: block; width: 5rem; margin: 0.9rem auto; border-top: 1px solid var(--c-texte-doux); transform: scaleX(var(--p)); }
  .ev-carton__sous { margin: 0; font-style: italic; color: var(--c-texte-doux); font-size: clamp(0.95rem, 2.4cqw, 1.3rem); opacity: var(--p); }

  /* Gros chiffres. */
  .ev-chiffres { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.6rem clamp(1rem, 5cqw, 3.5rem); max-width: 100%; }
  .ev-chiffre {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 16rem;
    text-align: center;
    opacity: var(--p);
    transform: translateY(calc((1 - var(--p)) * 8px));
  }
  .ev-chiffre__valeur {
    font-family: var(--f-titre);
    font-size: clamp(1.8rem, 9cqw, 5rem);
    line-height: 1.05;
    font-variant-numeric: lining-nums;
    color: var(--c-texte-doux);
  }
  .ev-chiffre.est-accent .ev-chiffre__valeur { color: var(--c-texte); }
  .ev-chiffre.est-long { max-width: 22rem; }
  .ev-chiffre.est-long .ev-chiffre__valeur { font-size: clamp(1.4rem, 6cqw, 3.4rem); white-space: nowrap; }
  .ev-chiffre__unite { font-variant: small-caps; letter-spacing: 0.06em; color: var(--c-texte-doux); font-size: clamp(0.8rem, 2cqw, 1.1rem); }
  .ev-chiffre__libelle { font-size: clamp(0.85rem, 2.4cqw, 1.3rem); line-height: 1.3; }
  .ev-chiffre.est-accent .ev-chiffre__libelle { border-top: 1px solid var(--c-texte); padding-top: 0.15rem; }

  /* Barres horizontales : libellé, piste fine, barre grise (noire si accent), valeur. */
  .ev-barres { width: min(56rem, 100%); display: grid; gap: clamp(0.3rem, 2.4cqh, 1.1rem); }
  .ev-barre {
    display: grid;
    grid-template-columns: minmax(0, 17rem) minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.4rem 0.8rem;
    font-size: clamp(0.8rem, 2.4cqw, 1.3rem);
    opacity: calc(0.25 + 0.75 * min(1, var(--p) * 3));
  }
  .ev-barre__libelle { text-align: right; line-height: 1.2; }
  .ev-barre__piste { position: relative; height: clamp(0.8rem, 4.5cqh, 2rem); border-left: 1px solid var(--c-texte); }
  .ev-barre__rempli {
    position: absolute;
    inset: 0 auto 0 0;
    width: 100%;
    background: #8f8c85;
    transform-origin: 0 50%;
    transform: scaleX(calc(var(--v) * var(--p)));
  }
  .ev-barre.est-accent .ev-barre__rempli { background: var(--c-texte); }
  .ev-barre__valeur { min-width: 4.5em; font-variant-numeric: lining-nums tabular-nums; opacity: var(--p); white-space: nowrap; }
  .ev-barre__valeur em { color: var(--c-texte-doux); }

  /* Courbe : grille légère, axe des années, tracé noir qui se dessine (masque), repères. */
  .ev--courbe .ev-courbe { width: 100%; flex: 1 1 0; min-height: 0; overflow: visible; font-family: inherit; }
  .ev-courbe text { font-size: 17px; fill: var(--c-texte-doux); }
  .ev-courbe__grille line { stroke: #d6d3cc; stroke-width: 1; }
  .ev-courbe__axe line { stroke: var(--c-texte-doux); }
  .ev-courbe__ligne { fill: none; stroke: var(--c-texte); stroke-width: 2.5; stroke-linejoin: round; }
  .ev-courbe__repere { opacity: var(--p); }
  .ev-courbe__repere circle { fill: var(--c-fond); stroke: var(--c-texte); stroke-width: 2; }
  .ev-courbe__repere text { fill: var(--c-texte); font-size: 18px; }
  .ev-courbe__filet { stroke: var(--c-texte-doux); stroke-width: 1; }

  /* Carte : terres en gris très clair, France un peu plus soutenue ; zones hachurées, flèches
     en trait plein qui se dessinent, villes rebelles en points noirs cerclés. */
  .ev-carte { display: flex; align-items: center; justify-content: center; gap: 1rem; min-height: 0; flex: 1 1 0; width: 100%; }
  .ev-carte__svg { height: 100%; width: auto; max-width: 100%; min-height: 0; overflow: hidden; font-family: inherit; }
  .ev-carte__terres { fill: #ebe9e4; stroke: #c9c6bf; stroke-width: 1; }
  .ev-carte__france { fill: #dcd9d1; stroke: #5e5b55; stroke-width: 2.2; stroke-linejoin: round; }
  .ev-carte__fleuve { fill: none; stroke: #b4b1aa; stroke-width: 2; }
  .ev-carte__svg text { font-size: calc(38px * var(--k, 1)); fill: var(--c-texte); paint-order: stroke; stroke: rgba(251, 250, 247, 0.85); stroke-width: calc(6px * var(--k, 1)); stroke-linejoin: round; }
  .ev-carte__svg pattern line { stroke: #3d3b37; stroke-width: calc(2.5px * var(--k, 1)); }
  .ev-carte__zone { opacity: var(--p); }
  .ev-carte__zone path { stroke: #3d3b37; stroke-width: calc(2px * var(--k, 1)); stroke-dasharray: 6 5; }
  .ev-carte__zone text { font-style: italic; }
  /* Zones pleines (ex. l'Empire) et claires (États vassaux) : aplats sans contour pointillé,
     séparés par un filet de la couleur du papier. */
  .ev-carte__zone.est-plein path { fill: #55524c; stroke: var(--c-fond); stroke-width: calc(1.5px * var(--k, 1)); stroke-dasharray: none; }
  .ev-carte__zone.est-clair path { fill: #aeaba3; stroke: var(--c-fond); stroke-width: calc(1.5px * var(--k, 1)); stroke-dasharray: none; }
  .ev-carte__zone.est-hachures path { stroke-dasharray: calc(6px * var(--k, 1)) calc(5px * var(--k, 1)); }
  .ev-carte__svg.est-recadree .ev-carte__zone text { font-size: calc(34px * var(--k, 1)); letter-spacing: 0.02em; }
  /* Trait (fleuve nommé) : se dessine de la source à l'embouchure. */
  .ev-carte__trace { fill: none; stroke: var(--c-texte); stroke-width: calc(5px * var(--k, 1)); stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 1; stroke-dashoffset: calc(1 - var(--p)); }
  .ev-carte__fleuve-nomme text { font-style: italic; opacity: clamp(0, calc(var(--p) * 2 - 0.6), 1); }
  .ev-carte__trait { fill: none; stroke: var(--c-texte); stroke-width: calc(6px * var(--k, 1)); stroke-linecap: round; stroke-dasharray: 1; stroke-dashoffset: calc(1 - var(--p)); }
  .ev-carte__pointe { fill: var(--c-texte); opacity: clamp(0, calc((var(--p) - 0.85) * 7), 1); }
  .ev-carte__fleche text { opacity: var(--p); font-variant: small-caps; letter-spacing: 0.04em; }
  .ev-carte__ville { opacity: var(--p); }
  .ev-carte__ville circle, .ev-carte__ville rect { fill: var(--c-fond); stroke: var(--c-texte); stroke-width: calc(3px * var(--k, 1)); }
  .ev-carte__ville.est-rebelle circle { fill: var(--c-texte); stroke: var(--c-fond); stroke-width: calc(3px * var(--k, 1)); }
  .ev-carte__ville.est-capitale rect { fill: var(--c-texte); stroke: var(--c-fond); }
  .ev-carte__legende { flex: none; margin: 0; padding: 0; list-style: none; font-size: clamp(0.72rem, 1.8cqw, 0.9rem); color: var(--c-texte-doux); line-height: 1.8; }
  .ev-signe { display: inline-block; width: 1.4em; height: 0.8em; margin-right: 0.45em; vertical-align: -0.05em; }
  .ev-signe--fleche { height: 0; border-top: 3px solid var(--c-texte); vertical-align: 0.25em; }
  .ev-signe--rebelle { width: 0.75em; height: 0.75em; border-radius: 50%; background: var(--c-texte); margin-inline: 0.3em 0.8em; }
  .ev-signe--zone { border: 1px dashed #3d3b37; background: repeating-linear-gradient(45deg, #3d3b37 0 1.5px, transparent 1.5px 5px); }
  .ev-signe--plein { background: #55524c; }
  .ev-signe--clair { background: #aeaba3; }
  .ev-signe--trait { height: 0; border-top: 3px solid var(--c-texte); vertical-align: 0.25em; }

  /* Document d'époque : la page entière, puis un léger zoom sur la ligne lue, qui s'éclaire
