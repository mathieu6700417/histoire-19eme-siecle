---
// Cartes de lieu et citations en surimpression sur la scène du diaporama (spec 12, « Cartes de
// lieu et citations en surimpression », 2026-10-07). Rendu au build, caché ; le script de
// Diaporama.astro remplit et montre ces deux éléments d'après l'instant de l'audio.
//
// - Médaillon de lieu, en bas à droite : un fond par cadre employé dans la période (SVG Natural
//   Earth : France seule, voisins, Europe, monde ; la France en plus soutenu) ou le plan de Paris
//   d'époque (en gris, zoomé sur le lieu, crédité), un point qui pulse doucement, le nom en
//   petites capitales.
// - Citation : centrée dans le tiers inférieur, grand serif italique noir sur un voile blanc cassé
//   léger ; les mots (`.m`, rang `data-k`) s'inscrivent un à un au rythme de la voix, puis
//   l'auteur (« — Mirabeau », « — attribué à Danton »).
//
// Plusieurs lieux sur une diapositive (révision du 2026-10-08) : un seul médaillon, au cadre
// calculé qui les englobe (surimpressionsDe) ; le script ci-dessous, propre à ce composant, y pose
// un point et un nom par lieu, chaque point paraissant quand la voix dit son nom (les précédents
// restent), les noms placés sans se chevaucher (à droite, à gauche, au-dessus, en dessous, ou plus
// loin avec un filet). L'horloge est l'audio de la voix : pause, reprise et sauts restent justes.
//
// Portraits des personnes nommées (spec 12, 2026-10-08) : rangée d'ovales en bas à gauche
// (symétrique du médaillon de lieu), en couleur, bord fin, nom en petites capitales et dates
// dessous ; Diaporama.astro la remplit, la dimensionne (--ovale-h) et montre chaque ovale au nom.
//
// Objets de musée et manuscrits (spec 12, « Enrichissements visuels », 2026-10-08) : l'objet, détouré,
// est posé dans un coin bas (à droite par défaut) sur un cartouche blanc cassé à filet fin, légende
// courte dessous (objet ; date · musée) ; il entre en fondu avec une très légère montée. Le manuscrit
// se pose sur un côté, entre le cartouche et le bas réservé ; Diaporama.astro règle son zoom sur le
// passage et le halo (même effet que `ev-doc__surligne` des épisodes) d'après l'instant de l'audio.
//
// Chiffres clés et dates républicaines (spec 12, « Enrichissements visuels », point 4) : le chiffre,
// en grand serif à chiffres elzéviriens, centré dans le tiers inférieur sur un voile léger aux bords
// fondus, la prudence dite au-dessus (« plus de ») et l'unité en petites capitales dessous ; il
// défile jusqu'à sa valeur (Diaporama.astro). La date républicaine : un bandeau discret en petites
// capitales au bas de l'image, au centre (« 9 thermidor an II · 27 juillet 1794 »).
import type { Diaporama, FondCarte, PlanParis } from '../utils/diaporamas';
import { surimpressionsDe, urlMedia } from '../utils/diaporamas';
import { typographie } from '../utils/typographie.mjs';

interface Props { diaporama: Diaporama; fonds: Record<string, FondCarte>; plan?: PlanParis }
const { diaporama: d, fonds, plan } = Astro.props;
const employes = [...new Set(d.diapositives.flatMap((x) => (x.lieux ?? []).map((l) => l.fond)))];
const svgs = employes.filter((f) => f !== 'paris' && fonds[f]).map((f) => fonds[f]);
const urlPlan = plan ? urlMedia('fonds', plan.fichier.replace(/^fonds\//, '')) : '';
// Médaillons à plusieurs lieux, repérés par l'audio de la diapositive (ce que joue le lecteur).
const multiples: Record<string, { points: { nom: string; x: number; y: number; t: number }[]; vb?: string }> = {};
for (const x of d.diapositives) {
  if ((x.lieux?.length ?? 0) < 2 || !x.audio) continue;
  const L = surimpressionsDe(x, fonds, plan).lieu;
  if (L?.points?.length) multiples[urlMedia(d.slug, x.audio.fichier)] = { points: L.points.map((p) => ({ ...p, nom: typographie(p.nom) })), vb: L.vb };
}
---

{employes.length > 0 && (
  <div class="lieu" aria-hidden="true">
    <div class="lieu__carte">
      {svgs.map((f) => (
        <svg class="lieu__fond" data-fond={f.nom} viewBox={`0 0 ${f.largeur} ${f.hauteur}`} preserveAspectRatio="none">
          <path class="lieu__terres" d={f.terres} />
          <path class="lieu__france" d={f.france} />
          {f.fleuves.map((p) => <path class="lieu__fleuve" d={p} />)}
        </svg>
      ))}
      {plan && <div class="lieu__fond lieu__plan" data-fond="paris" data-src={urlPlan}></div>}
      <span class="lieu__point"></span>
    </div>
    <p class="lieu__nom"></p>
    <p class="lieu__credit"></p>
  </div>
)}
{Object.keys(multiples).length > 0 && (
  <script type="application/json" class="lieu__multiples" set:html={JSON.stringify(multiples).replace(/</g, '\\u003c')} />
)}
{d.diapositives.some((x) => x.personnes?.length) && <div class="portraits" aria-hidden="true"></div>}
{d.diapositives.some((x) => x.objets?.length) && (
  <figure class="objet" aria-hidden="true">
    <span class="objet__image"><img alt="" decoding="async" /></span>
    <figcaption><span class="objet__nom"></span><span class="objet__legende"></span></figcaption>
  </figure>
)}
{d.diapositives.some((x) => x.manuscrits?.length) && (
  <figure class="manuscrit" aria-hidden="true">
    <div class="manuscrit__page"><div class="manuscrit__doc"><img alt="" decoding="async" /><span class="manuscrit__halo"></span></div></div>
    <figcaption><span class="objet__nom"></span><span class="objet__legende"></span></figcaption>
  </figure>
)}
{d.diapositives.some((x) => x.chiffres?.length) && (
  <div class="chiffre" aria-hidden="true">
    <p class="chiffre__prefixe"></p>
    <p class="chiffre__nombre"><span class="chiffre__mesure"></span><span class="chiffre__valeur"></span></p>
    <p class="chiffre__unite"></p>
  </div>
)}
{d.diapositives.some((x) => x.dates_republicaines?.length) && (
  <p class="date-rep" aria-hidden="true"><span class="date-rep__rep"></span><span class="date-rep__sep"> · </span><span class="date-rep__greg"></span></p>
)}
{d.diapositives.some((x) => x.citations?.length) && (
  <div class="mots" aria-hidden="true">
    <p class="mots__texte"></p>
    <p class="mots__auteur"></p>
  </div>
)}

<style>
  /* Médaillon : blanc cassé presque opaque, filet fin (même famille que les cartouches). Taille
     posée par le script (~un quart de la hauteur de la scène). Marges : celles des cartouches du haut
     (--marge-x, --marge-y) ; au-dessus des bandeaux du bas visibles en plein écran (--surimp-bas). */
  .lieu {
    position: absolute;
    right: var(--marge-x, var(--e-2));
    bottom: calc(var(--surimp-bas, var(--frise-bas, 0px)) + var(--frise-pousse, 0px) + var(--marge-y, var(--e-2)));
    z-index: 2;
    padding: 0.3rem 0.3rem 0.25rem;
    background: rgba(251, 250, 247, 0.95);
    border: 1px solid rgba(26, 26, 26, 0.22);
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transform: translateY(4px);
    transition: opacity 600ms ease, transform 600ms ease, visibility 0s linear 600ms;
  }
  .lieu.est-visible {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition: opacity 500ms ease, transform 600ms cubic-bezier(0.2, 0.6, 0.3, 1), visibility 0s, bottom 500ms ease;
  }
  .lieu__carte { position: relative; overflow: hidden; width: 160px; height: 150px; background: var(--c-eau); }
  .lieu__fond { display: none; position: absolute; inset: 0; width: 100%; height: 100%; }
  .lieu__fond.est-actif { display: block; }
  .lieu__terres { fill: #e6e4de; stroke: #bdbab3; stroke-width: 1; vector-effect: non-scaling-stroke; }
  .lieu__france { fill: #cfccc4; stroke: #4a4843; stroke-width: 1.4; stroke-linejoin: round; vector-effect: non-scaling-stroke; }
  .lieu__fleuve { fill: none; stroke: var(--c-eau-trait); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .lieu__plan { background-repeat: no-repeat; background-color: #f6f5f1; } /* plan de Paris : papier, pas d'eau */
  /* Point : noir cerclé de blanc ; un anneau gris s'élargit et s'efface doucement. */
  .lieu__point {
    position: absolute;
    width: 9px;
    height: 9px;
    margin: -4.5px 0 0 -4.5px;
    border-radius: 50%;
    background: var(--c-texte);
    box-shadow: 0 0 0 2px var(--c-fond);
  }
  .lieu__point::after {
    content: '';
    position: absolute;
    inset: -2px;
    border-radius: 50%;
    border: 1.5px solid #555;
    animation: lieu-pouls 2s ease-out infinite;
  }
  @keyframes lieu-pouls { from { transform: scale(1); opacity: 0.9; } to { transform: scale(3.4); opacity: 0; } }
  .lieu__nom {
    margin: 0.2rem 0.1rem 0;
    max-width: 100%;
    font-size: 0.9rem;
    line-height: 1.2;
    font-variant: small-caps;
    letter-spacing: 0.05em;
    color: var(--c-texte);
    text-align: center;
    hyphens: none;
    -webkit-hyphens: none;
  }
  .lieu__credit { margin: 0; font-size: 0.68rem; font-style: normal; line-height: 1.2; color: #5a5853; text-align: center; }
  .lieu__credit:empty { display: none; }
  /* Plusieurs lieux : pas de nom sous la carte (les noms sont sur la carte), le point unique du
     lecteur cède la place aux points posés par le script. */
  .lieu__nom:empty { display: none; }
  .lieu.est-multiple .lieu__point { display: none; }
  .lieu :global(.lieu__pts) { position: absolute; inset: 0; pointer-events: none; }
  .lieu :global(.lieu__pt) {
    position: absolute;
    width: 7px;
    height: 7px;
    margin: -3.5px 0 0 -3.5px;
    border-radius: 50%;
    background: var(--c-texte);
    box-shadow: 0 0 0 1.5px var(--c-fond);
    opacity: 0;
    transform: scale(0.4);
    transition: opacity 350ms ease, transform 450ms cubic-bezier(0.2, 0.6, 0.3, 1);
  }
  .lieu :global(.lieu__pt.est-dit) { opacity: 1; transform: none; }
  /* Le dernier point dit pulse doucement ; les précédents restent fixes. */
  .lieu :global(.lieu__pt.est-dernier)::after {
    content: '';
    position: absolute;
    inset: -2px;
    border-radius: 50%;
    border: 1.5px solid #555;
    animation: lieu-pouls 2s ease-out infinite;
  }
  .lieu :global(.lieu__etiquette) {
    position: absolute;
    left: 0;
    top: 0;
    width: max-content;
    max-width: 8.5em;
    padding: 0 0.18em;
    font-size: 0.74rem;
    line-height: 1.08;
    font-variant: small-caps;
    letter-spacing: 0.03em;
    color: var(--c-texte);
    background: rgba(246, 245, 241, 0.82);
    text-wrap: balance;
    hyphens: none;
    -webkit-hyphens: none;
    opacity: 0;
    transition: opacity 350ms ease;
  }
  .lieu :global(.lieu__etiquette.est-dit), .lieu :global(.lieu__filet.est-dit) { opacity: 1; }
  .lieu :global(.lieu__filet) { position: absolute; height: 1px; background: #6a6862; transform-origin: 0 50%; opacity: 0; transition: opacity 350ms ease; }

  /* Portraits (révision du 2026-10-09) : rangée d'ovales posés directement sur l'image, sans
     cartouche, en bas à gauche ; sous chaque ovale, une petite étiquette blanc cassé serrée (nom en
     petites capitales, dates). La hauteur des ovales (--ovale-h) est posée par le lecteur. Tous les
     ovales sont en place dès l'entrée (invisibles) : la rangée ne change pas de taille quand un nom
     s'ajoute (place réservée constante) ; l'opacité de chacun est posée par le lecteur à chaque
     image. Images en couleur (exception des images du diaporama), le reste monochrome. */
  .portraits {
    --ovale-h: 96px;
    position: absolute;
    left: var(--marge-x, var(--e-2));
    bottom: calc(var(--surimp-bas, var(--frise-bas, 0px)) + var(--frise-pousse, 0px) + var(--marge-y, var(--e-2)));
    z-index: 2;
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transform: translateY(4px);
    transition: opacity 600ms ease, transform 600ms ease, visibility 0s linear 600ms;
  }
  .portraits:empty { display: none; }
  .portraits.est-visible {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition: opacity 500ms ease, transform 600ms cubic-bezier(0.2, 0.6, 0.3, 1), visibility 0s, bottom 500ms ease;
  }
  .portraits :global(.portrait) {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: max-content;
    max-width: max(calc(var(--ovale-h) * 0.8 + 1.4rem), 7em);
    opacity: 0;
  }
  /* Ovale à bord fin, façon camée : filet sombre, liseré clair, puis le visage. */
  .portraits :global(.portrait__ovale) {
    display: block;
    width: calc(var(--ovale-h) * 0.8);
    height: var(--ovale-h);
    border-radius: 50%;
    overflow: hidden;
    position: relative;
    border: 1px solid rgba(26, 26, 26, 0.6);
    background: #e6e4de;
  }
  .portraits :global(.portrait__ovale)::after { content: ''; position: absolute; inset: 0; border-radius: 50%; box-shadow: inset 0 0 0 2px rgba(251, 250, 247, 0.85); }
  .portraits :global(.portrait__ovale img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  /* Étiquette : juste sous l'ovale, aussi étroite que son texte, filet fin. */
  .portraits :global(figcaption) {
    margin-top: 0.2rem;
    padding: 0.08rem 0.4rem 0.1rem;
    background: rgba(251, 250, 247, 0.94);
    border: 1px solid rgba(26, 26, 26, 0.22);
    text-align: center;
    line-height: 1.12;
    color: var(--c-texte);
    hyphens: none;
    -webkit-hyphens: none;
    text-wrap: balance;
  }
  .portraits :global(.portrait__nom) { display: block; font-size: 0.86rem; font-variant: small-caps; letter-spacing: 0.04em; }
  .portraits :global(.portrait__sep) { display: none; }
  .portraits :global(.portrait__dates) { display: block; font-size: 0.74rem; color: #4a4843; font-variant-numeric: lining-nums; }
  /* Une seule personne : « Danton · 1759-1794 » sur une ligne si la place le permet. */
  .portraits.est-seul :global(.portrait) { max-width: max(calc(var(--ovale-h) * 0.8 + 6rem), 14em); }
  .portraits.est-seul :global(.portrait__nom), .portraits.est-seul :global(.portrait__sep), .portraits.est-seul :global(.portrait__dates) { display: inline; }
  .portraits.est-seul :global(.portrait__sep) { color: #4a4843; }

  /* Objet de musée (révision du 2026-10-08) : l'objet détouré est posé directement sur l'image, sans
     carte ni fond ; il s'en détache par un halo clair diffus et une ombre très douce (pas de contour
     net), la légende courte en dessous sur un voile léger. Taille posée par le lecteur (--objet-h,
     --objet-l). Entrée en fondu avec une très légère montée ; la place est réservée pour la caméra
     toute la diapositive. */
  .objet {
    --objet-h: 150px;
    --objet-l: 150px;
    position: absolute;
    right: var(--marge-x, var(--e-2));
    bottom: calc(var(--surimp-bas, var(--frise-bas, 0px)) + var(--frise-pousse, 0px) + var(--marge-y, var(--e-2)));
    z-index: 2;
    margin: 0;
    padding: 0;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition: opacity 600ms ease, transform 600ms ease, visibility 0s linear 600ms;
  }
  .objet.est-gauche { right: auto; left: var(--marge-x, var(--e-2)); }
  .objet.est-visible {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition: opacity 800ms ease, transform 1400ms cubic-bezier(0.2, 0.6, 0.3, 1), visibility 0s, bottom 500ms ease;
  }
  .objet__image { display: block; width: var(--objet-l); height: var(--objet-h); margin: 0 auto; }
  .objet__image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    /* Halo clair diffus puis ombre très douce : l'objet se lit sur une image claire comme sombre. */
    filter: drop-shadow(0 0 7px rgba(251, 250, 247, 0.75)) drop-shadow(0 3px 9px rgba(26, 26, 26, 0.35));
  }
  .objet figcaption {
    width: max-content;
    padding: 0.12rem 0.45rem 0.15rem;
    background: rgba(251, 250, 247, 0.82);
  }
  .objet figcaption, .manuscrit figcaption {
    max-width: max(var(--objet-l), 10em);
    margin: 0.3rem auto 0;
    text-align: center;
    line-height: 1.18;
    color: var(--c-texte);
    hyphens: none;
    -webkit-hyphens: none;
    text-wrap: balance;
  }
  .objet__nom { display: block; font-size: 0.8rem; font-style: normal; }
  .objet__legende { display: block; margin-top: 0.1rem; font-size: 0.72rem; font-variant: small-caps; letter-spacing: 0.04em; color: #4a4843; }

  /* Manuscrit : la page entière sur un cartouche à filet fin, sur un côté de l'image (--ms-haut,
     --ms-l, --ms-h posés par le lecteur) ; zoom doux sur le passage (transform de .manuscrit__doc) et
     halo : même effet que les documents d'épisode (EpisodeVisuels.astro, .ev-doc__surligne). */
  .manuscrit {
    --ms-l: 200px;
    --ms-h: 280px;
    --objet-l: var(--ms-l);
    position: absolute;
    right: var(--marge-x, var(--e-2));
    top: var(--ms-haut, 15%);
    z-index: 2;
    margin: 0;
    padding: 0.35rem 0.35rem 0.3rem;
    background: rgba(251, 250, 247, 0.96);
    border: 1px solid rgba(26, 26, 26, 0.22);
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: opacity 600ms ease, transform 600ms ease, visibility 0s linear 600ms;
  }
  .manuscrit.est-gauche { right: auto; left: var(--marge-x, var(--e-2)); }
  .manuscrit.est-visible {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition: opacity 800ms ease, transform 1200ms cubic-bezier(0.2, 0.6, 0.3, 1), visibility 0s;
  }
  .manuscrit__page { position: relative; overflow: hidden; margin: 0 auto; width: var(--ms-l); height: var(--ms-h); border: 1px solid var(--c-filet); }
  .manuscrit__doc { position: absolute; left: 0; top: 0; width: 100%; height: 100%; transform-origin: 0 0; will-change: transform; }
  .manuscrit__doc img { display: block; width: 100%; height: 100%; }
  .manuscrit__halo {
    position: absolute;
    margin: -1.2% -3%;
    padding: 1.2% 3%;
    box-sizing: content-box;
    opacity: var(--p, 0);
    -webkit-backdrop-filter: brightness(1.22) contrast(1.25);
    backdrop-filter: brightness(1.22) contrast(1.25);
    -webkit-mask-image: radial-gradient(closest-side, #000 62%, transparent 100%);
    mask-image: radial-gradient(closest-side, #000 62%, transparent 100%);
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
  }

  /* Citation : voile léger, grand serif italique, centrée dans le tiers inférieur. */
  .mots {
    position: absolute;
    left: 50%;
    bottom: calc(var(--surimp-bas, var(--frise-bas, 0px)) + var(--frise-pousse, 0px) + 7%);
    z-index: 2;
    width: max-content;
    max-width: min(46rem, calc(100% - 2 * var(--e-3)));
    padding: 0.55rem 1.3rem 0.6rem;
    background: rgba(251, 250, 247, 0.86);
    text-align: center;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, 4px);
    transition: opacity 700ms ease, transform 700ms ease, visibility 0s linear 700ms, bottom 500ms ease;
  }
  .mots.est-visible {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
    transition: opacity 300ms ease, transform 500ms ease, visibility 0s, bottom 500ms ease;
  }
  .mots__texte {
    margin: 0;
    font-family: var(--f-titre);
    font-style: normal;
    font-size: clamp(1.25rem, 2.6vw, 2rem);
    line-height: 1.3;
    color: var(--c-texte);
    text-wrap: balance;
    hyphens: none;
    -webkit-hyphens: none;
  }
  .mots__texte::before { content: '«\00a0'; }
  /* Les mots à venir sont à leur place mais invisibles : la mise en page ne bouge pas. */
  .mots__texte :global(.m) { opacity: 0; transition: opacity 260ms ease; }
  .mots__texte :global(.m.est-dit) { opacity: 1; }
  .mots__auteur {
    margin: 0.25rem 0 0;
    font-size: 0.95rem;
    font-variant: small-caps;
    letter-spacing: 0.06em;
    color: #3a3a3a;
    opacity: 0;
    transition: opacity 500ms ease;
  }
  .mots.est-signe .mots__auteur { opacity: 1; }

  /* Chiffre clé : grand serif noir, chiffres elzéviriens (tabulaires : le défilement ne fait pas
     danser la ligne), sur un voile blanc cassé local aux bords fondus ; prudence et unité en petites
     capitales. Centré dans le tiers inférieur ; --chiffre-bas (posé par le lecteur) le monte
     au-dessus d'une surimpression de coin ou de la date quand elles se montrent avec lui. */
  .chiffre {
    --chiffre-t: 4.2rem;
    position: absolute;
    left: 50%;
    bottom: calc(var(--surimp-bas, var(--frise-bas, 0px)) + var(--frise-pousse, 0px) + var(--chiffre-bas, 7%));
    z-index: 2;
    width: max-content;
    max-width: calc(100% - 2 * var(--e-3));
    padding: 0.5rem 2.6rem 0.55rem;
    text-align: center;
    color: var(--c-texte);
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, 6px);
    transition: opacity 700ms ease, transform 700ms ease, visibility 0s linear 700ms;
  }
  .chiffre::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgba(251, 250, 247, 0.88);
    -webkit-mask-image: radial-gradient(closest-side, #000 60%, rgba(0, 0, 0, 0.7) 80%, transparent 100%);
    mask-image: radial-gradient(closest-side, #000 60%, rgba(0, 0, 0, 0.7) 80%, transparent 100%);
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    transform: scale(1.3, 1.45);
  }
  .chiffre.est-visible {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
    transition: opacity 600ms ease, transform 900ms cubic-bezier(0.2, 0.6, 0.3, 1), visibility 0s, bottom 500ms ease;
  }
  .chiffre p { margin: 0; hyphens: none; -webkit-hyphens: none; }
  /* Annotation du 2026-10-12 : préfixe et unité plus grands et noirs (ils se lisaient mal sur le bord
     fondu du voile), voile un peu plus dense. */
  .chiffre__prefixe, .chiffre__unite { font-variant: small-caps; letter-spacing: 0.06em; color: var(--c-texte); }
  .chiffre__prefixe { font-size: 1.2rem; line-height: 1.1; }
  .chiffre__prefixe:empty { display: none; }
  .chiffre__nombre {
    position: relative;
    display: inline-block;
    font-family: var(--f-titre);
    font-size: var(--chiffre-t);
    line-height: 1;
    font-variant-numeric: oldstyle-nums tabular-nums;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }
  /* La valeur finale, invisible, donne la place ; la valeur qui défile est posée dessus, alignée à
     droite (comme un compteur). */
  .chiffre__mesure { visibility: hidden; }
  .chiffre__valeur { position: absolute; right: 0; bottom: 0; }
  .chiffre__unite { margin-top: 0.2rem; font-size: 1.4rem; line-height: 1.2; text-wrap: balance; }

  /* Date républicaine : bandeau voilé, fin, au bas de l'image, au centre (au-dessus de la frise
     quand elle s'affiche : règle globale de Diaporama.astro). */
  .date-rep {
    position: absolute;
    left: 50%;
    bottom: calc(var(--surimp-bas, var(--frise-bas, 0px)) + var(--frise-pousse, 0px) + var(--e-2));
    z-index: 2;
    width: max-content;
    max-width: calc(100% - 2 * var(--e-2));
    margin: 0;
    padding: 0.18rem 0.9rem 0.24rem;
    background: rgba(251, 250, 247, 0.88);
    font-size: 0.98rem;
    line-height: 1.25;
    font-variant: small-caps;
    font-variant-numeric: oldstyle-nums;
    letter-spacing: 0.06em;
    color: #2f2f2f;
    text-align: center;
    text-wrap: balance;
    hyphens: none;
    -webkit-hyphens: none;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, 4px);
    transition: opacity 700ms ease, transform 700ms ease, visibility 0s linear 700ms;
  }
  .date-rep.est-visible {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
    transition: opacity 500ms ease, transform 600ms ease, visibility 0s, bottom 500ms ease;
  }
  .date-rep__sep { color: #6a6862; }

  @media (max-width: 699px) {
    .chiffre { padding: 0.35rem 1.6rem 0.4rem; bottom: calc(var(--surimp-bas, var(--frise-bas, 0px)) + var(--frise-pousse, 0px) + var(--chiffre-bas, 6%)); max-width: calc(100% - 2 * var(--e-1)); }
    .chiffre__prefixe { font-size: 0.9rem; }
    .chiffre__unite { font-size: 1.02rem; }
    .date-rep { bottom: calc(var(--surimp-bas, var(--frise-bas, 0px)) + var(--frise-pousse, 0px) + var(--e-1)); font-size: 0.8rem; padding: 0.12rem 0.6rem 0.16rem; letter-spacing: 0.04em; max-width: calc(100% - 2 * var(--e-1)); }
    .lieu { padding: 0.2rem; }
    .lieu__nom { font-size: 0.82rem; }
    .lieu :global(.lieu__etiquette) { font-size: 0.64rem; max-width: 7.5em; }
    .mots { bottom: calc(var(--surimp-bas, var(--frise-bas, 0px)) + var(--frise-pousse, 0px) + 5%); max-width: calc(100% - 2 * var(--e-1)); padding: 0.4rem 0.8rem 0.45rem; }
    .mots__texte { font-size: 1.12rem; }
    .mots__auteur { font-size: 0.85rem; }
    .portraits { gap: 0.35rem; }
    .portraits :global(.portrait) { max-width: max(calc(var(--ovale-h) * 0.8 + 0.8rem), 4.4em); }
    .portraits :global(figcaption) { margin-top: 0.14rem; padding: 0.04rem 0.28rem 0.06rem; }
    .portraits :global(.portrait__nom) { font-size: 0.7rem; letter-spacing: 0.02em; }
    .portraits :global(.portrait__dates) { font-size: 0.62rem; }
    .portraits.est-seul :global(.portrait) { max-width: 12em; }
    .manuscrit { padding: 0.2rem; }
    .manuscrit figcaption { max-width: max(var(--objet-l), 8em); }
    .objet__nom { font-size: 0.66rem; }
    .objet__legende { font-size: 0.6rem; letter-spacing: 0.02em; }
  }
  @media (prefers-reduced-motion: reduce) {
    .lieu, .lieu.est-visible, .mots, .mots.est-visible, .portraits, .portraits.est-visible { transform: translate(0, 0); transition: opacity 200ms ease, visibility 0s linear 200ms; }
    .portraits.est-visible { transition: opacity 200ms ease, visibility 0s; }
    .portraits :global(.portrait) { transform: none; transition: none; }
    .mots, .mots.est-visible { transform: translate(-50%, 0); }
    .lieu.est-visible, .mots.est-visible { transition: opacity 200ms ease, visibility 0s; }
    .lieu__point::after, .lieu :global(.lieu__pt.est-dernier)::after { animation: none; display: none; }
    .lieu :global(.lieu__pt) { transition: none; transform: none; }
    .lieu :global(.lieu__etiquette), .lieu :global(.lieu__filet) { transition: none; }
    .mots__texte :global(.m) { transition: none; }
    .objet, .objet.est-visible, .manuscrit, .manuscrit.est-visible { transform: none; transition: opacity 200ms ease, visibility 0s linear 200ms; }
    .objet.est-visible, .manuscrit.est-visible { transition: opacity 200ms ease, visibility 0s; }
    .chiffre, .chiffre.est-visible, .date-rep, .date-rep.est-visible { transform: translate(-50%, 0); transition: opacity 200ms ease, visibility 0s linear 200ms; }
    .chiffre.est-visible, .date-rep.est-visible { transition: opacity 200ms ease, visibility 0s; }
  }
</style>

<script>
  // Médaillons à plusieurs lieux (spec 12, révision du 2026-10-08). Le lecteur (Diaporama.astro)
  // pose le fond, la fenêtre d'affichage et la zone couverte pour la caméra ; ce script ajoute les
  // points et leurs noms quand le médaillon d'une diapositive à plusieurs lieux devient visible, et
  // montre chaque point dès que l'audio de la voix atteint son instant.
  type Point = { nom: string; x: number; y: number; t: number };
  type Multiple = { points: Point[]; vb?: string };
  type Rect = { x: number; y: number; w: number; h: number };

  const ECART = 4;   // px : du bord du point au nom posé à côté
  const LOIN = 15;   // px : nom décalé, relié au point par un filet
  const RAYON = 5;   // px : point et son liseré

  function aire(a: Rect, b: Rect) {
    const w = Math.min(a.x + a.w, b.x + b.w) - Math.max(a.x, b.x), h = Math.min(a.y + a.h, b.y + b.h) - Math.max(a.y, b.y);
    return w > 0 && h > 0 ? w * h : 0;
  }

  /** Noms posés sans chevauchement, dans l'ordre de la voix : pour chacun, la première place libre
   *  parmi (à droite, à gauche, au-dessus, en dessous, en biais) puis les mêmes plus loin, avec un
   *  filet ; à défaut, la moins gênante (chevauchement, sortie du cadre). */
  function placer(W: number, H: number, pts: { x: number; y: number }[], tailles: { w: number; h: number }[]) {
    const poses: Rect[] = [];
    const disques = pts.map((p) => ({ x: p.x - RAYON, y: p.y - RAYON, w: 2 * RAYON, h: 2 * RAYON }));
    return pts.map((p, k) => {
      const { w, h } = tailles[k];
      // [x, y, filet, alignement du texte] ; un nom à gauche du point est aligné à droite.
      const essais: [number, number, boolean, string][] = [];
      for (const [d, filet] of [[ECART + RAYON, false], [LOIN + RAYON, true]] as [number, boolean][]) {
        const dd = d * 0.72;
        essais.push(
          [p.x + d, p.y - h / 2, filet, 'left'], [p.x - d - w, p.y - h / 2, filet, 'right'],
          [p.x - w / 2, p.y - d - h, filet, 'center'], [p.x - w / 2, p.y + d, filet, 'center'],
          [p.x + dd, p.y - dd - h, filet, 'left'], [p.x + dd, p.y + dd, filet, 'left'],
          [p.x - dd - w, p.y - dd - h, filet, 'right'], [p.x - dd - w, p.y + dd, filet, 'right']);
      }
      let mieux = { r: { x: essais[0][0], y: essais[0][1], w, h }, filet: false, aligne: 'left', cout: Infinity };
      essais.forEach(([x, y, filet, aligne], j) => {
        const r = { x, y, w, h };
        const dehors = w * h - aire(r, { x: 1, y: 1, w: W - 2, h: H - 2 });
        const gene = poses.reduce((s, q) => s + aire(r, { x: q.x - 2, y: q.y - 1, w: q.w + 4, h: q.h + 2 }), 0)
          + disques.reduce((s, q) => s + aire(r, q), 0);
        const cout = 50 * gene + 20 * dehors + j;
        if (cout < mieux.cout) mieux = { r, filet, aligne, cout };
      });
      poses.push(mieux.r);
      return mieux;
    });
  }

  for (const racine of document.querySelectorAll<HTMLElement>('.diaporama')) {
    const donnees = racine.querySelector('.lieu__multiples');
    const elLieu = racine.querySelector<HTMLElement>('.lieu');
    const audio = racine.querySelector<HTMLAudioElement>('.lecteur__audio');
    if (!donnees || !elLieu || !audio) continue;
    const multiples: Record<string, Multiple> = JSON.parse(donnees.textContent || '{}');
    const carte = elLieu.querySelector<HTMLElement>('.lieu__carte')!;
    const calque = document.createElement('div');
    calque.className = 'lieu__pts';
    carte.append(calque);
    const viewBoxes = new Map<SVGSVGElement, string>();
    for (const svg of carte.querySelectorAll<SVGSVGElement>('svg.lieu__fond')) viewBoxes.set(svg, svg.getAttribute('viewBox') || '');

    let courant: Multiple | null = null;
    let els: { pt: HTMLElement; nom: HTMLElement; filet: HTMLElement }[] = [];
    let dits = -1;
    let boucle = 0;

    /** Pose les noms (mesurés dans le médaillon à sa taille du moment). */
    function disposer() {
      if (!courant) return;
      const W = carte.clientWidth, H = carte.clientHeight;
      if (!W || !H) return;
      const pts = courant.points.map((p) => ({ x: (p.x / 100) * W, y: (p.y / 100) * H }));
      const places = placer(W, H, pts, els.map((e) => ({ w: e.nom.offsetWidth, h: e.nom.offsetHeight })));
      places.forEach(({ r, filet, aligne }, k) => {
        const e = els[k];
        e.nom.style.textAlign = aligne;
        e.nom.style.left = `${Math.round(r.x)}px`;
        e.nom.style.top = `${Math.round(r.y)}px`;
        e.filet.hidden = !filet;
        if (!filet) return;
        // Filet du bord du point au point le plus proche du nom.
        const p = pts[k];
        const qx = Math.max(r.x, Math.min(p.x, r.x + r.w)), qy = Math.max(r.y, Math.min(p.y, r.y + r.h));
        const dx = qx - p.x, dy = qy - p.y, l = Math.hypot(dx, dy);
        const a = Math.atan2(dy, dx);
        e.filet.style.left = `${p.x + Math.cos(a) * RAYON}px`;
        e.filet.style.top = `${p.y + Math.sin(a) * RAYON}px`;
        e.filet.style.width = `${Math.max(0, l - RAYON - 1)}px`;
        e.filet.style.transform = `rotate(${a}rad)`;
      });
    }

    /** Contenu du médaillon de la diapositive en cours (celle dont la voix est chargée). */
    function preparer() {
      courant = multiples[audio!.getAttribute('src') || ''] ?? null;
      elLieu!.classList.toggle('est-multiple', !!courant);
      calque.replaceChildren();
      els = [];
      dits = -1;
      for (const [svg, vb] of viewBoxes) svg.setAttribute('viewBox', courant?.vb && svg.classList.contains('est-actif') ? courant.vb : vb);
      if (!courant) return;
      for (const p of courant.points) {
        const pt = document.createElement('span'), nom = document.createElement('span'), filet = document.createElement('span');
        pt.className = 'lieu__pt';
        pt.style.left = `${p.x}%`;
        pt.style.top = `${p.y}%`;
        nom.className = 'lieu__etiquette';
        nom.textContent = p.nom;
        filet.className = 'lieu__filet';
        calque.append(filet, pt, nom);
        els.push({ pt, nom, filet });
      }
      disposer();
      if (document.fonts?.status !== 'loaded') document.fonts?.ready.then(disposer);
    }

    /** Points dits à l'instant de l'audio (le point paraît quand la voix attaque le nom). */
    function maj() {
      if (!courant) return;
      const t = audio!.currentTime || 0;
      let n = 0;
      while (n < courant.points.length && courant.points[n].t <= t + 0.06) n++;
      // Le premier point est là dès l'entrée du médaillon (même s'il a été retardé par une citation).
      n = Math.max(1, n);
      if (n === dits) return;
      dits = n;
      els.forEach((e, k) => {
        for (const el of [e.pt, e.nom, e.filet]) el.classList.toggle('est-dit', k < n);
        e.pt.classList.toggle('est-dernier', k === n - 1);
      });
    }
    function tourner() { maj(); boucle = requestAnimationFrame(tourner); }

    // Le médaillon devient visible ou s'efface (classe posée par le lecteur).
    let visible = false;
    new MutationObserver(() => {
      const v = elLieu.classList.contains('est-visible');
      if (v === visible) return;
      visible = v;
      cancelAnimationFrame(boucle);
      if (v) { preparer(); tourner(); }
    }).observe(elLieu, { attributes: true, attributeFilter: ['class'] });
    new ResizeObserver(() => { if (visible) disposer(); }).observe(carte);
  }
</script>
