---
// Générique d'ouverture et récapitulatif de fin d'un diaporama (spec 12, révision du 2026-10-09) :
// mosaïque bord à bord des images de `generique` en trois rangées qui dérivent en sens alternés,
// sous un voile sombre ; titre et dates de la période en très grandes lettres blanc cassé, écrits
// lettre à lettre, « Fin » au-dessus pour le récapitulatif. Posé sur tout le lecteur, du haut
// jusqu'à la barre des actes (`bottom` calé par le script ; tout l'écran en plein écran). Animé par src/scripts/diaporama/generique.ts
// (styles posés à chaque image : aucune animation CSS, captures reproductibles). Les images ne se
// chargent qu'au lancement (`data-src`). Monochrome hors images.
import { typographie } from '../utils/typographie.mjs';
import { imagesGenerique, urlMedia, type Diaporama } from '../utils/diaporamas';

interface Props { diaporama: Diaporama }
const { diaporama: d } = Astro.props;
const images = imagesGenerique(d).map((im, k) => ({ k, src: urlMedia(d.slug, im.fichier), l: im.largeur ?? 1600, h: im.hauteur ?? 1200 }));
// Trois rangées (la première reçoit le reste) ; chacune est répétée quatre fois : elle couvre la
// scène et sa dérive, même sur grand écran.
const tiers = [0, 1, 2].map((j) => Math.floor(images.length / 3) + (j < images.length % 3 ? 1 : 0));
const rangees = tiers.map((t, j) => images.slice(tiers.slice(0, j).reduce((a, b) => a + b, 0), tiers.slice(0, j + 1).reduce((a, b) => a + b, 0)))
  .map((r) => [...r, ...r, ...r, ...r]);
/** Lettres d'un texte, mots insécables (pas de coupure au milieu d'un mot). */
const mots = (s: string) => typographie(s).split(/(\s+)/).filter(Boolean);
const titre = mots(d.titre);
const dates = mots(d.periode);
---

{images.length > 0 && (
  <div class="generique" data-action="passer" aria-hidden="true" title="Passer (Entrée)">
    {rangees.map((r, j) => (
      <div class="generique__bande">
        <div class="generique__rail">
          {r.map((im) => (
            <div class="generique__vignette" data-k={im.k} style={`aspect-ratio: ${im.l} / ${im.h}`}>
              <img data-src={im.src} alt="" decoding="async" />
            </div>
          ))}
        </div>
      </div>
    ))}
    <div class="generique__voile"></div>
    <div class="generique__milieu">
      <p class="generique__fin">Fin</p>
      <div class="generique__titres">
        <p class="generique__titre" aria-label={typographie(d.titre)}>
          {titre.map((m) => (/^\s+$/.test(m) ? m : <span class="mot">{[...m].map((c) => <span class="l">{c}</span>)}</span>))}
        </p>
        <span class="generique__filet"></span>
        <p class="generique__dates" aria-label={typographie(d.periode)}>
          {dates.map((m) => (/^\s+$/.test(m) ? m : <span class="mot">{[...m].map((c) => <span class="l">{c}</span>)}</span>))}
        </p>
      </div>
    </div>
  </div>
)}

<style>
  .generique {
    position: absolute;
    inset: 0;
    z-index: 8;
    container-type: size;
    display: flex;
    flex-direction: column;
    gap: 3px;
    background: #0d0d0d;
    overflow: hidden;
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transition: opacity 900ms ease, visibility 0s linear 900ms;
  }
  .generique.est-visible { opacity: 1; visibility: visible; transition: opacity 900ms ease, visibility 0s; }
  .generique__bande { flex: 1 1 0; min-height: 0; overflow: hidden; }
  .generique__rail { display: flex; gap: 3px; height: 100%; width: max-content; will-change: transform; }
  .generique__vignette { height: 100%; opacity: 0; background: #1a1a1a; overflow: hidden; }
  .generique__vignette img { display: block; width: 100%; height: 100%; object-fit: cover; }
  /* Voile sombre, plus dense au centre, sous le texte (comme les paroles des chants). */
  .generique__voile {
    position: absolute;
    inset: 0;
    /* Annotation du 2026-10-12 : voile allégé hors du centre, pour des images plus éclatantes. */
    background: radial-gradient(ellipse 62% 52% at center, rgba(0, 0, 0, 0.58), rgba(0, 0, 0, 0.14));
  }
  .generique__milieu {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: min(2cqh, 1.2rem);
    padding: 0 6cqw;
    text-align: center;
    color: var(--c-fond);
  }
  .generique__titres { display: flex; flex-direction: column; align-items: center; gap: min(3cqh, 1.6rem); }
  .generique__titre {
    margin: 0;
    font-family: var(--f-titre);
    font-size: min(8.4cqw, 17cqh);
    font-variant: small-caps;
    letter-spacing: 0.08em;
    line-height: 1.05;
    color: var(--c-fond);
  }
  .generique .mot { white-space: nowrap; }
  .generique .l { opacity: 0; }
  .generique__filet { display: block; width: min(14cqw, 9rem); height: 0; border-top: 1px solid rgba(251, 250, 247, 0.6); transform: scaleX(0); }
  .generique__dates {
    margin: 0;
    font-size: min(4.4cqw, 9cqh);
    font-style: italic;
    font-variant-numeric: oldstyle-nums;
    letter-spacing: 0.06em;
    line-height: 1.1;
    color: rgba(251, 250, 247, 0.85);
  }
  .generique__fin {
    display: none;
    margin: 0;
    font-family: var(--f-titre);
    font-size: min(4cqw, 8.5cqh);
    font-style: italic;
    letter-spacing: 0.04em;
    color: rgba(251, 250, 247, 0.85);
  }
  /* Récapitulatif (annotation du 2026-10-12) : « Fin » en grand, au centre exact de l'écran ; le
     titre et les dates, plus petits, viennent dessous sans le déplacer. */
  .generique--fin .generique__fin { display: block; font-size: min(12cqw, 24cqh); line-height: 1; color: var(--c-fond); }
  .generique--fin .generique__titres { position: absolute; left: 6cqw; right: 6cqw; top: calc(50% + min(8.5cqw, 17cqh)); gap: min(1.6cqh, 0.9rem); }
  .generique--fin .generique__titre { font-size: min(4.2cqw, 8.5cqh); }
  .generique--fin .generique__dates { font-size: min(2.6cqw, 5.4cqh); }
  /* Écran vertical (téléphone) : titre plus grand, sur deux lignes au besoin. */
  @container (aspect-ratio < 1) {
    .generique__titre { font-size: 11cqw; line-height: 1.1; }
    .generique__dates, .generique__fin { font-size: 6cqw; }
    .generique--fin .generique__fin { font-size: 20cqw; }
    .generique--fin .generique__titres { top: calc(50% + 14cqw); }
    .generique--fin .generique__titre { font-size: 7cqw; }
    .generique--fin .generique__dates { font-size: 4.4cqw; }
  }
  @media (prefers-reduced-motion: reduce) {
    .generique, .generique.est-visible { transition-duration: 300ms; }
  }
</style>
