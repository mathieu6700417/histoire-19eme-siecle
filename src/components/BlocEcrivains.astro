---
// Bloc de l'accueil d'un siècle présentant sa section « Le siècle raconté par ses écrivains ».
import { planComplet, urlSection } from '../utils/ecrivains';
import { typographie } from '../utils/typographie.mjs';

interface Props { siecle: string }
const { siecle } = Astro.props;
const plan = await planComplet(siecle);
// Le prologue (numéro 0) est compté à part des huit chapitres.
const chapitres = plan.filter((p) => p.numero > 0);
const ecrits = chapitres.filter((p) => p.chapitre).length;
const prologue = plan.some((p) => p.numero === 0 && p.chapitre);
---

<section class="bloc-ecrivains" aria-labelledby="titre-ecrivains">
  <h2 id="titre-ecrivains">Le siècle raconté par ses écrivains</h2>
  <p>
    {typographie("Une autre façon de traverser le siècle : par les textes de ceux qui l'ont vécu. Chateaubriand, Michelet, Hugo, Mme de Staël, Balzac et bien d'autres racontent, chacun depuis son camp, la Révolution, les empires, les républiques. Chaque extrait est remis dans son contexte et lu d'un œil critique.")}
  </p>
  <p class="bloc-ecrivains__etat">{typographie(`${prologue ? 'Prologue et ' : ''}${ecrits} chapitre${ecrits > 1 ? 's' : ''} sur ${chapitres.length} disponible${ecrits > 1 || prologue ? 's' : ''}`)}</p>
  <p><a class="bloc-ecrivains__lien" href={urlSection(siecle)}>Ouvrir le parcours →</a></p>
</section>

<style>
  .bloc-ecrivains {
    margin-top: var(--e-6);
    padding: var(--e-3) 0 0;
    border-top: 1px solid var(--c-texte-doux);
  }
  .bloc-ecrivains h2 { margin-top: 0; }
  .bloc-ecrivains__etat { font-variant: small-caps; letter-spacing: 0.08em; color: var(--c-texte-doux); }
  .bloc-ecrivains__lien { font-family: var(--f-titre); font-size: 1.15rem; }
  .bloc-ecrivains p:last-child { margin-bottom: 0; }
</style>
