---
// Encadré « Définition » ou « À retenir ».
import { typographie } from '../utils/typographie.mjs';

interface Props {
  type?: 'definition' | 'retenir';
  /** Terme défini (pour une définition) ou titre libre. */
  titre?: string;
}

const { type = 'definition', titre } = Astro.props;
const etiquette = type === 'definition' ? 'Définition' : 'À retenir';
---

<aside class={`encadre encadre--${type}`} aria-label={titre ? typographie(`${etiquette} : ${titre}`) : etiquette}>
  <p class="encadre__titre">
    <span class="encadre__etiquette">{etiquette}</span>
    {titre && <span class="encadre__terme">{typographie(titre)}</span>}
  </p>
  <div class="encadre__contenu"><slot /></div>
</aside>

<style>
  .encadre {
    margin: var(--e-4) auto;
    padding: var(--e-1) 0 var(--e-1) var(--e-3);
    border-left: 1px solid var(--c-ocre-clair);
    font-size: 1.05rem;
  }
  .encadre--retenir { border-left-color: var(--c-bordeaux); }
  .encadre__titre { margin: 0 0 var(--e-1); display: flex; flex-wrap: wrap; gap: 0 var(--e-2); align-items: baseline; }
  .encadre__etiquette {
    font-variant: small-caps;
    letter-spacing: 0.08em;
    font-weight: 500;
    color: var(--c-texte-doux);
  }
  .encadre--retenir .encadre__etiquette { color: var(--c-bordeaux); }
  .encadre__terme { font-family: var(--f-titre); font-weight: 500; color: var(--c-bleu-nuit); }
  .encadre__contenu > :global(:last-child) { margin-bottom: 0; }
</style>
