---
import { render } from 'astro:content';
import Chapitre from '../../../layouts/Chapitre.astro';
import { sieclesAvec } from '../../../data/siecles';
import { chapitresEcrits, planComplet, slugChapitre, urlChapitre, type Chapitre as EntreeChapitre } from '../../../utils/ecrivains';

export async function getStaticPaths() {
  const pages = [];
  for (const s of sieclesAvec('ecrivains')) {
    const chapitres = await chapitresEcrits(s.id);
    const plan = await planComplet(s.id);
    const voisin = (numero: number) => {
      const p = plan.find((x) => x.numero === numero);
      if (!p) return undefined;
      return { numero: p.numero, titre: p.titre, href: p.chapitre ? urlChapitre(p.chapitre) : undefined };
    };
    pages.push(...chapitres.map((chapitre) => ({
      params: { siecle: s.id, slug: slugChapitre(chapitre) },
      props: {
        siecle: s.id,
        chapitre,
        precedent: voisin(chapitre.data.numero - 1),
        suivant: voisin(chapitre.data.numero + 1),
      },
    })));
  }
  return pages;
}

/**
 * Sommaire, lu dans le source MDX : les parties (<Partie id titre>) et, dans
 * chacune, les extraits (id, titre, auteur), puis la conclusion.
 */
function sommaireDe(c: EntreeChapitre) {
  const body = c.body ?? '';
  const parties: { id: string; titre: string; extraits: { id: string; titre: string; auteur: string }[] }[] = [];
  for (const m of body.matchAll(/<(Partie|Extrait)\b/g)) {
    const bloc = body.slice(m.index, m.index + 800);
    const id = bloc.match(/\bid="([^"]+)"/)?.[1];
    const titre = bloc.match(/\btitre="([^"]+)"/)?.[1];
    if (!id || !titre) continue;
    if (m[1] === 'Partie') parties.push({ id, titre, extraits: [] });
    else {
      if (!parties.length) parties.push({ id: '', titre: '', extraits: [] });
      parties[parties.length - 1].extraits.push({ id, titre, auteur: bloc.match(/\bauteur="([^"]+)"/)?.[1] ?? '' });
    }
  }
  return { parties, conclusion: body.includes('id="conclusion"') };
}

/**
 * Vérifie au build que la fiche de chaque auteur est affichée à sa première
 * apparition, et seulement là. Convention : <Extrait auteur="…" fiche …>.
 */
function verifierFiches(c: EntreeChapitre) {
  const vus = new Set<string>();
  for (const m of (c.body ?? '').matchAll(/<Extrait\s+auteur="([^"]+)"(\s+fiche\b)?/g)) {
    const avecFiche = Boolean(m[2]);
    if (!vus.has(m[1]) && !avecFiche) console.warn(`[${c.id}] première apparition de « ${m[1]} » sans fiche`);
    if (vus.has(m[1]) && avecFiche) console.warn(`[${c.id}] fiche de « ${m[1]} » répétée`);
    vus.add(m[1]);
  }
}

const { siecle, chapitre, precedent, suivant } = Astro.props;
verifierFiches(chapitre);
const { Content } = await render(chapitre);
---

<Chapitre {...chapitre.data} siecle={siecle} sommaire={sommaireDe(chapitre)} precedent={precedent} suivant={suivant}>
  <Content />
</Chapitre>
