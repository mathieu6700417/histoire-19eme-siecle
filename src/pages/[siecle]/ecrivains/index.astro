---
import Base from '../../../layouts/Base.astro';
import { libelleChapitre, planComplet, urlChapitre, urlAuteurs } from '../../../utils/ecrivains';
import { genres } from '../../../data/genres';
import { sieclesAvec } from '../../../data/siecles';
import { typographie } from '../../../utils/typographie.mjs';

export function getStaticPaths() {
  return sieclesAvec('ecrivains').map((s) => ({ params: { siecle: s.id } }));
}

const { siecle } = Astro.params as { siecle: string };
const plan = await planComplet(siecle);
---

<Base
  title="Le siècle raconté par ses écrivains"
  description="L'histoire de la France de 1789 à 1900 racontée par les textes des écrivains qui l'ont vécue : une anthologie commentée, chapitre par chapitre."
>
  <div class="conteneur section-ecrivains">
    <header class="presentation">
      <p class="surtitre">Parcours</p>
      <h1>Le siècle raconté par ses écrivains</h1>
      <p class="chapeau">
        {typographie("De 1789 à 1900, la France vue par ceux qui l'ont vécue : mémorialistes, romanciers, poètes, historiens et polémistes. Une histoire portée par les textes, comme une anthologie commentée.")}
      </p>
      <p>
        {typographie("Chaque chapitre correspond à un régime. Les extraits y passent d'abord, dans l'ordre des faits qu'ils racontent ; de courtes transitions font avancer le récit entre eux. Tous les textes sont du domaine public et reproduits mot pour mot depuis Wikisource, avec un lien vers le chapitre complet.")}
      </p>
      <p>
        {typographie("Ces textes sont des sources, pas des vérités : chaque auteur écrit depuis un camp politique, parfois des décennies après les faits, parfois en romancier. C'est pourquoi chaque extrait est précédé d'un chapeau qui dit qui parle et quand, et suivi d'un « regard critique » qui signale ce que le texte montre et ce qu'il laisse dans l'ombre. Dans chaque chapitre, les voix de plusieurs bords se répondent.")}
      </p>
      <ul class="genres" aria-label="Genres des extraits">
        {Object.values(genres).map((g) => (
          <li>{g.libelle}</li>
        ))}
      </ul>
    </header>

    <section aria-labelledby="titre-chapitres">
      <h2 id="titre-chapitres">Le prologue et les huit chapitres</h2>
      <ol class="chapitres">
        {plan.map((p) => (
          <li class:list={['chapitre-carte', { 'chapitre-carte--avenir': !p.chapitre }]}>
            {p.chapitre ? (
              <a href={urlChapitre(p.chapitre)}>
                <span class="chapitre-carte__numero">{libelleChapitre(p.numero)} · {p.periode}</span>
                <span class="chapitre-carte__titre">{typographie(p.chapitre.data.titre)}</span>
                <span class="chapitre-carte__resume">{typographie(p.chapitre.data.resume)}</span>
                <span class="chapitre-carte__duree">{typographie(`Lecture : environ ${p.chapitre.data.dureeLecture} min`)}</span>
              </a>
            ) : (
              <div aria-disabled="true">
                <span class="chapitre-carte__numero">{libelleChapitre(p.numero)} · {p.periode}</span>
                <span class="chapitre-carte__titre">{typographie(p.titre)}</span>
                <span class="chapitre-carte__avenir">À venir</span>
              </div>
            )}
          </li>
        ))}
      </ol>
    </section>

    <p class="lien-index">
      <a href={urlAuteurs(siecle)}>{typographie("Index des auteurs : dates, portraits et chapitres où ils sont cités →")}</a>
    </p>
  </div>
</Base>

<style>
  .section-ecrivains { max-width: calc(900px + 2 * var(--gouttiere)); }
  .presentation { padding-top: var(--e-5); max-width: var(--l-lecture); }
  .surtitre {
    font-variant: small-caps;
    letter-spacing: 0.1em;
    color: var(--c-texte-doux);
    margin-bottom: var(--e-1);
  }
  .chapeau { font-size: 1.3rem; font-style: italic; color: var(--c-texte-doux); }

  /* Genres : simple liste en petites capitales grises. */
  .genres {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--e-2);
    font-variant: small-caps;
    letter-spacing: 0.08em;
    color: var(--c-texte-doux);
  }
  .genres li { margin: 0; }
  .genres li + li::before { content: '·'; margin-right: var(--e-2); }

  h2 {
    font-size: 1.1rem;
    font-variant: small-caps;
    letter-spacing: 0.1em;
    font-weight: 500;
    color: var(--c-texte-doux);
    border-bottom: 1px solid var(--c-filet);
    padding-bottom: var(--e-1);
  }
  .chapitres {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--e-3) var(--e-5);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
  }
  .chapitre-carte { margin: 0; }
  .chapitre-carte > a,
  .chapitre-carte > div {
    display: flex;
    flex-direction: column;
    gap: var(--e-1);
    height: 100%;
    padding: var(--e-2) 0 var(--e-3);
    border-top: 1px solid var(--c-texte-doux);
    color: var(--c-texte);
    text-decoration: none;
  }
  .chapitre-carte > a:hover .chapitre-carte__titre { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.2em; }
  .chapitre-carte__numero { font-variant: small-caps; color: var(--c-texte-doux); letter-spacing: 0.08em; }
  .chapitre-carte__titre { font-family: var(--f-titre); font-size: 1.3rem; color: var(--c-texte); line-height: 1.25; }
  .chapitre-carte__resume { font-size: 1.02rem; }
  .chapitre-carte__duree { font-size: var(--t-petit); color: var(--c-texte-doux); margin-top: auto; }

  .chapitre-carte--avenir > div { border-top-color: var(--c-filet); color: var(--c-texte-doux); }
  .chapitre-carte--avenir .chapitre-carte__titre { color: var(--c-texte-doux); }
  .chapitre-carte__avenir {
    margin-top: auto;
    font-variant: small-caps;
    letter-spacing: 0.08em;
    font-size: var(--t-petit);
  }
  .lien-index { margin-top: var(--e-4); font-size: 1.1rem; }
</style>
