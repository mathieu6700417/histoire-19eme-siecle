---
import Base from '../layouts/Base.astro';
import { urlSommaire } from '../utils/adresses';
---

<Base title="Page introuvable" description="Cette page n'existe pas.">
  <main class="introuvable">
    <h1>Page introuvable</h1>
    <p>Cette page n'existe pas ou a changé d'adresse.</p>
    <p><a href={urlSommaire}>Retour au sommaire</a></p>
  </main>
</Base>

<style>
  .introuvable {
    max-width: var(--l-lecture);
    margin: 4rem auto;
    padding-inline: var(--gouttiere);
  }
</style>
