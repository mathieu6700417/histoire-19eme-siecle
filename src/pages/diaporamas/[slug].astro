---
// Lecteur d'une période de la section « Le siècle en images » (spec 12).
import Base from '../../layouts/Base.astro';
import Diaporama from '../../components/Diaporama.astro';
import { typographie } from '../../utils/typographie.mjs';
import { libelleChapitre } from '../../data/chapitres-ecrivains';
import { planComplet, urlChapitre } from '../../utils/ecrivains';
import {
  diaporamas, dureeTotale, dureesGenerique, indicatif, nombreImages, urlCommons, formaterDuree, nomSourceMusique, objetsMusee, planDiaporamas, portraits, urlDiaporama, urlSectionDiaporamas, urlSourceMusique,
  type Diaporama as D,
} from '../../utils/diaporamas';

export function getStaticPaths() {
  return diaporamas.map((d) => ({ params: { slug: d.slug }, props: { d } }));
}

const { d } = Astro.props as { d: D };
const plan = planDiaporamas();
const voisin = (numero: number) => plan.find((p) => p.numero === numero);
const precedent = voisin(d.numero - 1);
const suivant = voisin(d.numero + 1);
const chapitre = (await planComplet()).find((p) => p.numero === d.numero)?.chapitre;
const duree = formaterDuree(dureeTotale(d));

// Crédits des musiques : fond par acte (sans doublon), puis intermèdes chantés.
const t = (x?: string) => (x ? typographie(x) : '');
const fond = (d.musique?.fond ?? []).filter((p) => p.duree);
const actesMusique = d.actes.map((a) => ({ titre: a.titre, pistes: fond.filter((p) => p.acte === a.id) })).filter((a) => a.pistes.length);
const chants = (d.musique?.intermedes ?? []).filter((p) => p.duree);
// Crédits des portraits des personnes nommées (spec 12, 2026-10-08) : ceux que montre la période,
// dans l'ordre de leur première apparition.
const idsPortraits = [...new Set(d.diapositives.flatMap((x) => (x.personnes ?? []).map((p) => p.id)))];
const portraitsMontres = idsPortraits.map((id) => portraits.find((p) => p.id === id)).filter((p) => p?.fichier && p.page);
// Crédits des objets de musée et des manuscrits (spec 12, « Enrichissements visuels ») : dans l'ordre
// de leur apparition.
const idsObjets = [...new Set(d.diapositives.flatMap((x) => [...(x.manuscrits ?? []), ...(x.objets ?? [])].map((o) => o.id)))];
const objetsMontres = idsObjets.map((id) => objetsMusee.find((o) => o.id === id)).filter((o) => o?.fichier && o.page);
// Crédits des images des avant/après et des vignettes des mosaïques (spec 12, points 3 et 5) :
// ces images n'ont pas toutes de cartouche propre dans le lecteur.
const avantApresMontres = d.diapositives.filter((x) => x.image.apres).map((x) => ({ n: x.n, i: x.image.apres! }));
const mosaiquesMontrees = d.diapositives.filter((x) => x.mosaique).map((x) => ({
  n: x.n, legende: x.mosaique!.legende, vignettes: x.mosaique!.vignettes.map((v, k) => (k === x.mosaique!.principale ? { ...x.image, ...v } : v)),
}));
// Crédits des images mises en mouvement par IA (spec 16) : clips dérivés d'images de la période par un
// modèle à poids ouverts, signalés dans le cartouche ; l'image d'origine reste la seule authentique.
const videosMontrees = d.diapositives.filter((x) => x.image.video && !x.image.apres).map((x) => ({ n: x.n, i: x.image, v: x.image.video! }));
const modelesVideo = [...new Set(videosMontrees.map((x) => x.v.modele))];
// Crédits des images colorisées par IA (spec 16) : images de diapositives et de plans.
const couleursMontrees = d.diapositives.flatMap((x) => (x.image.apres || x.mosaique ? [] : [
  ...(x.image.couleur && !x.image.video ? [{ n: x.n, i: x.image }] : []),
  ...(x.plans ?? []).filter((p) => p.image.couleur).map((p) => ({ n: x.n, i: p.image })),
]));
const modelesCouleur = [...new Set(couleursMontrees.map((x) => x.i.couleur!.modele.split('/').pop()!.replace(/-/g, ' ')))];
// Fonds prolongés des images entières (spec 17) : crédités ici seulement (ni cartouche ni livre d'images).
const fondsMontres = d.diapositives.flatMap((x) => (x.image.apres || x.mosaique ? [] : [
  ...(x.image.fond && x.image.entier ? [{ n: x.n, i: x.image }] : []),
  ...(x.plans ?? []).filter((p) => p.image.fond && p.image.entier).map((p) => ({ n: x.n, i: p.image })),
]));
const modelesFond = [...new Set(fondsMontres.map((x) => x.i.fond!.modele.split('/').pop()!.replace(/-/g, ' ')))];
const diaposFond = [...new Set(fondsMontres.map((x) => x.n))];
// Dessins traversants sous les images entières (spec 17, essai 5) : esquisses générées par IA,
// signalés au cartouche, crédités ici et dans le livre d'images.
const vignettesMontrees = d.diapositives.flatMap((x) => (x.image.apres || x.mosaique ? [] : [
  ...(x.image.vignette && x.image.entier ? [{ n: x.n, i: x.image }] : []),
  ...(x.plans ?? []).filter((p) => p.image.vignette && p.image.entier).map((p) => ({ n: x.n, i: p.image })),
]));
const modelesVignette = [...new Set(vignettesMontrees.map((x) => x.i.vignette!.modele.split('/').pop()!.replace(/-/g, ' ')))];
const diaposVignette = [...new Set(vignettesMontrees.map((x) => x.n))];
// Ambiances sonores des clips (spec 17) : sons générés, crédités ici et dans le livre d'images seulement.
const ambiances = videosMontrees.filter((x) => x.i.ambiance);
const modelesAmbiance = [...new Set(ambiances.map((x) => x.i.ambiance!.modele))];
// Netteté (spec 17) : images (diapositives et plans) agrandies par IA pour le grand écran.
const agrandiesMontrees = d.diapositives.flatMap((x) => [x.image, ...(x.image.apres || x.mosaique ? [] : (x.plans ?? []).map((p) => p.image))]
  .filter((i) => i.grand?.source === 'ia').map((i) => ({ n: x.n, i })));
const modelesAgrandies = [...new Set(agrandiesMontrees.map((x) => x.i.grand!.modele ?? 'modèle non précisé'))];
const notice = (v: { titre?: string; auteur?: string; date?: string; technique?: string; conservation?: string }) =>
  t([v.auteur, v.titre ? `« ${v.titre} »` : '', v.date, v.technique, v.conservation].filter(Boolean).join(', '));
/** Licence en milieu de phrase : minuscule initiale, sauf sigle (CC0, CC BY…). */
const licence = (x: string) => t(/^[A-ZÀ-Ý][a-zà-ÿ]/.test(x) ? x.charAt(0).toLowerCase() + x.slice(1) : x);
/** Lien vers le texte d'une licence Creative Commons (CC BY 3.0, CC BY-SA 4.0…), exigé par l'attribution. */
const urlLicence = (x: string) => {
  const m = /^CC (BY(?:-SA)?) (\d\.\d)(?: ([a-z]{2}))?/.exec(x);
  return m ? `https://creativecommons.org/licenses/${m[1].toLowerCase()}/${m[2]}/${m[3] ? `${m[3]}/` : ''}deed.fr` : '';
};
---

<Base title={`${d.titre} (${d.periode}) · Le siècle en images`} description={d.resume}>
  <article class="conteneur page-diaporama">
    <header class="entete-diaporama">
      <p class="surtitre-savant">
        <a href={urlSectionDiaporamas}>Le siècle en images</a>
        <span aria-hidden="true"> · </span>{libelleChapitre(d.numero)}
        <span aria-hidden="true"> · </span>{d.periode}
        <span aria-hidden="true"> · </span>{nombreImages(d)} images
        <span aria-hidden="true"> · </span>{duree}
      </p>
      <h1>{typographie(d.titre)}</h1>
      <p class="chapeau">{typographie(d.resume)}</p>
    </header>

    <Diaporama diaporama={d} />

    <p class="credits">
      {typographie("Voix off de synthèse (Gemini, voix Charon), texte relu ; images du domaine public, de Wikimedia Commons (photographies de certains objets sous licence libre, créditées plus bas). Clavier : espace (lecture, pause), flèches (précédente, suivante), F (plein écran), S (sous-titres), M (musique), Entrée (passer le carton d'un acte) ; flèche droite pour passer un chant ou un intermède.")}
    </p>
    {(actesMusique.length > 0 || chants.length > 0) && (
      <section class="musiques" aria-labelledby="titre-musiques">
        <h2 id="titre-musiques">Musiques</h2>
        {chants.length > 0 && (
          <Fragment>
            <h3>{chants.some((p) => p.instrumental) ? 'Chants et intermèdes musicaux' : 'Chants'}</h3>
            <ul>
              {chants.map((p) => (
                <li>
                  <cite>{t(p.titre)}</cite>, {t(p.auteur)}, {t(p.date)}. {t(p.interprete)}, {t(p.enregistrement)}.
                  {' '}<a href={urlSourceMusique(p.source)} rel="noopener" target="_blank">{nomSourceMusique(p.source)}</a>, {urlLicence(p.licence) ? <a href={urlLicence(p.licence)} rel="noopener license" target="_blank">{licence(p.licence)}</a> : licence(p.licence)}.
                </li>
              ))}
            </ul>
          </Fragment>
        )}
        {dureesGenerique(d).ouverture > 0 && (
          <Fragment>
            <h3>Générique</h3>
            <ul>
              <li>{t(`${indicatif.credit} : ${licence(indicatif.licence)}.`)}</li>
            </ul>
          </Fragment>
        )}
        <h3>Musique de fond</h3>
        <ul>
          {actesMusique.map((a) => (
            <li>
              <span class="musiques__acte">{t(a.titre)}</span>
              {a.pistes.map((p) => (
                <span class="musiques__piste">
                  {t(p.compositeur)}, <cite>{t(p.titre)}</cite> ({t(p.date)}), {t(p.interprete)}.{' '}
                  <a href={urlSourceMusique(p.source)} rel="noopener" target="_blank">{nomSourceMusique(p.source)}</a>, {urlLicence(p.licence) ? <a href={urlLicence(p.licence)} rel="noopener license" target="_blank">{licence(p.licence)}</a> : licence(p.licence)}.
                </span>
              ))}
            </li>
          ))}
        </ul>
        {d.musique?.note && <p class="musiques__note">{t(d.musique.note)}</p>}
      </section>
    )}
    {portraitsMontres.length > 0 && (
      <section class="musiques portraits-credits" aria-labelledby="titre-portraits">
        <h2 id="titre-portraits">Portraits</h2>
        <p>{typographie("Quand la voix nomme une personne que l'image ne montre pas, son portrait d'époque paraît en bas à gauche.")}</p>
        <ul>
          {portraitsMontres.map((p) => (
            <li>
              <span class="musiques__acte">{t(p!.nom)} ({p!.dates})</span>
              {' '}{t(p!.auteur)}{p!.date ? `, ${t(p!.date)}` : ''}.{' '}
              <a href={p!.page} rel="noopener" target="_blank">Commons</a>, {licence(p!.licence ?? '')}.
            </li>
          ))}
        </ul>
      </section>
    )}
    {objetsMontres.length > 0 && (
      <section class="musiques portraits-credits" aria-labelledby="titre-objets">
        <h2 id="titre-objets">Objets et documents</h2>
        <p>{typographie("Quand la voix parle d'un objet ou d'un document d'époque, sa photographie paraît sur l'image : l'objet détouré dans un coin, le manuscrit sur un côté, avec un halo sur la signature ou la phrase évoquée.")}</p>
        <ul>
          {objetsMontres.map((o) => (
            <li>
              <span class="musiques__acte">{t(o!.nom)}</span>{' '}({t(o!.date)}), {t(o!.musee)}{o!.inventaire ? `, ${t(o!.inventaire)}` : ''}.{' '}
              {o!.passage && o!.passage.length > 3 && <Fragment>{t(`Passage éclairé : « ${o!.passage} ».`)}{' '}</Fragment>}
              {o!.auteur_photo && <Fragment>{t(`Photographie : ${o!.auteur_photo}`)},{' '}</Fragment>}
              <a href={o!.page} rel="noopener" target="_blank">Commons</a>,{' '}
              {urlLicence(o!.licence ?? '') ? <a href={urlLicence(o!.licence ?? '')} rel="license noopener" target="_blank">{licence(o!.licence ?? '')}</a> : licence(o!.licence ?? '')}.
            </li>
          ))}
        </ul>
      </section>
    )}
    {(avantApresMontres.length > 0 || mosaiquesMontrees.length > 0) && (
      <section class="musiques portraits-credits" aria-labelledby="titre-mosaiques">
        <h2 id="titre-mosaiques">Mosaïques et avant-après</h2>
        <p>{typographie("Certaines diapositives commencent par une grille d'images d'un même événement, avant de plonger dans l'une d'elles ; d'autres font glisser un volet entre deux états d'un même lieu ou d'un même sujet. Images du domaine public, de Wikimedia Commons.")}</p>
        {mosaiquesMontrees.map((m) => (
          <Fragment>
            <h3>{t(m.legende)} (diapositive {m.n})</h3>
            <ul>
              {m.vignettes.map((v) => <li>{notice(v)}. <a href={urlCommons(v.commons)} rel="noopener" target="_blank">Commons</a>, domaine public.</li>)}
            </ul>
          </Fragment>
        ))}
        {avantApresMontres.length > 0 && (
          <Fragment>
            <h3>Avant, après</h3>
            <ul>
              {avantApresMontres.map(({ n, i }) => <li>Diapositive {n}, après : {notice(i)}. <a href={urlCommons(i.commons)} rel="noopener" target="_blank">Commons</a>, domaine public.</li>)}
            </ul>
          </Fragment>
        )}
      </section>
    )}
    {videosMontrees.length > 0 && (
      <section class="musiques portraits-credits" aria-labelledby="titre-mouvement">
        <h2 id="titre-mouvement">Images mises en mouvement</h2>
        <p>{typographie(`Sur ${videosMontrees.length} diapositives, l'image d'époque s'anime quelques secondes : fumées, drapeaux, foule. Ce court clip muet est calculé par un modèle d'intelligence artificielle à poids ouverts (${modelesVideo.join(', ')}) à partir du document lui-même, qui reste seul authentique ; rien n'y est ajouté qui ne soit dans l'image. Le cartouche le signale ; avec la préférence « réduire les animations », l'image reste fixe.`)}</p>
        <ul>
          {videosMontrees.map(({ n, i }) => <li>Diapositive {n} : {notice(i)}. <a href={urlCommons(i.commons)} rel="noopener" target="_blank">Commons</a>, domaine public.</li>)}
        </ul>
        {ambiances.length > 0 && (
          <p>{typographie(`Ambiance sonore : sous la voix, un son d'ambiance discret (foule, canon, vent, eau) accompagne ${ambiances.length === videosMontrees.length ? 'chacun de ces clips' : `${ambiances.length} de ces clips`}. Il est généré par un modèle d'intelligence artificielle à poids ouverts (${modelesAmbiance.join(', ')}, licence MIT) à partir d'une courte description de la scène ; ce n'est pas un enregistrement d'époque et il n'illustre que ce que dit la narration. Il se coupe avec la musique ; avec la préférence « réduire les animations », il n'y a ni clip ni ambiance.`)}</p>
        )}
      </section>
    )}
    {couleursMontrees.length > 0 && (
      <section class="musiques portraits-credits" aria-labelledby="titre-couleur">
        <h2 id="titre-couleur">Images colorisées</h2>
        <p>{typographie(`Sur ${couleursMontrees.length} gravures, lithographies et photographies en noir et blanc, le lecteur montre d'abord le document tel qu'il est, puis passe lentement à une version colorisée. Les couleurs sont ajoutées par un modèle d'intelligence artificielle à poids ouverts (${modelesCouleur.join(', ')}) sans retoucher le trait : seule la teinte change, le dessin reste celui de l'original. Elles sont plausibles, non documentées : le document original, visible dans le livre d'images et sur Commons, reste seul authentique. Le cartouche signale la colorisation tant qu'elle est à l'écran ; avec la préférence « réduire les animations », l'image reste en noir et blanc.`)}</p>
        <ul>
          {couleursMontrees.map(({ n, i }) => <li>Diapositive {n} : {notice(i)}. <a href={urlCommons(i.commons)} rel="noopener" target="_blank">Commons</a>, {licence(i.licence ?? 'Domaine public')}.</li>)}
        </ul>
      </section>
    )}
    {fondsMontres.length > 0 && (
      <section class="musiques portraits-credits" aria-labelledby="titre-fonds">
        <h2 id="titre-fonds">Fonds prolongés</h2>
        <p>{typographie(`Une image en hauteur ne remplit pas l'écran : le lecteur la montre en entier. Autour d'elle, à la place d'un fond noir, il pose un fond flou qui prolonge la scène (le ciel, le sol, les murs, ou simplement le papier). Ce prolongement n'appartient pas au document : il est calculé par un modèle d'intelligence artificielle à poids ouverts (${modelesFond.join(', ')}) à partir de l'image, puis flouté et assombri pour ne servir que d'ambiance. L'image d'époque, elle, n'est jamais retouchée : c'est toujours le fichier d'origine, net, au centre. ${fondsMontres.length} images de ${diaposFond.length} diapositives sont dans ce cas ; le livre d'images les montre sans leur fond.`)}</p>
        <p>{typographie(`Diapositives concernées : ${diaposFond.join(', ')}.`)}</p>
      </section>
    )}
    {vignettesMontrees.length > 0 && (
      <section class="musiques portraits-credits" aria-labelledby="titre-vignettes">
        <h2 id="titre-vignettes">Dessins générés</h2>
        <p>{typographie(`Sous ${vignettesMontrees.length} images montrées en entier, un dessin à la plume se trace pendant que la voix parle : on n'en voit que les deux bords, de part et d'autre de l'image (un atelier vide, une rue, un quai, une salle, des objets), son centre étant caché par elle. Ces esquisses, sans personnage, ne sont pas des documents d'époque : elles sont inventées par un modèle d'intelligence artificielle à poids ouverts (${modelesVignette.join(', ')}) d'après ce que dit la voix, puis relues une à une (personnage, faux texte, anachronisme, cadre : dessin écarté). Elles évoquent, elles n'attestent rien. Le cartouche le signale (« dessin généré par IA ») tant que le dessin est à l'écran ; le livre d'images les montre en entier sous l'image qu'elles accompagnent ; sur téléphone, faute de marges, il n'y en a pas.`)}</p>
        <p>{typographie(`Diapositives concernées : ${diaposVignette.join(', ')}.`)}</p>
      </section>
    )}
    {agrandiesMontrees.length > 0 && (
      <section class="musiques portraits-credits" aria-labelledby="titre-agrandies">
        <h2 id="titre-agrandies">Images agrandies</h2>
        <p>{typographie(`Sur un grand écran, la caméra s'approche assez des images pour dépasser la finesse des reproductions disponibles. Quand le fichier conservé sur Wikimedia Commons est trop petit, le lecteur montre une version agrandie par un modèle d'intelligence artificielle à poids ouverts (${modelesAgrandies.join(', ')}) : ${agrandiesMontrees.length} images sont dans ce cas. Le modèle redessine les détails les plus fins (trait, grain, contours), qui ne sont donc plus exactement ceux du document ; le cadrage et le contenu de la scène ne changent pas. Sur téléphone et dans le livre d'images, c'est la reproduction d'origine qui est montrée ; elle seule fait foi.`)}</p>
        <ul>
          {agrandiesMontrees.map(({ n, i }) => <li>Diapositive {n} : {notice(i)}. <a href={urlCommons(i.commons)} rel="noopener" target="_blank">Commons</a>, {licence(i.licence ?? 'Domaine public')}.</li>)}
        </ul>
      </section>
    )}
    {chapitre && (
      <p class="lien-ecrivains">
        <a href={urlChapitre(chapitre)}>{typographie(`Lire la même période dans « Le siècle raconté par ses écrivains » : ${chapitre.data.titre} →`)}</a>
      </p>
    )}

    <nav class="voisins" aria-label="Autres périodes">
      {precedent?.diaporama ? (
        <a class="voisin" href={urlDiaporama(precedent.diaporama.slug)}>
          <span class="voisin__sens">← {libelleChapitre(precedent.numero)}</span>
          <span class="voisin__titre">{typographie(precedent.titre)}</span>
        </a>
      ) : precedent ? (
        <p class="voisin voisin--avenir">
          <span class="voisin__sens">← {libelleChapitre(precedent.numero)} (à venir)</span>
          <span class="voisin__titre">{typographie(precedent.titre)}</span>
        </p>
      ) : <a class="voisin" href={urlSectionDiaporamas}><span class="voisin__sens">← Toutes les périodes</span><span class="voisin__titre">Le siècle en images</span></a>}
      {suivant?.diaporama ? (
        <a class="voisin voisin--suiv" href={urlDiaporama(suivant.diaporama.slug)}>
          <span class="voisin__sens">{libelleChapitre(suivant.numero)} →</span>
          <span class="voisin__titre">{typographie(suivant.titre)}</span>
        </a>
      ) : suivant ? (
        <p class="voisin voisin--suiv voisin--avenir">
          <span class="voisin__sens">{libelleChapitre(suivant.numero)} (à venir)</span>
          <span class="voisin__titre">{typographie(suivant.titre)}</span>
        </p>
      ) : <a class="voisin voisin--suiv" href={urlSectionDiaporamas}><span class="voisin__sens">Toutes les périodes →</span><span class="voisin__titre">Le siècle en images</span></a>}
    </nav>
  </article>
</Base>

<style>
  .page-diaporama { max-width: calc(1040px + 2 * var(--gouttiere)); }
  .entete-diaporama { padding-top: var(--e-4); max-width: var(--l-lecture); }
  .entete-diaporama .surtitre-savant { margin-bottom: var(--e-2); }
  .entete-diaporama .surtitre-savant a { color: var(--c-texte-doux); }
  .entete-diaporama h1 { margin-bottom: var(--e-2); }
  .chapeau { font-size: 1.15rem; font-style: italic; color: var(--c-texte-doux); margin-bottom: var(--e-3); }
  .credits { margin-top: var(--e-5); font-size: var(--t-petit); color: var(--c-texte-doux); max-width: var(--l-lecture); }
  .lien-ecrivains { font-size: 1.05rem; }

  /* Crédits des musiques : sobre, petit, monochrome. */
  .musiques { margin-top: var(--e-4); max-width: var(--l-lecture); font-size: var(--t-petit); color: var(--c-texte-doux); }
  .musiques h2 {
    font-size: 1rem;
    font-variant: small-caps;
    letter-spacing: 0.1em;
    font-weight: normal;
    color: var(--c-texte-doux);
    border-bottom: 1px solid var(--c-filet);
    padding-bottom: var(--e-1);
    margin-bottom: var(--e-2);
  }
  .musiques h3 { font-size: 0.95rem; font-weight: normal; font-style: italic; margin: var(--e-2) 0 var(--e-1); color: var(--c-texte-doux); }
  .musiques ul { list-style: none; padding: 0; margin: 0; }
  .musiques li { margin-bottom: var(--e-1); line-height: 1.45; }
  .musiques a { color: var(--c-texte-doux); }
  .musiques__acte { display: block; font-variant: small-caps; letter-spacing: 0.04em; }
