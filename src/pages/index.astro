---
// Sommaire des siècles (spec 18) : un siècle par ligne, séparés par des filets fins ; seuls les
// siècles déclarés dans src/data/siecles.ts apparaissent.
import Base from '../layouts/Base.astro';
import { NOM_SITE, siecles } from '../data/siecles';
import { typographie } from '../utils/typographie.mjs';
import { urlDiaporamas, urlEcrivains, urlLecons, urlSiecle } from '../utils/adresses';

const liens = (id: string, sections: string[]) => [
  { libelle: 'Leçons', href: urlLecons(id) },
  ...(sections.includes('ecrivains') ? [{ libelle: 'Écrivains', href: urlEcrivains(id) }] : []),
  ...(sections.includes('images') ? [{ libelle: 'Images', href: urlDiaporamas(id) }] : []),
];
---

<Base
  title={NOM_SITE}
  description="Apprendre l'histoire de France siècle par siècle : leçons, textes d'écrivains et diaporamas d'images d'époque."
>
  <div class="conteneur sommaire">
    <section class="presentation">
      <h1>{NOM_SITE}</h1>
      <p class="chapeau">{typographie("L'histoire de la France racontée siècle par siècle, en leçons courtes, par les textes de ceux qui l'ont vécue et par les images de leur temps.")}</p>
    </section>

    <ol class="siecles" aria-label="Les siècles">
      {siecles.map((s) => (
        <li class="siecle">
          <h2 class="siecle__titre">
            <a href={urlSiecle(s.id)}><span class="sc">{s.romain}</span><sup>e</sup> siècle</a>
          </h2>
          <p class="siecle__bornes">{s.debut}-{s.fin}</p>
          <p class="siecle__chapeau">{typographie(s.chapeau)}</p>
          <ul class="siecle__sections" aria-label={`Sections du ${s.libelle}`}>
            {liens(s.id, s.sections).map((l) => <li><a href={l.href}>{l.libelle}</a></li>)}
          </ul>
        </li>
      ))}
    </ol>
  </div>
</Base>

<style>
  .sommaire { max-width: calc(900px + 2 * var(--gouttiere)); }
  .presentation { padding-top: var(--e-5); }
  .chapeau { font-size: 1.3rem; font-style: italic; color: var(--c-texte-doux); }

  .siecles { list-style: none; padding: 0; margin: var(--e-5) 0 0; }
  .siecle {
    margin: 0;
    padding: var(--e-3) 0 var(--e-4);
    border-top: 1px solid var(--c-filet);
  }
  .siecle:last-child { border-bottom: 1px solid var(--c-filet); }
  .siecle__titre { margin: 0; font-size: 1.6rem; font-weight: 500; }
  .siecle__titre a { color: var(--c-texte); text-decoration: none; }
  .siecle__titre a:hover { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.2em; }
  .siecle__titre sup { font-size: 0.55em; }
  .siecle__bornes { margin: var(--e-1) 0 0; font-variant: small-caps; letter-spacing: 0.08em; color: var(--c-texte-doux); }
  .siecle__chapeau { margin: var(--e-2) 0; }
  .siecle__sections {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--e-1);
    list-style: none;
    margin: 0;
    padding: 0;
    font-variant: small-caps;
    letter-spacing: 0.08em;
    font-size: 1.05rem;
  }
  .siecle__sections li { margin: 0; }
  .siecle__sections li + li::before { content: '·'; margin-right: var(--e-1); color: var(--c-texte-doux); }
</style>
