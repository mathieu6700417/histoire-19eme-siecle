---
// Mise en page d'un chapitre de la section « Le siècle raconté par ses écrivains ».
import Base from './Base.astro';
import { typographie } from '../utils/typographie.mjs';
import { urlSection, urlAuteurs } from '../utils/ecrivains';
import { auteurs } from '../data/auteurs';
import { libelleChapitre } from '../data/chapitres-ecrivains';

interface Sommaire {
  parties: { id: string; titre: string; extraits: { id: string; titre: string; auteur: string }[] }[];
  conclusion: boolean;
}
interface Voisin { numero: number; titre: string; href?: string }

interface Props {
  titre: string;
  numero: number;
  periode: string;
  resume: string;
  dureeLecture: number;
  sommaire: Sommaire;
  precedent?: Voisin;
  suivant?: Voisin;
}

const { titre, numero, periode, resume, dureeLecture, sommaire, precedent, suivant } = Astro.props;
const nbExtraits = sommaire.parties.reduce((n, p) => n + p.extraits.length, 0);
// Numérotation continue d'une partie à l'autre.
const debuts = sommaire.parties.map((_, i) => 1 + sommaire.parties.slice(0, i).reduce((n, p) => n + p.extraits.length, 0));
// Durée lisible : « 25 minutes », « 1 h 40 ».
const duree = dureeLecture < 60
  ? `${dureeLecture} minutes`
  : `${Math.floor(dureeLecture / 60)} h${dureeLecture % 60 ? ' ' + String(dureeLecture % 60).padStart(2, '0') : ''}`;
---

<Base title={`${titre} (${periode}) · Le siècle raconté par ses écrivains`} description={resume}>
  <article class="chapitre">
    <script>
      // « Retour au sommaire » (#titre-sommaire) ouvre le sommaire replié.
      function ouvrirSommaire() {
        if (location.hash === '#titre-sommaire' || location.hash === '#sommaire') {
          const s = document.getElementById('sommaire') as HTMLDetailsElement | null;
          if (s) { s.open = true; s.scrollIntoView(); }
        }
      }
      window.addEventListener('hashchange', ouvrirSommaire);
      ouvrirSommaire();

      // Filtre « Témoins de l'époque » (par défaut) / « Postérieurs » / « Tous ». Le statut de
      // chaque extrait (data-temoin) est calculé au build ; le choix est mémorisé pour
      // tous les chapitres.
      const CLE_FILTRE = 'ecrivains-filtre';
      type Mode = 'temoins' | 'posterieurs' | 'tous';
      const MODES: Mode[] = ['temoins', 'posterieurs', 'tous'];
      // Les valeurs enregistrées par la version à deux choix (« temoins », « tous ») restent
      // valables telles quelles ; toute autre valeur (ancienne ou corrompue) est remplacée
      // par le choix par défaut.
      function lireMode(): Mode {
        try {
          const v = localStorage.getItem(CLE_FILTRE);
          if (v && (MODES as string[]).includes(v)) return v as Mode;
          if (v !== null) localStorage.setItem(CLE_FILTRE, 'temoins');
        } catch { /* stockage indisponible */ }
        return 'temoins';
      }
      function ecrireMode(m: string) {
        try { localStorage.setItem(CLE_FILTRE, m); } catch { /* stockage indisponible */ }
      }
      const sections = [...document.querySelectorAll<HTMLElement>('section.extrait[data-temoin]')];
      const motsDe = (sec: HTMLElement) => (sec.querySelector('.extrait__texte')?.textContent ?? '').trim().split(/\s+/).length;
      const mots = new Map(sections.map((sec) => [sec, motsDe(sec)]));
      const filtre = document.querySelector<HTMLElement>('.filtre');
      function formaterDuree(min: number) {
        return min < 60 ? `${min} minutes` : `${Math.floor(min / 60)} h${min % 60 ? ' ' + String(min % 60).padStart(2, '0') : ''}`;
      }
      function appliquer(mode: Mode) {
        let visibles = 0, motsVisibles = 0, motsTotal = 0;
        for (const sec of sections) {
          const montre = mode === 'tous' || (mode === 'temoins') === (sec.dataset.temoin === 'oui');
          sec.hidden = !montre;
          // La transition qui introduit l'extrait disparaît avec lui.
          const avant = sec.previousElementSibling as HTMLElement | null;
          if (avant?.classList.contains('transition')) avant.hidden = !montre;
          const li = document.querySelector<HTMLElement>(`.sommaire li[data-extrait="${sec.getAttribute('aria-labelledby')}"]`);
          if (li) li.hidden = !montre;
          motsTotal += mots.get(sec)!;
          if (montre) { visibles++; motsVisibles += mots.get(sec)!; }
        }
        // Une partie sans extrait visible est masquée (page et sommaire).
        for (const h of document.querySelectorAll<HTMLElement>('.prose > h2.partie')) {
          let el = h.nextElementSibling, garde = false;
          while (el && el.tagName !== 'H2') {
            if (el.matches('section.extrait') && !(el as HTMLElement).hidden) { garde = true; break; }
            el = el.nextElementSibling;
          }
          h.hidden = !garde;
        }
        for (const p of document.querySelectorAll<HTMLElement>('.sommaire__partie')) {
          p.hidden = !p.querySelector('li[data-extrait]:not([hidden])');
        }
        // Compteurs et durée.
        const compteur = filtre?.querySelector('.filtre__compteur');
        if (compteur) compteur.textContent = `${visibles} textes sur ${sections.length}`;
        const nombre = document.querySelector('.sommaire__nombre');
        if (nombre) nombre.textContent = String(visibles);
        const duree = document.querySelector<HTMLElement>('.chapitre__duree');
        if (duree && motsTotal) {
          const total = Number(duree.dataset.minutes);
          duree.textContent = formaterDuree(Math.max(5, Math.round((total * motsVisibles) / motsTotal / 5) * 5));
        }
        for (const b of filtre?.querySelectorAll('.filtre__option') ?? []) {
          b.setAttribute('aria-pressed', String(b.getAttribute('data-mode') === mode));
        }
      }
      if (filtre && sections.length) {
        filtre.hidden = false;
        filtre.addEventListener('click', (e) => {
          const b = (e.target as Element).closest<HTMLElement>('.filtre__option');
          if (!b) return;
          const mode = (MODES as string[]).includes(b.dataset.mode ?? '') ? (b.dataset.mode as Mode) : 'temoins';
          ecrireMode(mode);
          appliquer(mode);
        });
        appliquer(lireMode());
      }
      // Une ancre vers un texte masqué fait passer le filtre sur « Tous les textes ».
      function reveler() {
        if (!location.hash) return;
        const cible = document.getElementById(decodeURIComponent(location.hash.slice(1)));
        if (cible && cible.closest('[hidden]')) {
          ecrireMode('tous');
          appliquer('tous');
          // Saut immédiat (sans l'animation « smooth ») une fois le texte réaffiché.
          requestAnimationFrame(() => cible.scrollIntoView({ behavior: 'instant', block: 'start' }));
        }
      }
      window.addEventListener('hashchange', reveler);
      reveler();

      // Sur ordinateur (≥ 1200 px), le sommaire est une colonne fixe, toujours ouverte,
      // qui surligne le texte en cours de lecture.
      const large = window.matchMedia('(min-width: 1200px)');
      const sommaire = document.getElementById('sommaire') as HTMLDetailsElement | null;
      function adapter() {
        if (sommaire && large.matches) sommaire.open = true;
      }
      large.addEventListener('change', adapter);
      adapter();
      // Sur ordinateur, le résumé n'est plus un bouton : on empêche de replier la colonne.
      sommaire?.querySelector('summary')?.addEventListener('click', (e) => {
        if (large.matches) e.preventDefault();
      });

      // Surlignage du texte courant : l'extrait qui traverse une bande située vers le
      // haut de l'écran. IntersectionObserver recalcule tout seul quand la hauteur
      // d'un extrait change (« Voir plus » / « Voir moins », blocs dépliés).
      const items = new Map<string, HTMLElement>();
      for (const li of document.querySelectorAll<HTMLElement>('.sommaire li[data-extrait]')) {
        items.set(li.dataset.extrait!, li);
      }
      const visibles = new Set<Element>();
      let courant: HTMLElement | null = null;
      function surligner() {
        // Le premier extrait (dans l'ordre du document) présent dans la bande.
        const sections = [...visibles].sort((a, b) =>
          a.compareDocumentPosition(b) & Node.DOCUMENT_POSITION_FOLLOWING ? -1 : 1);
        const id = sections[0]?.getAttribute('aria-labelledby');
        const li = id ? items.get(id) ?? null : null;
        if (!li || li === courant) return;
        courant?.classList.remove('est-courant');
        courant?.querySelector('a')?.removeAttribute('aria-current');
        li.classList.add('est-courant');
        li.querySelector('a')?.setAttribute('aria-current', 'location');
        courant = li;
        // Garder l'entrée visible dans la colonne si celle-ci défile. On ne fait défiler
        // que la colonne : scrollIntoView ferait aussi défiler la page.
        const colonne = li.closest<HTMLElement>('nav.sommaire');
        if (large.matches && colonne) {
          const c = colonne.getBoundingClientRect(), r = li.getBoundingClientRect();
          if (r.top < c.top + 40) colonne.scrollTop -= c.top + 40 - r.top;
          else if (r.bottom > c.bottom - 40) colonne.scrollTop += r.bottom - (c.bottom - 40);
        }
      }
      const observateur = new IntersectionObserver((entrees) => {
        for (const e of entrees) e.isIntersecting ? visibles.add(e.target) : visibles.delete(e.target);
        surligner();
      }, { rootMargin: '-20% 0px -60% 0px' });
      for (const section of document.querySelectorAll('section.extrait[aria-labelledby]')) observateur.observe(section);
    </script>
    <div class="chapitre__corps">
    <header class="chapitre__entete conteneur">
      <p class="chapitre__surtitre">
        <a href={urlSection}>Le siècle raconté par ses écrivains</a>
        <span aria-hidden="true"> · </span>
        <span>{libelleChapitre(numero)}</span>
        <span aria-hidden="true"> · </span>
        <span>{periode}</span>
        <span aria-hidden="true"> · </span>
        <span>{typographie('Lecture : environ ')}<span class="chapitre__duree" data-minutes={dureeLecture}>{duree}</span></span>
      </p>
      <h1>{typographie(titre)}</h1>
      <p class="chapitre__resume">{typographie(resume)}</p>
    </header>

    {nbExtraits > 0 && (
      <nav class="sommaire conteneur" aria-labelledby="titre-sommaire">
        {/* Filtre « Témoins de l'époque » / « Postérieurs » / « Tous » : activé par le script ;
            sans JavaScript, il reste caché et tous les textes s'affichent. */}
        <div class="filtre" role="group" aria-label="Textes affichés" hidden>
          <button type="button" class="filtre__option" data-mode="temoins" aria-pressed="true" title="Auteurs qui ont vécu les faits">Témoins</button>
          <span class="filtre__sep" aria-hidden="true">·</span>
          <button type="button" class="filtre__option" data-mode="posterieurs" aria-pressed="false" title="Auteurs des générations suivantes">Postérieurs</button>
          <span class="filtre__sep" aria-hidden="true">·</span>
          <button type="button" class="filtre__option" data-mode="tous" aria-pressed="false">Tous</button>
          <span class="filtre__compteur" aria-live="polite"></span>
        </div>
        <details id="sommaire">
          <summary id="titre-sommaire">Sommaire : les <span class="sommaire__nombre">{nbExtraits}</span> textes du chapitre</summary>
          <div class="sommaire__parties">
            {sommaire.parties.map((p, i) => (
              <section class="sommaire__partie">
                {p.titre && <p class="sommaire__titre-partie"><a href={`#${p.id}`}>{typographie(p.titre)}</a></p>}
                <ol start={debuts[i]}>
                  {p.extraits.map((e) => (
                    <li data-extrait={e.id}>
                      <a href={`#${e.id}`}>{typographie(e.titre)}</a>
                      <span class="sommaire__auteur"> · {typographie(auteurs[e.auteur]?.court ?? e.auteur)}</span>
                    </li>
                  ))}
                </ol>
              </section>
            ))}
            {sommaire.conclusion && <p class="sommaire__titre-partie"><a href="#conclusion">Conclusion</a></p>}
          </div>
        </details>
      </nav>
    )}

    <div class="prose conteneur">
      <slot />
    </div>

    <nav class="voisins conteneur" aria-label="Autres chapitres">
      {precedent?.href ? (
        <a class="voisin" href={precedent.href}>
          <span class="voisin__sens">← {libelleChapitre(precedent.numero)}</span>
          <span class="voisin__titre">{typographie(precedent.titre)}</span>
        </a>
      ) : <a class="voisin" href={urlSection}><span class="voisin__sens">← Tous les chapitres</span><span class="voisin__titre">Le siècle raconté par ses écrivains</span></a>}
      {suivant && (suivant.href ? (
        <a class="voisin voisin--suiv" href={suivant.href}>
          <span class="voisin__sens">{libelleChapitre(suivant.numero)} →</span>
          <span class="voisin__titre">{typographie(suivant.titre)}</span>
        </a>
      ) : (
        <p class="voisin voisin--suiv voisin--avenir">
          <span class="voisin__sens">{libelleChapitre(suivant.numero)} (à venir)</span>
          <span class="voisin__titre">{typographie(suivant.titre)}</span>
        </p>
      ))}
    </nav>
    <p class="conteneur chapitre__index"><a href={urlAuteurs}>Index des auteurs</a></p>
    </div>
  </article>
</Base>

<style>
  .chapitre__entete,
  .sommaire,
  .voisins,
  .chapitre__index {
    max-width: calc(var(--l-lecture) + 2 * var(--gouttiere));
  }
  .chapitre__entete { padding-top: var(--e-5); }
  .chapitre__surtitre {
    font-variant: small-caps;
    letter-spacing: 0.08em;
    color: var(--c-texte-doux);
    margin-bottom: var(--e-2);
  }
  .chapitre__surtitre a { color: var(--c-texte-doux); }
  .chapitre__surtitre a:hover { text-decoration: underline; }
  .chapitre__resume {
    font-size: 1.25rem;
    font-style: italic;
    color: var(--c-texte-doux);
    border-bottom: 1px solid var(--c-filet);
    padding-bottom: var(--e-4);
  }

  .sommaire details {
    border-block: 1px solid var(--c-filet);
    padding: var(--e-2) 0;
    font-size: 1.05rem;
  }
  .sommaire summary {
    font-family: var(--f-titre);
    font-variant: small-caps;
    letter-spacing: 0.08em;
    font-weight: 500;
    cursor: pointer;
    color: var(--c-texte);
  }
  .sommaire__parties { margin-top: var(--e-2); }
  .sommaire__partie { break-inside: avoid; }
  .sommaire__titre-partie {
    margin: var(--e-3) 0 var(--e-1);
    font-variant: small-caps;
    letter-spacing: 0.08em;
    font-weight: 500;
  }
  .sommaire__titre-partie a { color: var(--c-texte-doux); }
  /* Numérotation continue par compteur CSS : les entrées masquées par le filtre ne comptent pas. */
  .sommaire__parties { counter-reset: texte; }
  .sommaire ol { margin: 0; padding-left: 1.6em; list-style: none; }
  .sommaire li[data-extrait] { counter-increment: texte; position: relative; }
  .sommaire li[data-extrait]::before {
    content: counter(texte) '.';
    position: absolute;
    right: calc(100% + 0.4em);
    color: var(--c-texte-doux);
    font-variant-numeric: oldstyle-nums;
  }

  /* Filtre : deux options en petites capitales, l'option active soulignée. */
  .filtre {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.5em;
    margin-bottom: var(--e-2);
    font-size: 0.98rem;
  }
  .filtre[hidden] { display: none; }
  .filtre__option {
    font: inherit;
    font-variant: small-caps;
    letter-spacing: 0.08em;
    background: none;
    border: 0;
    padding: 0;
    color: var(--c-texte-doux);
    cursor: pointer;
  }
  .filtre__option[aria-pressed='true'] {
    color: var(--c-texte);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
  }
  .filtre__option:hover { color: var(--c-texte); }
  .filtre__option:focus-visible { outline: 1px solid var(--c-texte); outline-offset: 2px; }
  .filtre__sep { color: var(--c-texte-doux); }
  .filtre__compteur { color: var(--c-texte-doux); font-size: 0.92em; margin-left: auto; }
  .sommaire li { margin-bottom: 0.2rem; line-height: 1.4; }
  .sommaire__auteur { color: var(--c-texte-doux); font-size: 0.92em; }
  .sommaire a { text-decoration: none; }
  .sommaire a:hover { text-decoration: underline; }

  .voisins {
    display: flex;
    justify-content: space-between;
    gap: var(--e-3);
    margin-top: var(--e-6);
    padding-top: var(--e-4);
    border-top: 1px solid var(--c-filet);
  }
  .voisin { display: flex; flex-direction: column; text-decoration: none; max-width: 48%; margin: 0; }
  .voisin--suiv { text-align: right; margin-left: auto; }
  .voisin--avenir { color: var(--c-texte-doux); }
  .voisin__sens { font-variant: small-caps; color: var(--c-texte-doux); }
  .voisin__titre { font-family: var(--f-titre); }
  .chapitre__index { margin-top: var(--e-3); font-variant: small-caps; letter-spacing: 0.04em; }

  /* Entrée surlignée : le texte en cours de lecture. */
  .sommaire li.est-courant > a { color: var(--c-texte); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.2em; }

  /* Ordinateur : sommaire en colonne fixe à gauche ; la colonne de lecture garde sa largeur. */
  @media (min-width: 1200px) {
    .chapitre__corps {
      display: grid;
      grid-template-columns: 18rem minmax(0, 1fr);
      grid-template-areas:
        'sommaire entete'
        'sommaire prose'
        'sommaire voisins'
        'sommaire index';
      column-gap: var(--e-5);
      max-width: calc(var(--l-large) + 2 * var(--gouttiere));
      margin-inline: auto;
      padding-inline: var(--gouttiere);
    }
    .chapitre__corps > .conteneur { padding-inline: 0; }
    .chapitre__entete { grid-area: entete; }
    .prose { grid-area: prose; }
    .voisins { grid-area: voisins; }
    .chapitre__index { grid-area: index; }
    .sommaire {
      grid-area: sommaire;
      align-self: start;
      position: sticky;
      top: var(--e-3);
      max-width: none;
      max-height: calc(100vh - 2 * var(--e-3));
      overflow-y: auto;
      overscroll-behavior: contain;
      margin-top: var(--e-5);
      scrollbar-width: thin;
    }
    .sommaire details { border: 0; padding: 0; font-size: 0.95rem; }
    .sommaire summary { cursor: default; list-style: none; font-size: 1.05rem; }
    .sommaire summary::-webkit-details-marker { display: none; }
    .sommaire ol { padding-left: 1.5em; }
    .sommaire li { padding: 0.1em 0 0.1em 0.4em; border-left: 1px solid transparent; }
    .sommaire li.est-courant { border-left-color: var(--c-texte); }
  }

  /* Colonne de lecture */
  .prose > :global(*) {
    max-width: var(--l-lecture);
    margin-left: auto;
    margin-right: auto;
  }
  /* Transitions entre les extraits : courtes, en italique, centrées sur la colonne. */
  .prose > :global(p) { font-size: 1.12rem; }
  .prose > :global(.transition) {
    font-size: 1.12rem;
    font-style: italic;
    color: var(--c-texte);
    border-top: 1px solid var(--c-filet);
    padding-top: var(--e-3);
  }
  .prose > :global(.transition::before) {
    content: '❦';
    display: block;
    text-align: center;
    color: var(--c-texte-doux);
    font-style: normal;
    margin-bottom: var(--e-2);
  }
  .prose > :global(.transition p:last-child) { margin-bottom: 0; }
  .prose > :global(.introduction p:first-child) { font-size: 1.18rem; }
</style>
