---
import '../styles/global.css';
import { NOM_SITE, siecle as trouverSiecle } from '../data/siecles';
import { siecleDeChemin, urlDiaporamas, urlEcrivains, urlLecons, urlSiecle, urlSommaire } from '../utils/adresses';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const chemin = Astro.url.pathname;
// Siècle courant, déduit de l'adresse (/<siecle>/…) ; aucun sur le sommaire et la page 404.
const idSiecle = siecleDeChemin(chemin);
const s = idSiecle ? trouverSiecle(idSiecle) : undefined;
// Titre d'onglet : « <page> · <siècle> · Histoire de France » (sans répétition).
const titreComplet = [title, s?.libelle, NOM_SITE].filter((x, i, t) => x && t.indexOf(x) === i).join(' · ');
// Navigation du siècle : seulement les sections qu'il possède.
const nav = s ? [
  { libelle: 'Accueil', href: urlSiecle(s.id), courant: chemin === urlSiecle(s.id) },
  { libelle: 'Leçons', href: urlLecons(s.id), courant: false },
  ...(s.sections.includes('ecrivains') ? [{ libelle: 'Écrivains', href: urlEcrivains(s.id), courant: chemin.startsWith(urlEcrivains(s.id)) }] : []),
  ...(s.sections.includes('images') ? [{ libelle: 'Images', href: urlDiaporamas(s.id), courant: chemin.startsWith(urlDiaporamas(s.id)) }] : []),
] : [];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,600&display=swap"
    />
  </head>
  <body>
    <a class="evitement" href="#contenu">Aller au contenu</a>
    <header class="entete">
      <div class="conteneur entete__interieur">
        <p class="logo">
          <a class="logo__site" href={urlSommaire} aria-current={chemin === urlSommaire ? 'page' : undefined}>
            <span class="logo__fleuron" aria-hidden="true">❦</span>{NOM_SITE}
          </a>
          {s && (
            <>
              <span class="logo__sep" aria-hidden="true"> · </span>
              <a class="logo__siecle" href={urlSiecle(s.id)}><span class="sc">{s.romain}</span><sup>e</sup> siècle</a>
            </>
          )}
        </p>
        {nav.length > 0 && (
          <nav aria-label={`Navigation du ${s!.libelle}`}>
            <ul class="nav">
              {nav.map((n) => <li><a href={n.href} aria-current={n.courant ? 'page' : undefined}>{n.libelle}</a></li>)}
            </ul>
          </nav>
        )}
      </div>
    </header>

    <main id="contenu">
      <slot />
    </main>

    <footer class="pied">
      <div class="conteneur">
        <p>
          {NOM_SITE}{s && <> · le <span class="sc">{s.romain}</span><sup>e</sup> siècle, de {s.debut} à {s.fin}</>}&nbsp;: un site d’apprentissage
          construit leçon par leçon.
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .evitement {
    position: absolute;
    left: -9999px;
    top: 0;
    background: var(--c-bleu-nuit);
    color: var(--c-fond);
    padding: var(--e-2) var(--e-3);
    z-index: 10;
  }
  .evitement:focus { left: var(--e-3); }

  .entete {
    border-bottom: 1px solid var(--c-filet);
    background: var(--c-fond);
  }
  .entete__interieur {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--e-2) var(--e-4);
    padding-block: var(--e-3);
  }
  .logo {
    margin: 0;
    font-family: var(--f-titre);
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--c-texte);
  }
  .logo a { color: var(--c-texte); text-decoration: none; }
  .logo__sep { color: var(--c-texte-doux); }
  .logo__fleuron { color: var(--c-texte-doux); margin-right: 0.3em; }
  .logo sup, .pied sup { font-size: 0.6em; }
  .nav {
    display: flex;
    gap: var(--e-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav li { margin: 0; }
  .nav a {
    color: var(--c-texte);
    text-decoration: none;
    font-variant: small-caps;
    letter-spacing: 0.08em;
    font-size: 1.05rem;
    color: var(--c-texte-doux);
  }
  .nav a:hover, .nav a[aria-current='page'] {
    color: var(--c-bordeaux);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
  }

  .pied {
    margin-top: var(--e-6);
    border-top: 1px solid var(--c-filet);
    padding-block: var(--e-4);
    color: var(--c-texte-doux);
    font-size: var(--t-petit);
  }
  .pied p { margin: 0; }
</style>
