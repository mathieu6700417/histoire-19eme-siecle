// Déploiement sur Cloudflare Workers : site statique, fichiers servis depuis dist/.
// Même configuration que le projet ne-vous-souciez-pas. Publier : npm run deploy
{
  "name": "histoire-19eme-siecle",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
